TD><TD BORDER='0'></TD><TD title="portage://sys-boot/gnu-efi-3.0.18-r5" href="../sys-boot/gnu-efi-3.0.18-r5-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-boot/gnu-efi-3.0.18-r5" href="../sys-boot/gnu-efi-3.0.18-r5-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-boot/gnu-efi-3.0.18-r5" href="../sys-boot/gnu-efi-3.0.18-r5-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-boot/gnu-efi-3.0.18-r5" href="../sys-boot/gnu-efi-3.0.18-r5-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://sys-boot/gnu-efi-3.0.18-r5", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../sys-boot/gnu-efi-3.0.18-r5.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>sys-devel</TD></TR><TR><TD>binutils</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

