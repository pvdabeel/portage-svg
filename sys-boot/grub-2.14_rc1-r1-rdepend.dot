node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-boot</TD><TD title="repository" href="./grub.html">grub</TD><TD BORDER='0'></TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1.svg">detail</TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1-bdepend.svg">bdepend</TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1-cdepend.svg">cdepend</TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1-depend.svg">depend</TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1-idepend.svg">idepend</TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1-rdepend.svg"><u>rdepend</u></TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-boot/grub-9999" href="../sys-boot/grub-9999-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://sys-boot/grub-2.14_rc1-r3" href="../sys-boot/grub-2.14_rc1-r3-rdepend.svg">&lt; newer</TD><TD title="portage://sys-boot/grub-2.12-r9" href="../sys-boot/grub-2.12-r9-rdepend.svg">older &gt;</TD><TD title="portage://sys-boot/grub-2.12-r7" href="../sys-boot/grub-2.12-r7-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-boot/grub-2.14_rc1-r1" href="../sys-boot/grub-2.14_rc1-r1-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://sys-boot/grub-2.14_rc1-r1"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://sys-boot/grub-2.14_rc1-r1" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../sys-boot/grub-2.14_rc1-r1-rdepend.svg"];
