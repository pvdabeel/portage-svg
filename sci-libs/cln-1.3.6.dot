nodesep=1;
"dev-libs/gmp-6.3.0-r1" [label="portage://dev-libs/gmp-6.3.0-r1", color=red, width=4,href="../dev-libs/gmp-6.3.0-r1.svg"];
"dev-libs/gmp-6.3.0-r1" [label="pkg://dev-libs/gmp-6.3.0-r1", color=red, width=4,href="../dev-libs/gmp-6.3.0-r1.svg"];
