graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sci-libs</TD><TD title="repository" href="./hdf.html">hdf</TD><TD BORDER='0'></TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2.svg">detail</TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2-bdepend.svg">bdepend</TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2-cdepend.svg">cdepend</TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2-depend.svg">depend</TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2-idepend.svg">idepend</TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2-rdepend.svg"><u>rdepend</u></TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2-merge.svg">--merge&nbsp;</TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sci-libs/hdf-4.2.15-r2" href="../sci-libs/hdf-4.2.15-r2-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://sci-libs/hdf-4.2.15-r2"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://sci-libs/hdf-4.2.15-r2" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../sci-libs/hdf-4.2.15-r2-rdepend.svg"];
