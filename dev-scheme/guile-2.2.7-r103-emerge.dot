digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-scheme</TD><TD title="repository" href="./guile.html">guile</TD><TD BORDER='0'></TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103.svg">detail</TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103-bdepend.svg">bdepend</TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103-cdepend.svg">cdepend</TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103-depend.svg">depend</TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103-idepend.svg">idepend</TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103-rdepend.svg">rdepend</TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-scheme/guile-3.0.10-r103" href="../dev-scheme/guile-3.0.10-r103-emerge.svg">&lt;&lt; newest</TD><TD title="portage://dev-scheme/guile-3.0.10-r103" href="../dev-scheme/guile-3.0.10-r103-emerge.svg">&lt; newer</TD><TD title="portage://dev-scheme/guile-1.8.8-r103" href="../dev-scheme/guile-1.8.8-r103-emerge.svg">older &gt;</TD><TD title="portage://dev-scheme/guile-1.8.8-r103" href="../dev-scheme/guile-1.8.8-r103-emerge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-scheme/guile-2.2.7-r103" href="../dev-scheme/guile-2.2.7-r103-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
