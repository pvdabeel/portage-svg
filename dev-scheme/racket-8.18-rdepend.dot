digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-scheme</TD><TD title="repository" href="./racket.html">racket</TD><TD BORDER='0'></TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18.svg">detail</TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18-bdepend.svg">bdepend</TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18-cdepend.svg">cdepend</TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18-depend.svg">depend</TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18-idepend.svg">idepend</TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18-rdepend.svg"><u>rdepend</u></TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-scheme/racket-9.0" href="../dev-scheme/racket-9.0-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://dev-scheme/racket-9.0" href="../dev-scheme/racket-9.0-rdepend.svg">&lt; newer</TD><TD title="portage://dev-scheme/racket-8.17" href="../dev-scheme/racket-8.17-rdepend.svg">older &gt;</TD><TD title="portage://dev-scheme/racket-8.16" href="../dev-scheme/racket-8.16-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-scheme/racket-8.18" href="../dev-scheme/racket-8.18-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://dev-scheme/racket-8.18"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://dev-scheme/racket-8.18" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../dev-scheme/racket-8.18-rdepend.svg"];
"portage://dev-scheme/racket-8.18" -> "portage://dev-db/sqlite-9999"
"portage://dev-scheme/racket-8.18" -> "portage://dev-libs/libffi-9999"
"portage://dev-db/sqlite-9999" [color=red, penwidth=1, href="../dev-db/sqlite-9999-rdepend.svg"];
"portage://dev-db/sqlite-9999" -> "portage://virtual/zlib-1.3.1-r1"
"portage://virtual/zlib-1.3.1-r1" [color=red, penwidth=1, href="../virtual/zlib-1.3.1-r1-rdepend.svg"];
"portage://dev-libs/libffi-9999" [color=red, penwidth=1, href="../dev-libs/libffi-9999-rdepend.svg"];
}
