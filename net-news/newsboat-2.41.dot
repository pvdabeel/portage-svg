digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-news</TD><TD title="repository" href="./newsboat.html">newsboat</TD><TD BORDER='0'></TD><TD title="portage://net-news/newsboat-2.41" href="../net-news/newsboat-2.41.svg"><u>detail</u></TD><TD title="portage://net-news/newsboat-2.41" href="../net-news/newsboat-2.41-bdepend.svg">bdepend</TD><TD title="portage://net-news/newsboat-2.41" href="../net-news/newsboat-2.41-cdepend.svg">cdepend</TD><TD title="portage://net-news/newsboat-2.41" href="../net-news/newsboat-2.41-depend.svg">depend</TD><TD title="portage://net-news/newsboat-2.41" href="../net-news/newsboat-2.41-idepend.svg">idepend</TD><TD title="portage://net-news/newsboat-2.41" href="../net-news/newsboat-2.41-rdepend.svg">rdepend</TD><TD title="portage://net-news/newsboat-2.41" href="../net-news/newsboat-2.41-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-news/newsboat-2.41" href="../net-news/newsboat-2.41-merge.svg">--merge&nbsp;</TD><TD title="portage://net-news/newsboat-2.41" href="../net-news/newsboat-2.41-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-