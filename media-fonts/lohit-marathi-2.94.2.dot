digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-fonts</TD><TD title="repository" href="./lohit-marathi.html">lohit-marathi</TD><TD BORDER='0'></TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2.svg"><u>detail</u></TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2-bdepend.svg">bdepend</TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2-cdepend.svg">cdepend</TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2-depend.svg">depend</TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2-idepend.svg">idepend</TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2-rdepend.svg">rdepend</TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2-merge.svg">--merge&nbsp;</TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-fonts/lohit-marathi-2.94.2" href="../media-fonts/lohit-marathi-2.94.2-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://media-fonts/lohit-marathi-2.94.2", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../media-fonts/lohit-marathi-2.94.2.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
use_conditional_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD ROWSPAN="3" CELLPADDING="10">use_conditional</TD></TR>
          <TR><TD>positive</TD></TR><TR><TD>X</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>x11-apps</TD></TR><TR><TD>mkfontscale</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[1,2,0],,,1.2.0]</TD></TR></TABLE>>, shape=none, color=blue];
}
use_conditional_group1:e -> package_dependency1:w [weight=20, style="dashed",arrowhead="vee"];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>media-fonts</TD></TR><TR><TD>encodings</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
use_conditional_group1:e -> package_dependency2:w [weight=20, style="dashed",arrowhead="vee"];
}
id:e -> use_conditional_group1:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
weak_blocker1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>media-fonts</TD></TR><TR><TD>lohit-fonts</TD></TR>
                     <TR><TD>smaller</TD></TR><TR><TD>[[2,20150220],,,2.20150220]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker1:w [weight=20, color="orange", style="solid",arrowhead="odot"];
}
}

