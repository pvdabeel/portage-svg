"portage://x11-apps/mkfontscale-1.2.3" -> "portage://media-libs/freetype-9999"
"portage://x11-apps/mkfontscale-1.2.3" -> "portage://virtual/zlib-1.3.1-r1"
"portage://x11-apps/mkfontscale-1.2.3" -> "portage://app-arch/bzip2-9999"
