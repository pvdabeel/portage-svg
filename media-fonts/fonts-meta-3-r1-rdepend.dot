"portage://media-fonts/fonts-meta-3-r1" -> "portage://media-fonts/ubuntu-font-family-0.83-r1"
"portage://media-fonts/fonts-meta-3-r1" -> "portage://media-libs/fontconfig-2.17.1"
"portage://media-fonts/cantarell-0.303.1" [color=red, penwidth=1, href="../media-fonts/cantarell-0.303.1-rdepend.svg"];
"portage://media-fonts/droid-113-r5" [color=red, penwidth=1, href="../media-fonts/droid-113-r5-rdepend.svg"];
"portage://media-fonts/noto-20251201" [color=red, penwidth=1, href="../media-fonts/noto-20251201-rdepend.svg"];
"portage://media-fonts/oldstandard-2.2-r1" [color=red, penwidth=1, href="../media-fonts/oldstandard-2.2-r1-rdepend.svg"];
"portage://media-fonts/powerline-symbols-20170508" [color=red, penwidth=1, href="../media-fonts/powerline-symbols-20170508-rdepend.svg"];
"portage://media-fonts/ubuntu-font-family-0.83-r1" [color=red, penwidth=1, href="../media-fonts/ubuntu-font-family-0.83-r1-rdepend.svg"];
"portage://media-libs/fontconfig-2.17.1" [color=red, penwidth=1, href="../media-libs/fontconfig-2.17.1-rdepend.svg"];
