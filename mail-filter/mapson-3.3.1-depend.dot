digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">mail-filter</TD><TD title="repository" href="./mapson.html">mapson</TD><TD BORDER='0'></TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1.svg">detail</TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1-bdepend.svg">bdepend</TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1-cdepend.svg">cdepend</TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1-depend.svg"><u>depend</u></TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1-idepend.svg">idepend</TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1-rdepend.svg">rdepend</TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1-merge.svg">--merge&nbsp;</TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://mail-filter/mapson-3.3.1" href="../mail-filter/mapson-3.3.1-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://mail-filter/mapson-3.3.1"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://mail-filter/mapson-3.3.1" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../mail-filter/mapson-3.3.1-depend.svg"];
"portage://mail-filter/mapson-3.3.1" -> "portage://acct-user/mail-0-r3"
"portage://mail-filter/mapson-3.3.1" -> "portage://virtual/mta-1-r2"
"portage://acct-user/mail-0-r3" [color=red, penwidth=1, href="../acct-user/mail-0-r3-depend.svg"];
"portage://virtual/mta-1-r2" [color=red, penwidth=1, href="../virtual/mta-1-r2-depend.svg"];
}
