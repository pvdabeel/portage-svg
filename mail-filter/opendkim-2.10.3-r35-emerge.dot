digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">mail-filter</TD><TD title="repository" href="./opendkim.html">opendkim</TD><TD BORDER='0'></TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35.svg">detail</TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35-bdepend.svg">bdepend</TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35-cdepend.svg">cdepend</TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35-depend.svg">depend</TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35-idepend.svg">idepend</TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35-rdepend.svg">rdepend</TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://mail-filter/opendkim-2.10.3-r33" href="../mail-filter/opendkim-2.10.3-r33-emerge.svg">older &gt;</TD><TD title="portage://mail-filter/opendkim-2.10.3-r32" href="../mail-filter/opendkim-2.10.3-r32-emerge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35-merge.svg">--merge&nbsp;</TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://mail-filter/opendkim-2.10.3-r35" href="../mail-filter/opendkim-2.10.3-r35-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
