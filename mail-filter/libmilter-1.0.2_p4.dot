digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">mail-filter</TD><TD title="repository" href="./libmilter.html">libmilter</TD><TD BORDER='0'></TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4.svg"><u>detail</u></TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4-bdepend.svg">bdepend</TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4-cdepend.svg">cdepend</TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4-depend.svg">depend</TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4-idepend.svg">idepend</TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4-rdepend.svg">rdepend</TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://mail-filter/libmilter-1.0.2_p4-r1" href="../mail-filter/libmilter-1.0.2_p4-r1.svg">&lt;&lt; newest</TD><TD title="portage://mail-filter/libmilter-1.0.2_p4-r1" href="../mail-filter/libmilter-1.0.2_p4-r1.svg">&lt; newer</TD><TD title="portage://mail-filter/libmilter-1.0.2_p3-r3" href="../mail-filter/libmilter-1.0.2_p3-r3.svg">older &gt;</TD><TD title="portage://mail-filter/libmilter-1.0.2_p3-r2" href="../mail-filter/libmilter-1.0.2_p3-r2.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4-merge.svg">--merge&nbsp;</TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://mail-filter/libmilter-1.0.2_p4" href="../mail-filter/libmilter-1.0.2_p4-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://mail-filter/libmilter-1.0.2_p4", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../mail-filter/libmilter-1.0.2_p4.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>sys-devel</TD></TR><TR><TD>m4</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
weak_blocker1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>mail-mta</TD></TR><TR><TD>sendmail</TD></TR>
                     <TR><TD>smaller</TD></TR><TR><TD>[[8,16,1],,,8.16.1]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker1:w [weight=20, color="orange", style="solid",arrowhead="odot"];
}
}

