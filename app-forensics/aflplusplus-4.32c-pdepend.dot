digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-forensics</TD><TD title="repository" href="./aflplusplus.html">aflplusplus</TD><TD BORDER='0'></TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c.svg">detail</TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c-bdepend.svg">bdepend</TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c-cdepend.svg">cdepend</TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c-depend.svg">depend</TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c-idepend.svg">idepend</TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c-rdepend.svg">rdepend</TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c-pdepend.svg"><u>pdepend</u></TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://app-forensics/aflplusplus-4.30c" href="../app-forensics/aflplusplus-4.30c-pdepend.svg">older &gt;</TD><TD title="portage://app-forensics/aflplusplus-4.30c" href="../app-forensics/aflplusplus-4.30c-pdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c-merge.svg">--merge&nbsp;</TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-forensics/aflplusplus-4.32c" href="../app-forensics/aflplusplus-4.32c-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-forensics/aflplusplus-4.32c"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-forensics/aflplusplus-4.32c" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-forensics/aflplusplus-4.32c-pdepend.svg"];
}
