graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-containers</TD><TD title="repository" href="./crun.html">crun</TD><TD BORDER='0'></TD><TD title="portage://app-containers/crun-1.21" href="../app-containers/crun-1.21.svg"><u>detail</u></TD><TD title="portage://app-containers/crun-1.21" href="../app-containers/crun-1.21-bdepend.svg">bdepend</TD><TD title="portage://app-containers/crun-1.21" href="../app-containers/crun-1.21-cdepend.svg">cdepend</TD><TD title="portage://app-containers/crun-1.21" href="../app-containers/crun-1.21-depend.svg">depend</TD><TD title="portage://app-containers/crun-1.21" href="../app-containers/crun-1.21-idepend.svg">idepend</TD><TD title="portage://app-containers/crun-1.21" href="../app-containers/crun-1.21-rdepend.svg">rdepend</TD><TD title="portage://app-containers/crun-1.21" href="../app-containers/crun-1.21-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://app-containers/crun-1.20" href="../app-containers/crun-1.20.svg">older &gt;</TD><TD title="portage://app-containers/crun-1.19.1" href="../app-containers/crun-1.19.1.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-containers/crun-1.21" href="../app-containers/crun-1.21-merge.svg">--merge&nbs