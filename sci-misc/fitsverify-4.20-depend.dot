root [style=invis];
root -> "portage://sci-misc/fitsverify-4.20"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://sci-misc/fitsverify-4.20" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../sci-misc/fitsverify-4.20-depend.svg"];
