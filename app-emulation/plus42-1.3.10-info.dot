digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-emulation</TD><TD title="repository" href="./plus42.html">plus42</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10.svg">detail</TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10-bdepend.svg">bdepend</TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10-cdepend.svg">cdepend</TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10-depend.svg">depend</TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10-idepend.svg">idepend</TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10-rdepend.svg">rdepend</TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/plus42-1.3.12" href="../app-emulation/plus42-1.3.12-info.svg">&lt;&lt; newest</TD><TD title="portage://app-emulation/plus42-1.3.12" href="../app-emulation/plus42-1.3.12-info.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10-merge.svg">--merge&nbsp;</TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10-info.svg">--<u>info</u>&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/plus42-1.3.10" href="../app-emulation/plus42-1.3.10-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
