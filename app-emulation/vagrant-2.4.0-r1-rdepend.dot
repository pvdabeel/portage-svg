digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-emulation</TD><TD title="repository" href="./vagrant.html">vagrant</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1.svg">detail</TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1-bdepend.svg">bdepend</TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1-cdepend.svg">cdepend</TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1-depend.svg">depend</TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1-idepend.svg">idepend</TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1-rdepend.svg"><u>rdepend</u></TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/vagrant-2.4.1" href="../app-emulation/vagrant-2.4.1-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://app-emulation/vagrant-2.4.1" href="../app-emulation/vagrant-2.4.1-rdepend.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1-merge.svg">--merge&nbsp;</TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/vagrant-2.4.0-r1" href="../app-emulation/vagrant-2.4.0-r1-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-emulation/vagrant-2.4.0-r1"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-emulation/vagrant-2.4.0-r1" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-emulation/vagrant-2.4.0-r1-rdepend.svg"];
