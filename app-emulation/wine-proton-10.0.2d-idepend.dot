digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-emulation</TD><TD title="repository" href="./wine-proton.html">wine-proton</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d.svg">detail</TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d-bdepend.svg">bdepend</TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d-cdepend.svg">cdepend</TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d-depend.svg">depend</TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d-idepend.svg"><u>idepend</u></TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d-rdepend.svg">rdepend</TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/wine-proton-9999" href="../app-emulation/wine-proton-9999-idepend.svg">&lt;&lt; newest</TD><TD title="portage://app-emulation/wine-proton-10.0.3" href="../app-emulation/wine-proton-10.0.3-idepend.svg">&lt; newer</TD><TD title="portage://app-emulation/wine-proton-9.0.4-r2" href="../app-emulation/wine-proton-9.0.4-r2-idepend.svg">older &gt;</TD><TD title="portage://app-emulation/wine-proton-8.0.5c" href="../app-emulation/wine-proton-8.0.5c-idepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d-merge.svg">--merge&nbsp;</TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/wine-proton-10.0.2d" href="../app-emulation/wine-proton-10.0.2d-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-emulation/wine-proton-10.0.2d"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-emulation/wine-proton-10.0.2d" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-emulation/wine-proton-10.0.2d-idepend.svg"];
"portage://app-emulation/wine-proton-10.0.2d" -> "portage://app-eselect/eselect-wine-2.0.2-r2"
"portage://app-eselect/eselect-wine-2.0.2-r2" [color=red, penwidth=1, href="../app-eselect/eselect-wine-2.0.2-r2-idepend.svg"];
}
