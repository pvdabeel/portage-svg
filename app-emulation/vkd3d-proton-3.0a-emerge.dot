digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-emulation</TD><TD title="repository" href="./vkd3d-proton.html">vkd3d-proton</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a.svg">detail</TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a-bdepend.svg">bdepend</TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a-cdepend.svg">cdepend</TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a-depend.svg">depend</TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a-idepend.svg">idepend</TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a-rdepend.svg">rdepend</TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/vkd3d-proton-9999" href="../app-emulation/vkd3d-proton-9999-emerge.svg">&lt;&lt; newest</TD><TD title="portage://app-emulation/vkd3d-proton-3.0b" href="../app-emulation/vkd3d-proton-3.0b-emerge.svg">&lt; newer</TD><TD title="portage://app-emulation/vkd3d-proton-3.0" href="../app-emulation/vkd3d-proton-3.0-emerge.svg">older &gt;</TD><TD title="portage://app-emulation/vkd3d-proton-2.6-r1" href="../app-emulation/vkd3d-proton-2.6-r1-emerge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a-merge.svg">--merge&nbsp;</TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/vkd3d-proton-3.0a" href="../app-emulation/vkd3d-proton-3.0a-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
