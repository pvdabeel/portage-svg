graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-emulation</TD><TD title="repository" href="./wine-proton.html">wine-proton</TD><TD BORDER='0'></TD><TD title="portage://app-emulation/wine-proton-9999" href="../app-emulation/wine-proton-9999.svg"><u>detail</u></TD><TD title="portage://app-emulation/wine-proton-9999" href="../app-emulation/wine-proton-9999-bdepend.svg">bdepend</TD><TD title="portage://app-emulation/wine-proton-9999" href="../app-emulation/wine-proton-9999-cdepend.svg">cdepend</TD><TD title="portage://app-emulation/wine-proton-9999" href="../app-emulation/wine-proton-9999-depend.svg">depend</TD><TD title="portage://app-emulation/wine-proton-9999" href="../app-emulation/wine-proton-9999-idepend.svg">idepend</TD><TD title="portage://app-emulation/wine-proton-9999" href="../app-emulation/wine-proton-9999-rdepend.svg">rdepend</TD><TD title="portage://app-emulation/wine-proton-9999" href="../app-emulation/wine-proton-9999-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://app-emulation/wine-proton-10.0.3" href="../app-emulation/wine-proton-10.0.3.svg">older &gt;</TD><TD title="portage://app-emulation/wine-proton-8.0.5c" href="../app-emulation/wine-proton-8.0.5c.svg">oldest &gt;&gt;</T