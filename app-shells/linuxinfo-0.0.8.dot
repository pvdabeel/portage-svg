digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-shells</TD><TD title="repository" href="./linuxinfo.html">linuxinfo</TD><TD BORDER='0'></TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8.svg"><u>detail</u></TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8-bdepend.svg">bdepend</TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8-cdepend.svg">cdepend</TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8-depend.svg">depend</TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8-idepend.svg">idepend</TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8-rdepend.svg">rdepend</TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-shells/linuxinfo-1.1.0" href="../app-shells/linuxinfo-1.1.0.svg">&lt;&lt; newest</TD><TD title="portage://app-shells/linuxinfo-1.1.0" href="../app-shells/linuxinfo-1.1.0.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8-merge.svg">--merge&nbsp;</TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-shells/linuxinfo-0.0.8" href="../app-shells/linuxinfo-0.0.8-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-shells/linuxinfo-0.0.8", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-shells/linuxinfo-0.0.8.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>app-arch</TD></TR><TR><TD>unzip</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>virtual</TD></TR><TR><TD>pwsh</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency2:w [weight=20, style="solid",arrowhead="odot"];
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"app-arch/unzip-6.0_p29" [label="portage://app-arch/unzip-6.0_p29", color=red, width=4,href="../app-arch/unzip-6.0_p29.svg"];
"app-arch/unzip-6.0_p27-r1" [label="portage://app-arch/unzip-6.0_p27-r1", color=red, width=4,href="../app-arch/unzip-6.0_p27-r1.svg"];
"app-arch/unzip-6.0_p29" [label="pkg://app-arch/unzip-6.0_p29", color=red, width=4,href="../app-arch/unzip-6.0_p29.svg"];
package_dependency1:e -> "app-arch/unzip-6.0_p29":w [style=dotted,weight="100"];
package_dependency1:e -> "app-arch/unzip-6.0_p27-r1":w [style=dotted,weight="100"];
package_dependency1:e -> "app-arch/unzip-6.0_p29":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"virtual/pwsh-7.5" [label="portage://virtual/pwsh-7.5", color=red, width=4,href="../virtual/pwsh-7.5.svg"];
package_dependency2:e -> "virtual/pwsh-7.5":w [style=dotted,weight="100"];
}
}
}
