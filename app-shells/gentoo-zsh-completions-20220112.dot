                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>app-shells</TD></TR><TR><TD>zsh</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[4,3,5],,,4.3.5]</TD></TR></TABLE>>, shape=none, color=blue];
}
