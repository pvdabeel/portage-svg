package_dependency1:e -> "dev-vcs/mercurial-6.7.4-r3":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-vcs/mercurial-6.7.4-r2":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"net-im/prosody-13.0.2" [label="portage://net-im/prosody-13.0.2", color=red, width=4,href="../net-im/prosody-13.0.2.svg"];
package_dependency2:e -> "net-im/prosody-13.0.2":w [style=dotted,weight="100"];
}
}
