"dev-vcs/mercurial-6.8.2" [label="portage://dev-vcs/mercurial-6.8.2", color=red, width=4,href="../dev-vcs/mercurial-6.8.2.svg"];
"dev-vcs/mercurial-6.7.4-r3" [label="portage://dev-vcs/mercurial-6.7.4-r3", color=red, width=4,href="../dev-vcs/mercurial-6.7.4-r3.svg"];
"dev-vcs/mercurial-6.7.4-r2" [label="portage://dev-vcs/mercurial-6.7.4-r2", color=red, width=4,href="../dev-vcs/mercurial-6.7.4-r2.svg"];
package_dependency1:e -> "dev-vcs/mercurial-9999":w [style=dotted,weight="100"];
