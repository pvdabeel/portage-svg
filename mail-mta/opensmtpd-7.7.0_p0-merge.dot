digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">mail-mta</TD><TD title="repository" href="./opensmtpd.html">opensmtpd</TD><TD BORDER='0'></TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0.svg">detail</TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0-bdepend.svg">bdepend</TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0-cdepend.svg">cdepend</TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0-depend.svg">depend</TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0-idepend.svg">idepend</TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0-rdepend.svg">rdepend</TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://mail-mta/opensmtpd-7.6.0_p1" href="../mail-mta/opensmtpd-7.6.0_p1-merge.svg">older &gt;</TD><TD title="portage://mail-mta/opensmtpd-7.5.0_p0" href="../mail-mta/opensmtpd-7.5.0_p0-merge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0-merge.svg">--<u>merge</u>&nbsp;</TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://mail-mta/opensmtpd-7.7.0_p0" href="../mail-mta/opensmtpd-7.7.0_p0-emerge.svg">emerge</TD></TR></TABLE>>];

