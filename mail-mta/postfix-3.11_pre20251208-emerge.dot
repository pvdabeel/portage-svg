digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">mail-mta</TD><TD title="repository" href="./postfix.html">postfix</TD><TD BORDER='0'></TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208.svg">detail</TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208-bdepend.svg">bdepend</TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208-cdepend.svg">cdepend</TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208-depend.svg">depend</TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208-idepend.svg">idepend</TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208-rdepend.svg">rdepend</TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://mail-mta/postfix-3.10.7" href="../mail-mta/postfix-3.10.7-emerge.svg">older &gt;</TD><TD title="portage://mail-mta/postfix-3.10.4" href="../mail-mta/postfix-3.10.4-emerge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208-merge.svg">--merge&nbsp;</TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://mail-mta/postfix-3.11_pre20251208" href="../mail-mta/postfix-3.11_pre20251208-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
