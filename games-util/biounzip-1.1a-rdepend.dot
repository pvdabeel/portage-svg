digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">games-util</TD><TD title="repository" href="./biounzip.html">biounzip</TD><TD BORDER='0'></TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a.svg">detail</TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a-bdepend.svg">bdepend</TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a-cdepend.svg">cdepend</TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a-depend.svg">depend</TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a-idepend.svg">idepend</TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a-rdepend.svg"><u>rdepend</u></TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a-merge.svg">--merge&nbsp;</TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://games-util/biounzip-1.1a" href="../games-util/biounzip-1.1a-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://games-util/biounzip-1.1a"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://games-util/biounzip-1.1a" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../games-util/biounzip-1.1a-rdepend.svg"];
"portage://games-util/biounzip-1.1a" -> "portage://virtual/zlib-1.3.1-r1"
"portage://virtual/zlib-1.3.1-r1" [color=red, penwidth=1, href="../virtual/zlib-1.3.1-r1-rdepend.svg"];
}
