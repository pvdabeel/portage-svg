digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-ml</TD><TD title="repository" href="./ppx_js_style.html">ppx_js_style</TD><TD BORDER='0'></TD><TD title="portage://dev-ml/ppx_js_style-0.17.1" href="../dev-ml/ppx_js_style-0.17.1.svg">detail</TD><TD title="portage://dev-ml/ppx_js_style-0.17.1" href="../dev-ml/ppx_js_style-0.17.1-bdepend.svg">bdepend</TD><TD title="portage://dev-ml/ppx_js_style-0.17.1" href="../dev-ml/ppx_js_style-0.17.1-cdepend.svg">cdepend</TD><TD title="portage://dev-ml/ppx_js_style-0.17.1" href="../dev-ml/ppx_js_style-0.17.1-depend.svg">depend</TD><TD title="portage://dev-ml/ppx_js_style-0.17.1" href="../dev-ml/ppx_js_style-0.17.1-idepend.svg">idepend</TD><TD title="portage://dev-ml/ppx_js_style-0.17.1" href="../dev-ml/ppx_js_style-0.17.1-rdepend.svg">rdepend</TD><TD title="portage://dev-ml/ppx_js_style-0.17.1" href="../dev-ml/ppx_js_style-0.17.1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://dev-ml/ppx_js_style-0.17.0-r2" href="../dev-ml/ppx_js_style-0.17.0-r2-merge.svg">older &gt;</TD><TD title="portage://dev-ml/ppx_js_style-0.16.0-r1" href="../dev-ml/ppx_js_style-0.16.0-r1-merge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-ml/ppx_js_style-0.17.