digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-ml</TD><TD title="repository" href="./fmt.html">fmt</TD><TD BORDER='0'></TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0.svg">detail</TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0-bdepend.svg">bdepend</TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0-cdepend.svg">cdepend</TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0-depend.svg">depend</TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0-idepend.svg">idepend</TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0-rdepend.svg"><u>rdepend</u></TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://dev-ml/fmt-0.9.0" href="../dev-ml/fmt-0.9.0-rdepend.svg">older &gt;</TD><TD title="portage://dev-ml/fmt-0.9.0" href="../dev-ml/fmt-0.9.0-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-ml/fmt-0.11.0" href="../dev-ml/fmt-0.11.0-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://dev-ml/fmt-0.11.0"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://dev-ml/fmt-0.11.0" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../dev-ml/fmt-0.11.0-rdepend.svg"];
