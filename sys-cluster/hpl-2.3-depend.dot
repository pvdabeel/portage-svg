digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-cluster</TD><TD title="repository" href="./hpl.html">hpl</TD><TD BORDER='0'></TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3.svg">detail</TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3-bdepend.svg">bdepend</TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3-cdepend.svg">cdepend</TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3-depend.svg"><u>depend</u></TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3-idepend.svg">idepend</TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3-rdepend.svg">rdepend</TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://sys-cluster/hpl-2.0-r4" href="../sys-cluster/hpl-2.0-r4-depend.svg">older &gt;</TD><TD title="portage://sys-cluster/hpl-2.0-r4" href="../sys-cluster/hpl-2.0-r4-depend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-cluster/hpl-2.3" href="../sys-cluster/hpl-2.3-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://sys-cluster/hpl-2.3"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://sys-cluster/hpl-2.3" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../sys-cluster/hpl-2.3-depend.svg"];
