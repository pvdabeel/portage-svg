digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-misc</TD><TD title="repository" href="./wayland-utils.html">wayland-utils</TD><TD BORDER='0'></TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0.svg">detail</TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0-bdepend.svg">bdepend</TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0-cdepend.svg">cdepend</TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0-depend.svg"><u>depend</u></TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0-idepend.svg">idepend</TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0-rdepend.svg">rdepend</TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-misc/wayland-utils-1.3.0" href="../app-misc/wayland-utils-1.3.0-depend.svg">&lt;&lt; newest</TD><TD title="portage://app-misc/wayland-utils-1.3.0" href="../app-misc/wayland-utils-1.3.0-depend.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0-merge.svg">--merge&nbsp;</TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-misc/wayland-utils-1.2.0" href="../app-misc/wayland-utils-1.2.0-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-misc/wayland-utils-1.2.0"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-misc/wayland-utils-1.2.0" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-misc/wayland-utils-1.2.0-depend.svg"];
"portage://app-misc/wayland-utils-1.2.0" -> "portage://dev-libs/wayland-9999"
"portage://app-misc/wayland-utils-1.2.0" -> "portage://x11-libs/libdrm-9999"
"portage://app-misc/wayland-utils-1.2.0" -> "portage://dev-libs/wayland-protocols-9999"
"portage://dev-libs/wayland-9999" [color=red, penwidth=1, href="../dev-libs/wayland-9999-depend.svg"];
"portage://dev-libs/wayland-9999" -> "portage://dev-libs/libffi-9999"
"portage://dev-libs/libffi-9999" [color=red, penwidth=1, href="../dev-libs/libffi-9999-depend.svg"];
"portage://x11-libs/libdrm-9999" [color=red, penwidth=1, href="../x11-libs/libdrm-9999-depend.svg"];
"portage://dev-libs/wayland-protocols-9999" [color=red, penwidth=1, href="../dev-libs/wayland-protocols-9999-depend.svg"];
}
