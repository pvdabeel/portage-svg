digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-misc</TD><TD title="repository" href="./c_rehash.html">c_rehash</TD><TD BORDER='0'></TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1.svg"><u>detail</u></TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1-bdepend.svg">bdepend</TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1-cdepend.svg">cdepend</TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1-depend.svg">depend</TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1-idepend.svg">idepend</TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1-rdepend.svg">rdepend</TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1-merge.svg">--merge&nbsp;</TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-misc/c_rehash-1.7-r1" href="../app-misc/c_rehash-1.7-r1-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-misc/c_rehash-1.7-r1", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-misc/c_rehash-1.7-r1.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
weak_blocker1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>dev-libs</TD></TR><TR><TD>openssl</TD></TR>
                     <TR><TD>smaller</TD></TR><TR><TD>[[1,0,2],d,-r1,1.0.2d-r1]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker1:w [weight=20, color="orange", style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
weak_blocker2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>dev-libs</TD></TR><TR><TD>openssl</TD></TR>
                     <TR><TD>smaller</TD></TR><TR><TD>[[1,0,2],d,-r1,1.0.2d-r1]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker2:w [weight=20, color="orange", style="solid",arrowhead="odot"];
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
}
subgraph  {
color=black;
nodesep=1;
}
}
}
