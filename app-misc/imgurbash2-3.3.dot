digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-misc</TD><TD title="repository" href="./imgurbash2.html">imgurbash2</TD><TD BORDER='0'></TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3.svg"><u>detail</u></TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3-bdepend.svg">bdepend</TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3-cdepend.svg">cdepend</TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3-depend.svg">depend</TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3-idepend.svg">idepend</TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3-rdepend.svg">rdepend</TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-misc/imgurbash2-9999" href="../app-misc/imgurbash2-9999.svg">&lt;&lt; newest</TD><TD title="portage://app-misc/imgurbash2-9999" href="../app-misc/imgurbash2-9999.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3-merge.svg">--merge&nbsp;</TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-misc/imgurbash2-3.3" href="../app-misc/imgurbash2-3.3-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-misc/imgurbash2-3.3", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-misc/imgurbash2-3.3.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
use_conditional_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD ROWSPAN="3" CELLPADDING="10">use_conditional</TD></TR>
          <TR><TD>positive</TD></TR><TR><TD>X</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
any_of_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD CELLPADDING="10">any_of_group</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>x11-misc</TD></TR><TR><TD>xclip</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
any_of_group1:e -> package_dependency1:w [weight=20, style="dotted",arrowhead="oinv"];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>x11-misc</TD></TR><TR><TD>xsel</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
any_of_group1:e -> package_dependency2:w [weight=20, style="dotted",arrowhead="oinv"];
}
use_conditional_group1:e -> any_of_group1:w [weight=20, style="dashed",arrowhead="vee"];
}
id:e -> use_conditional_group1:w [weight=20, style="solid",arrowhead="odot"];
subgraph  {
use_conditional_group2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD ROWSPAN="3" CELLPADDING="10">use_conditional</TD></TR>
          <TR><TD>positive</TD></TR><TR><TD>wayland</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>gui-apps</TD></TR><TR><TD>wl-clipboard</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
use_conditional_group2:e -> package_dependency3:w [weight=20, style="dashed",arrowhead="vee"];
}
id:e -> use_conditional_group2:w [weight=20, style="solid",arrowhead="odot"];
subgraph  {
package_dependency4 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>net-misc</TD></TR><TR><TD>curl</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency4:w [weight=20, style="solid",arrowhead="odot"];
}
}

