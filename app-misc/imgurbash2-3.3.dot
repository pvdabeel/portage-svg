"net-misc/curl-8.17.0" [label="portage://net-misc/curl-8.17.0", color=red, width=4,href="../net-misc/curl-8.17.0.svg"];
"net-misc/curl-8.16.0-r1" [label="portage://net-misc/curl-8.16.0-r1", color=red, width=4,href="../net-misc/curl-8.16.0-r1.svg"];
