"gui-apps/wl-clipboard-2.2.1-r1" [label="portage://gui-apps/wl-clipboard-2.2.1-r1", color=red, width=4,href="../gui-apps/wl-clipboard-2.2.1-r1.svg"];
package_dependency3:e -> "gui-apps/wl-clipboard-9999":w [style=dotted,weight="100"];
package_dependency3:e -> "gui-apps/wl-clipboard-2.2.1-r1":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"net-misc/curl-9999" [label="portage://net-misc/curl-9999", color=red, width=4,href="../net-misc/curl-9999.svg"];
