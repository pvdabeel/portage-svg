"net-misc/curl-8.14.0" [label="pkg://net-misc/curl-8.14.0", color=red, width=4,href="../net-misc/curl-8.14.0.svg"];
package_dependency4:e -> "net-misc/curl-9999":w [style=dotted,weight="100"];
package_dependency4:e -> "net-misc/curl-8.17.0-r1":w [style=dotted,weight="100"];
package_dependency4:e -> "net-misc/curl-8.17.0":w [style=dotted,weight="100"];
package_dependency4:e -> "net-misc/curl-8.16.0-r1":w [style=dotted,weight="100"];
package_dependency4:e -> "net-misc/curl-8.15.0":w [style=dotted,weight="100"];
package_dependency4:e -> "net-misc/curl-8.14.0":w [style=dotted,weight="100"];
}
}
}
