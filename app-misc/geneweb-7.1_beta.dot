digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-misc</TD><TD title="repository" href="./geneweb.html">geneweb</TD><TD BORDER='0'></TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta.svg"><u>detail</u></TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta-bdepend.svg">bdepend</TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta-cdepend.svg">cdepend</TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta-depend.svg">depend</TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta-idepend.svg">idepend</TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta-rdepend.svg">rdepend</TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta-merge.svg">--merge&nbsp;</TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-misc/geneweb-7.1_beta" href="../app-misc/geneweb-7.1_beta-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-misc/geneweb-7.1_beta", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-misc/geneweb-7.1_beta.svg"];
}

