"portage://media-libs/libsdl2-2.32.60" [color=red, penwidth=1, href="../media-libs/libsdl2-2.32.60-rdepend.svg"];
"portage://media-libs/libsdl2-2.32.60" -> "portage://media-libs/libsdl3-3.2.28"
"portage://media-libs/libsdl3-3.2.28" [color=red, penwidth=1, href="../media-libs/libsdl3-3.2.28-rdepend.svg"];
"portage://media-libs/libsdl3-3.2.28" -> "portage://virtual/libiconv-0-r2"
"portage://virtual/libiconv-0-r2" [color=red, penwidth=1, href="../virtual/libiconv-0-r2-rdepend.svg"];
