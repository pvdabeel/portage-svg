subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"media-libs/libjpeg-turbo-3.1.3" [label="portage://media-libs/libjpeg-turbo-3.1.3", color=red, width=4,href="../media-libs/libjpeg-turbo-3.1.3.svg"];
"media-libs/libjpeg-turbo-3.1.2" [label="portage://media-libs/libjpeg-turbo-3.1.2", color=red, width=4,href="../media-libs/libjpeg-turbo-3.1.2.svg"];
"media-libs/libjpeg-turbo-3.1.1" [label="portage://media-libs/libjpeg-turbo-3.1.1", color=red, width=4,href="../media-libs/libjpeg-turbo-3.1.1.svg"];
"media-libs/libjpeg-turbo-3.1.0" [label="pkg://media-libs/libjpeg-turbo-3.1.0", color=red, width=4,href="../media-libs/libjpeg-turbo-3.1.0.svg"];
package_dependency1:e -> "media-libs/libjpeg-turbo-3.1.3":w [style=dotted,weight="100"];
package_dependency1:e -> "media-libs/libjpeg-turbo-3.1.2":w [style=dotted,weight="100"];
package_dependency1:e -> "media-libs/libjpeg-turbo-3.1.1":w [style=dotted,weight="100"];
package_dependency1:e -> "media-libs/libjpeg-turbo-3.1.0":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
}
}
}
