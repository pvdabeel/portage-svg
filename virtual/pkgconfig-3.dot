digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">virtual</TD><TD title="repository" href="./pkgconfig.html">pkgconfig</TD><TD BORDER='0'></TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3.svg"><u>detail</u></TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3-bdepend.svg">bdepend</TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3-cdepend.svg">cdepend</TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3-depend.svg">depend</TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3-idepend.svg">idepend</TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3-rdepend.svg">rdepend</TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3-merge.svg">--merge&nbsp;</TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://virtual/pkgconfig-3" href="../virtual/pkgconfig-3-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://virtual/pkgconfig-3", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../virtual/pkgconfig-3.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>dev-util</TD></TR><TR><TD>pkgconf</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="odot"];
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"dev-util/pkgconf-9999" [label="portage://dev-util/pkgconf-9999", color=red, width=4,href="../dev-util/pkgconf-9999.svg"];
"dev-util/pkgconf-2.5.1" [label="portage://dev-util/pkgconf-2.5.1", color=red, width=4,href="../dev-util/pkgconf-2.5.1.svg"];
"dev-util/pkgconf-2.4.3" [label="portage://dev-util/pkgconf-2.4.3", color=red, width=4,href="../dev-util/pkgconf-2.4.3.svg"];
"dev-util/pkgconf-2.3.0" [label="portage://dev-util/pkgconf-2.3.0", color=red, width=4,href="../dev-util/pkgconf-2.3.0.svg"];
"dev-util/pkgconf-2.4.3" [label="pkg://dev-util/pkgconf-2.4.3", color=red, width=4,href="../dev-util/pkgconf-2.4.3.svg"];
package_dependency1:e -> "dev-util/pkgconf-9999":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-util/pkgconf-2.5.1":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-util/pkgconf-2.4.3":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-util/pkgconf-2.3.0":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-util/pkgconf-2.4.3":w [style=dotted,weight="100"];
}
}
}
