digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">virtual</TD><TD title="repository" href="./glu.html">glu</TD><TD BORDER='0'></TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2.svg"><u>detail</u></TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2-bdepend.svg">bdepend</TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2-cdepend.svg">cdepend</TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2-depend.svg">depend</TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2-idepend.svg">idepend</TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2-rdepend.svg">rdepend</TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2-merge.svg">--merge&nbsp;</TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://virtual/glu-9.0-r2" href="../virtual/glu-9.0-r2-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://virtual/glu-9.0-r2", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../virtual/glu-9.0-r2.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
any_of_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD CELLPADDING="10">any_of_group</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>media-libs</TD></TR><TR><TD>glu</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[9,0,0],,-r1,9.0.0-r1]</TD></TR></TABLE>>, shape=none, color=blue];
}
any_of_group1:e -> package_dependency1:w [weight=20, style="dotted",arrowhead="oinv"];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>dev-util</TD></TR><TR><TD>mingw64-runtime</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
any_of_group1:e -> package_dependency2:w [weight=20, style="dotted",arrowhead="oinv"];
}
id:e -> any_of_group1:w [weight=20, style="solid",arrowhead="odot"];
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"media-libs/glu-9999" [label="portage://media-libs/glu-9999", color=red, width=4,href="../media-libs/glu-9999.svg"];
"media-libs/glu-9.0.3" [label="portage://media-libs/glu-9.0.3", color=red, width=4,href="../media-libs/glu-9.0.3.svg"];
"media-libs/glu-9.0.3" [label="pkg://media-libs/glu-9.0.3", color=red, width=4,href="../media-libs/glu-9.0.3.svg"];
package_dependency1:e -> "media-libs/glu-9999":w [style=dotted,weight="100"];
package_dependency1:e -> "media-libs/glu-9.0.3":w [style=dotted,weight="100"];
package_dependency1:e -> "media-libs/glu-9.0.3":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"dev-util/mingw64-runtime-13.0.0" [label="portage://dev-util/mingw64-runtime-13.0.0", color=red, width=4,href="../dev-util/mingw64-runtime-13.0.0.svg"];
"dev-util/mingw64-runtime-12.0.0" [label="portage://dev-util/mingw64-runtime-12.0.0", color=red, width=4,href="../dev-util/mingw64-runtime-12.0.0.svg"];
package_dependency2:e -> "dev-util/mingw64-runtime-13.0.0":w [style=dotted,weight="100"];
package_dependency2:e -> "dev-util/mingw64-runtime-12.0.0":w [style=dotted,weight="100"];
}
}
}
