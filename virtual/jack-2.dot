"media-sound/jack2-1.9.22" [label="portage://media-sound/jack2-1.9.22", color=red, width=4,href="../media-sound/jack2-1.9.22.svg"];
package_dependency1:e -> "media-sound/jack2-9999":w [style=dotted,weight="100"];
package_dependency1:e -> "media-sound/jack2-1.9.22":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"media-sound/jack-audio-connection-kit-0.125.0-r1" [label="portage://media-sound/jack-audio-connection-kit-0.125.0-r1", color=red, width=4,href="../media-sound/jack-audio-connection-kit-0.125.0-r1.svg"];
