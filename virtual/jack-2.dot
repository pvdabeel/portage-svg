"media-video/pipewire-1.4.9-r1" [label="portage://media-video/pipewire-1.4.9-r1", color=red, width=4,href="../media-video/pipewire-1.4.9-r1.svg"];
"media-video/pipewire-1.4.8-r3" [label="portage://media-video/pipewire-1.4.8-r3", color=red, width=4,href="../media-video/pipewire-1.4.8-r3.svg"];
"media-video/pipewire-1.4.7-r3" [label="portage://media-video/pipewire-1.4.7-r3", color=red, width=4,href="../media-video/pipewire-1.4.7-r3.svg"];
package_dependency3:e -> "media-video/pipewire-9999":w [style=dotted,weight="100"];
package_dependency3:e -> "media-video/pipewire-1.4.9999":w [style=dotted,weight="100"];
package_dependency3:e -> "media-video/pipewire-1.4.9-r1":w [style=dotted,weight="100"];
package_dependency3:e -> "media-video/pipewire-1.4.8-r3":w [style=dotted,weight="100"];
package_dependency3:e -> "media-video/pipewire-1.4.7-r3":w [style=dotted,weight="100"];
}
}
}
