digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">virtual</TD><TD title="repository" href="./httpd-cgi.html">httpd-cgi</TD><TD BORDER='0'></TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4.svg"><u>detail</u></TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4-bdepend.svg">bdepend</TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4-cdepend.svg">cdepend</TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4-depend.svg">depend</TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4-idepend.svg">idepend</TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4-rdepend.svg">rdepend</TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://virtual/httpd-cgi-0-r6" href="../virtual/httpd-cgi-0-r6.svg">&lt;&lt; newest</TD><TD title="portage://virtual/httpd-cgi-0-r6" href="../virtual/httpd-cgi-0-r6.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4-merge.svg">--merge&nbsp;</TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://virtual/httpd-cgi-0-r4" href="../virtual/httpd-cgi-0-r4-emerge.svg">emerge</TD></TR></TABLE>>];

