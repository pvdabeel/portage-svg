digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">virtual</TD><TD title="repository" href="./jdk.html">jdk</TD><TD BORDER='0'></TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17.svg"><u>detail</u></TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17-bdepend.svg">bdepend</TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17-cdepend.svg">cdepend</TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17-depend.svg">depend</TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17-idepend.svg">idepend</TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17-rdepend.svg">rdepend</TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://virtual/jdk-26" href="../virtual/jdk-26.svg">&lt;&lt; newest</TD><TD title="portage://virtual/jdk-21" href="../virtual/jdk-21.svg">&lt; newer</TD><TD title="portage://virtual/jdk-11-r2" href="../virtual/jdk-11-r2.svg">older &gt;</TD><TD title="portage://virtual/jdk-1.8.0-r9" href="../virtual/jdk-1.8.0-r9.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17-merge.svg">--merge&nbsp;</TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://virtual/jdk-17" href="../virtual/jdk-17-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://virtual/jdk-17", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../virtual/jdk-17.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
any_of_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD CELLPADDING="10">any_of_group</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>dev-java</TD></TR><TR><TD>openjdk-bin</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
any_of_group1:e -> package_dependency1:w [weight=20, style="dotted",arrowhead="oinv"];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>dev-java</TD></TR><TR><TD>openjdk</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
any_of_group1:e -> package_dependency2:w [weight=20, style="dotted",arrowhead="oinv"];
}
id:e -> any_of_group1:w [weight=20, style="solid",arrowhead="odot"];
}
}

