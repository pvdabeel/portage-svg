"net-mail/mailutils-3.20-r1" [label="portage://net-mail/mailutils-3.20-r1", color=red, width=4,href="../net-mail/mailutils-3.20-r1.svg"];
"net-mail/mailutils-3.18" [label="portage://net-mail/mailutils-3.18", color=red, width=4,href="../net-mail/mailutils-3.18.svg"];
package_dependency1:e -> "net-mail/mailutils-3.21":w [style=dotted,weight="100"];
package_dependency1:e -> "net-mail/mailutils-3.20-r1":w [style=dotted,weight="100"];
package_dependency1:e -> "net-mail/mailutils-3.18":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"mail-client/mailx-8.1.2.20220412" [label="portage://mail-client/mailx-8.1.2.20220412", color=red, width=4,href="../mail-client/mailx-8.1.2.20220412.svg"];
package_dependency2:e -> "mail-client/mailx-8.1.2.20220412":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"mail-client/s-nail-14.9.25" [label="portage://mail-client/s-nail-14.9.25", color=red, width=4,href="../mail-client/s-nail-14.9.25.svg"];
"mail-client/s-nail-14.9.24" [label="portage://mail-client/s-nail-14.9.24", color=red, width=4,href="../mail-client/s-nail-14.9.24.svg"];
package_dependency3:e -> "mail-client/s-nail-14.9.25":w [style=dotted,weight="100"];
package_dependency3:e -> "mail-client/s-nail-14.9.24":w [style=dotted,weight="100"];
}
}
}
