itle="portage://net-firewall/firewalld-2.4.0" href="../net-firewall/firewalld-2.4.0-merge.svg">--merge&nbsp;</TD><TD title="portage://net-firewall/firewalld-2.4.0" href="../net-firewall/firewalld-2.4.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-firewall/firewalld-2.4.0" href="../net-firewall/firewalld-2.4.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-firewall/firewalld-2.4.0" href="../net-firewall/firewalld-2.4.0-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-firewall/firewalld-2.4.0"[minlen=0.2, headport=n, tailport=s, style=invis];

