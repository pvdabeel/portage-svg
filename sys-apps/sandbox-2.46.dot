digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-apps</TD><TD title="repository" href="./sandbox.html">sandbox</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46.svg"><u>detail</u></TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46-bdepend.svg">bdepend</TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46-cdepend.svg">cdepend</TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46-depend.svg">depend</TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46-idepend.svg">idepend</TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46-rdepend.svg">rdepend</TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/sandbox-9999" href="../sys-apps/sandbox-9999.svg">&lt;&lt; newest</TD><TD title="portage://sys-apps/sandbox-9999" href="../sys-apps/sandbox-9999.svg">&lt; newer</TD><TD title="portage://sys-apps/sandbox-2.39" href="../sys-apps/sandbox-2.39.svg">older &gt;</TD><TD title="portage://sys-apps/sandbox-2.39" href="../sys-apps/sandbox-2.39.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/sandbox-2.46" href="../sys-apps/sandbox-2.46-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://sys-apps/sandbox-2.46", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../sys-apps/sandbox-2.46.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>app-arch</TD></TR><TR><TD>xz-utils</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>app-misc</TD></TR><TR><TD>pax-utils</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[0,1,19],,,0.1.19]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency2:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
weak_blocker1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>sys-apps</TD></TR><TR><TD>file</TD></TR>
                     <TR><TD>smaller</TD></TR><TR><TD>[[5,44],,-r1,5.44-r1]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker1:w [weight=20, color="orange", style="solid",arrowhead="odot"];
}
}

