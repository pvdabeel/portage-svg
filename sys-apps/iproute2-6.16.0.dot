digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-apps</TD><TD title="repository" href="./iproute2.html">iproute2</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/iproute2-6.16.0" href="../sys-apps/iproute2-6.16.0.svg"><u>detail</u></TD><TD title="portage://sys-apps/iproute2-6.16.0" href="../sys-apps/iproute2-6.16.0-bdepend.svg">bdepend</TD><TD title="portage://sys-apps/iproute2-6.16.0" href="../sys-apps/iproute2-6.16.0-cdepend.svg">cdepend</TD><TD title="portage://sys-apps/iproute2-6.16.0" href="../sys-apps/iproute2-6.16.0-depend.svg">depend</TD><TD title="portage://sys-apps/iproute2-6.16.0" href="../sys-apps/iproute2-6.16.0-idepend.svg">idepend</TD><TD title="portage://sys-apps/iproute2-6.16.0" href="../sys-apps/iproute2-6.16.0-rdepend.svg">rdepend</TD><TD title="portage://sys-apps/iproute2-6.16.0" href="../sys-apps/iproute2-6.16.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/iproute2-9999" href="../sys-apps/iproute2-9999.svg">&lt;&lt; newest</TD><TD title="portage://sys-apps/iproute2-6.17.0" href="../sys-apps/iproute2-6.17.0.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://sys-apps/iproute2-6.16.0" href="../sys-apps/iproute2-6.16.0-merge.svg">--merge&nbsp;</TD