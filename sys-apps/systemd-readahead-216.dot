graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-apps</TD><TD title="repository" href="./systemd-readahead.html">systemd-readahead</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/systemd-readahead-216" href="../sys-apps/systemd-readahead-216.svg"><u>detail</u></TD><TD title="portage://sys-apps/systemd-readahead-216" href="../sys-apps/systemd-readahead-216-bdepend.svg">bdepend</TD><TD title="portage://sys-apps/systemd-readahead-216" href="../sys-apps/systemd-readahead-216-cdepend.svg">cdepend</TD><TD title="portage://sys-apps/systemd-readahead-216" href="../sys-apps/systemd-readahead-216-depend.svg">depend</TD><TD title="portage://sys-apps/systemd-readahead-216" href="../sys-apps/systemd-readahead-216-idepend.svg">idepend</TD><TD title="portage://sys-apps/systemd-readahead-216" href="../sys-apps/systemd-readahead-216-rdepend.svg">rdepend</TD><TD title="portage://sys-apps/systemd-readahead-216" href="../sys-apps/systemd-readahead-216-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://sys-apps/systemd-readahead-216" href="../sys-apps/systemd-readahead-216-merge.svg">--merge&nbs