digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-apps</TD><TD title="repository" href="./usbutils.html">usbutils</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017.svg">detail</TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017-bdepend.svg">bdepend</TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017-cdepend.svg">cdepend</TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017-depend.svg"><u>depend</u></TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017-idepend.svg">idepend</TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017-rdepend.svg">rdepend</TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/usbutils-019" href="../sys-apps/usbutils-019-depend.svg">&lt;&lt; newest</TD><TD title="portage://sys-apps/usbutils-018" href="../sys-apps/usbutils-018-depend.svg">&lt; newer</TD><TD title="portage://sys-apps/usbutils-016" href="../sys-apps/usbutils-016-depend.svg">older &gt;</TD><TD title="portage://sys-apps/usbutils-016" href="../sys-apps/usbutils-016-depend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/usbutils-017" href="../sys-apps/usbutils-017-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://sys-apps/usbutils-017"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://sys-apps/usbutils-017" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../sys-apps/usbutils-017-depend.svg"];
