digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-apps</TD><TD title="repository" href="./xdg-desktop-portal.html">xdg-desktop-portal</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3.svg">detail</TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3-bdepend.svg">bdepend</TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3-cdepend.svg">cdepend</TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3-depend.svg">depend</TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3-idepend.svg"><u>idepend</u></TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3-rdepend.svg">rdepend</TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.0-r2" href="../sys-apps/xdg-desktop-portal-1.20.0-r2-idepend.svg">older &gt;</TD><TD title="portage://sys-apps/xdg-desktop-portal-1.18.4-r1" href="../sys-apps/xdg-desktop-portal-1.18.4-r1-idepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/xdg-desktop-portal-1.20.3" href="../sys-apps/xdg-desktop-portal-1.20.3-emerge.svg">emerge</TD></TR></TABLE>>];

