digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-apps</TD><TD title="repository" href="./hd-idle.html">hd-idle</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4.svg"><u>detail</u></TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4-bdepend.svg">bdepend</TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4-cdepend.svg">cdepend</TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4-depend.svg">depend</TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4-idepend.svg">idepend</TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4-rdepend.svg">rdepend</TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://sys-apps/hd-idle-1.05-r3" href="../sys-apps/hd-idle-1.05-r3.svg">older &gt;</TD><TD title="portage://sys-apps/hd-idle-1.05-r2" href="../sys-apps/hd-idle-1.05-r2.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-apps/hd-idle-1.05-r4" href="../sys-apps/hd-idle-1.05-r4-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://sys-apps/hd-idle-1.05-r4", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../sys-apps/hd-idle-1.05-r4.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>virtual</TD></TR><TR><TD>pkgconfig</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"virtual/pkgconfig-3" [label="portage://virtual/pkgconfig-3", color=red, width=4,href="../virtual/pkgconfig-3.svg"];
"virtual/pkgconfig-3" [label="pkg://virtual/pkgconfig-3", color=red, width=4,href="../virtual/pkgconfig-3.svg"];
package_dependency1:e -> "virtual/pkgconfig-3":w [style=dotted,weight="100"];
package_dependency1:e -> "virtual/pkgconfig-3":w [style=dotted,weight="100"];
}
}
}
