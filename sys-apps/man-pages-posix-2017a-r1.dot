"virtual/man-0-r4" [label="pkg://virtual/man-0-r4", color=red, width=4,href="../virtual/man-0-r4.svg"];
package_dependency1:e -> "virtual/man-0-r4":w [style=dotted,weight="100"];
package_dependency1:e -> "virtual/man-0-r4":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
}
}
}
