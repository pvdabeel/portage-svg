fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>media-libs</TD></TR><TR><TD>jbigkit</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[2,0],,-r1,2.0-r1]</TD></TR></TABLE>>, shape=none, color=blue];
}
