digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-print</TD><TD title="repository" href="./ink.html">ink</TD><TD BORDER='0'></TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3.svg">detail</TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3-bdepend.svg">bdepend</TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3-cdepend.svg">cdepend</TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3-depend.svg">depend</TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3-idepend.svg">idepend</TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3-rdepend.svg"><u>rdepend</u></TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3-merge.svg">--merge&nbsp;</TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-print/ink-0.5.3" href="../net-print/ink-0.5.3-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-print/ink-0.5.3"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-print/ink-0.5.3" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-print/ink-0.5.3-rdepend.svg"];
"portage://net-print/ink-0.5.3" -> "portage://net-print/libinklevel-0.9.7"
"portage://net-print/libinklevel-0.9.7" [color=red, penwidth=1, href="../net-print/libinklevel-0.9.7-rdepend.svg"];
"portage://net-print/libinklevel-0.9.7" -> "portage://dev-libs/libxml2-9999"
"portage://net-print/libinklevel-0.9.7" -> "portage://virtual/libusb-1-r2"
"portage://dev-libs/libxml2-9999" [color=red, penwidth=1, href="../dev-libs/libxml2-9999-rdepend.svg"];
"portage://dev-libs/libxml2-9999" -> "portage://virtual/libiconv-0-r2"
"portage://dev-libs/libxml2-9999" -> "portage://virtual/zlib-1.3.1-r1"
"portage://virtual/libiconv-0-r2" [color=red, penwidth=1, href="../virtual/libiconv-0-r2-rdepend.svg"];
"portage://virtual/zlib-1.3.1-r1" [color=red, penwidth=1, href="../virtual/zlib-1.3.1-r1-rdepend.svg"];
"portage://virtual/libusb-1-r2" [color=red, penwidth=1, href="../virtual/libusb-1-r2-rdepend.svg"];
"portage://virtual/libusb-1-r2" -> "portage://dev-libs/libusb-1.0.29"
"portage://dev-libs/libusb-1.0.29" [color=red, penwidth=1, href="../dev-libs/libusb-1.0.29-rdepend.svg"];
}
