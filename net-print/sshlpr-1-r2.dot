fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"net-print/cups-9999" [label="portage://net-print/cups-9999", color=red, width=4,href="../net-print/cups-9999.svg"];
"net-print/cups-2.4.14" [label="portage://net-print/cups-2.4.14", color=red, width=4,href="../net-print/cups-2.4.14.svg"];
package_dependency1:e -> "net-print/cups-9999":w [style=dotted,weight="100"];
package_dependency1:e -> "net-print/cups-2.4.14":w [style=dotted,weight="100"];
}
subgraph  {
