nodesep=1;
"sys-apps/shadow-4.19.0_rc1" [label="portage://sys-apps/shadow-4.19.0_rc1", color=red, width=4,href="../sys-apps/shadow-4.19.0_rc1.svg"];
"sys-apps/shadow-4.14.8-r2" [label="portage://sys-apps/shadow-4.14.8-r2", color=red, width=4,href="../sys-apps/shadow-4.14.8-r2.svg"];
"sys-apps/shadow-4.14.8-r1" [label="portage://sys-apps/shadow-4.14.8-r1", color=red, width=4,href="../sys-apps/shadow-4.14.8-r1.svg"];
"sys-apps/shadow-4.14.8" [label="portage://sys-apps/shadow-4.14.8", color=red, width=4,href="../sys-apps/shadow-4.14.8.svg"];
package_dependency3:e -> "sys-apps/shadow-4.19.0_rc1":w [style=dotted,weight="100"];
package_dependency3:e -> "sys-apps/shadow-4.14.8-r2":w [style=dotted,weight="100"];
package_dependency3:e -> "sys-apps/shadow-4.14.8-r1":w [style=dotted,weight="100"];
package_dependency3:e -> "sys-apps/shadow-4.14.8":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"virtual/openssh-0-r1" [label="portage://virtual/openssh-0-r1", color=red, width=4,href="../virtual/openssh-0-r1.svg"];
"virtual/openssh-0" [label="portage://virtual/openssh-0", color=red, width=4,href="../virtual/openssh-0.svg"];
package_dependency4:e -> "virtual/openssh-0-r1":w [style=dotted,weight="100"];
package_dependency4:e -> "virtual/openssh-0":w [style=dotted,weight="100"];
}
}
}
