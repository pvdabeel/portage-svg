fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://net-print/cups-9999", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../net-print/cups-9999.svg"];
}

