itle="portage://media-plugins/imlib2_loaders-1.12.2" href="../media-plugins/imlib2_loaders-1.12.2.svg">older &gt;</TD><TD title="portage://media-plugins/imlib2_loaders-1.9.1" href="../media-plugins/imlib2_loaders-1.9.1.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://media-plugins/imlib2_loaders-1.12.3" href="../media-plugins/imlib2_loaders-1.12.3-merge.svg">--merge&nbsp;</TD><TD title="portage://media-plugins/imlib2_loaders-1.12.3" href="../media-plugins/imlib2_loaders-1.12.3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-plugins/imlib2_loaders-1.12.3" href="../media-plugins/imlib2_loaders-1.12.3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-plugins/imlib2_loaders-1.12.3" href="../media-plugins/imlib2_loaders-1.12.3-emerge.svg">emerge</TD></TR></TABLE>>];

