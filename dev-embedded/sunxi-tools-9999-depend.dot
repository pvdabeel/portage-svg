root [style=invis];
root -> "portage://dev-embedded/sunxi-tools-9999"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://dev-embedded/sunxi-tools-9999" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../dev-embedded/sunxi-tools-9999-depend.svg"];
