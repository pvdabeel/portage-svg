digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-p2p</TD><TD title="repository" href="./resilio-sync.html">resilio-sync</TD><TD BORDER='0'></TD><TD title="portage://net-p2p/resilio-sync-3.1.1.1075" href="../net-p2p/resilio-sync-3.1.1.1075.svg">detail</TD><TD title="portage://net-p2p/resilio-sync-3.1.1.1075" href="../net-p2p/resilio-sync-3.1.1.1075-bdepend.svg">bdepend</TD><TD title="portage://net-p2p/resilio-sync-3.1.1.1075" href="../net-p2p/resilio-sync-3.1.1.1075-cdepend.svg">cdepend</TD><TD title="portage://net-p2p/resilio-sync-3.1.1.1075" href="../net-p2p/resilio-sync-3.1.1.1075-depend.svg">depend</TD><TD title="portage://net-p2p/resilio-sync-3.1.1.1075" href="../net-p2p/resilio-sync-3.1.1.1075-idepend.svg">idepend</TD><TD title="portage://net-p2p/resilio-sync-3.1.1.1075" href="../net-p2p/resilio-sync-3.1.1.1075-rdepend.svg">rdepend</TD><TD title="portage://net-p2p/resilio-sync-3.1.1.1075" href="../net-p2p/resilio-sync-3.1.1.1075-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-p2p/resilio-sync-9999" href="../net-p2p/resilio-sync-9999-emerge.svg">&lt;&lt; newest</TD><TD title="portage://net-p2p/resilio-sync-9999" href="../net-p2p/resilio-sync-9999-emerge.svg">&lt; newer</TD><TD title="portage://net-p2p/resilio-sync-2.8.1.1390" href="../net-p2p/resilio-sync-2.8.1.1390-emerge.sv