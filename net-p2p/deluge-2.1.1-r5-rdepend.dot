"portage://net-p2p/deluge-2.1.1-r5" -> "portage://net-libs/libtorrent-rasterbar-2.0.10"
"portage://acct-group/deluge-0-r3" [color=red, penwidth=1, href="../acct-group/deluge-0-r3-rdepend.svg"];
"portage://acct-user/deluge-0-r3" [color=red, penwidth=1, href="../acct-user/deluge-0-r3-rdepend.svg"];
