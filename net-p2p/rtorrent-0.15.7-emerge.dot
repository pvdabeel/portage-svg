digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-p2p</TD><TD title="repository" href="./rtorrent.html">rtorrent</TD><TD BORDER='0'></TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7.svg">detail</TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7-bdepend.svg">bdepend</TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7-cdepend.svg">cdepend</TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7-depend.svg">depend</TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7-idepend.svg">idepend</TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7-rdepend.svg">rdepend</TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-p2p/rtorrent-9999" href="../net-p2p/rtorrent-9999-emerge.svg">&lt;&lt; newest</TD><TD title="portage://net-p2p/rtorrent-0.16.5" href="../net-p2p/rtorrent-0.16.5-emerge.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7-merge.svg">--merge&nbsp;</TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-p2p/rtorrent-0.15.7" href="../net-p2p/rtorrent-0.15.7-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
