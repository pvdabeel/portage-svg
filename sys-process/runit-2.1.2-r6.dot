graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-process</TD><TD title="repository" href="./runit.html">runit</TD><TD BORDER='0'></TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6.svg"><u>detail</u></TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6-bdepend.svg">bdepend</TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6-cdepend.svg">cdepend</TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6-depend.svg">depend</TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6-idepend.svg">idepend</TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6-rdepend.svg">rdepend</TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-process/runit-2.2.0-r2" href="../sys-process/runit-2.2.0-r2.svg">&lt;&lt; newest</TD><TD title="portage://sys-process/runit-2.1.2-r7" href="../sys-process/runit-2.1.2-r7.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-process/runit-2.1.2-r6" href="../sys-process/runit-2.1.2-r6-emerge.svg">emerge</TD></TR></TABLE>>];

