digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-libs</TD><TD title="repository" href="./coin.html">coin</TD><TD BORDER='0'></TD><TD title="portage://media-libs/coin-4.0.4" href="../media-libs/coin-4.0.4.svg"><u>detail</u></TD><TD title="portage://media-libs/coin-4.0.4" href="../media-libs/coin-4.0.4-bdepend.svg">bdepend</TD><TD title="portage://media-libs/coin-4.0.4" href="../media-libs/coin-4.0.4-cdepend.svg">cdepend</TD><TD title="portage://media-libs/coin-4.0.4" href="../media-libs/coin-4.0.4-depend.svg">depend</TD><TD title="portage://media-libs/coin-4.0.4" href="../media-libs/coin-4.0.4-idepend.svg">idepend</TD><TD title="portage://media-libs/coin-4.0.4" href="../media-libs/coin-4.0.4-rdepend.svg">rdepend</TD><TD title="portage://media-libs/coin-4.0.4" href="../media-libs/coin-4.0.4-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://media-libs/coin-4.0.6" href="../media-libs/coin-4.0.6.svg">&lt;&lt; newest</TD><TD title="portage://media-libs/coin-4.0.6" href="../media-libs/coin-4.0.6.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://media-libs/coin-4.0.4" href="../media-libs/coin-4.0.4-merge.svg">--merge&nbsp;</TD><TD title="portage://media-libs/coin-4.0.4" href="../media-li