graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-libs</TD><TD title="repository" href="./fcft.html">fcft</TD><TD BORDER='0'></TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8.svg">detail</TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8-bdepend.svg">bdepend</TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8-cdepend.svg">cdepend</TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8-depend.svg"><u>depend</u></TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8-idepend.svg">idepend</TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8-rdepend.svg">rdepend</TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://media-libs/fcft-3.3.2" href="../media-libs/fcft-3.3.2-depend.svg">&lt;&lt; newest</TD><TD title="portage://media-libs/fcft-3.1.9" href="../media-libs/fcft-3.1.9-depend.svg">&lt; newer</TD><TD title="portage://media-libs/fcft-3.1.7" href="../media-libs/fcft-3.1.7-depend.svg">older &gt;</TD><TD title="portage://media-libs/fcft-3.1.2-r1" href="../media-libs/fcft-3.1.2-r1-depend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8-merge.svg">--merge&nbsp;</TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-libs/fcft-3.1.8" href="../media-libs/fcft-3.1.8-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://media-libs/fcft-3.1.8"[minlen=0.2, headport=n, tailport=s, style=invis];

