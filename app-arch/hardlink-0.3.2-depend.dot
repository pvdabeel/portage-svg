digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-arch</TD><TD title="repository" href="./hardlink.html">hardlink</TD><TD BORDER='0'></TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2.svg">detail</TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2-bdepend.svg">bdepend</TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2-cdepend.svg">cdepend</TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2-depend.svg"><u>depend</u></TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2-idepend.svg">idepend</TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2-rdepend.svg">rdepend</TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2-merge.svg">--merge&nbsp;</TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-arch/hardlink-0.3.2" href="../app-arch/hardlink-0.3.2-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-arch/hardlink-0.3.2"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-arch/hardlink-0.3.2" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-arch/hardlink-0.3.2-depend.svg"];
"portage://app-arch/hardlink-0.3.2" -> "portage://dev-libs/libpcre-8.45-r4"
"portage://app-arch/hardlink-0.3.2" -> "portage://sys-apps/util-linux-9999" [style=dashed, color=orange];
"portage://dev-libs/libpcre-8.45-r4" [color=red, penwidth=1, href="../dev-libs/libpcre-8.45-r4-depend.svg"];
"portage://sys-apps/util-linux-9999" [color=red, penwidth=1, href="../sys-apps/util-linux-9999-depend.svg"];
"portage://sys-apps/util-linux-9999" -> "portage://virtual/libcrypt-2-r1"
"portage://sys-apps/util-linux-9999" -> "portage://virtual/os-headers-0-r2"
"portage://sys-apps/util-linux-9999" -> "portage://acct-group/root-0-r2"
"portage://virtual/libcrypt-2-r1" [color=red, penwidth=1, href="../virtual/libcrypt-2-r1-depend.svg"];
"portage://virtual/os-headers-0-r2" [color=red, penwidth=1, href="../virtual/os-headers-0-r2-depend.svg"];
"portage://acct-group/root-0-r2" [color=red, penwidth=1, href="../acct-group/root-0-r2-depend.svg"];
}
