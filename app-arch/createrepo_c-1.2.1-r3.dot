digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-arch</TD><TD title="repository" href="./createrepo_c.html">createrepo_c</TD><TD BORDER='0'></TD><TD title="portage://app-arch/createrepo_c-1.2.1-r3" href="../app-arch/createrepo_c-1.2.1-r3.svg"><u>detail</u></TD><TD title="portage://app-arch/createrepo_c-1.2.1-r3" href="../app-arch/createrepo_c-1.2.1-r3-bdepend.svg">bdepend</TD><TD title="portage://app-arch/createrepo_c-1.2.1-r3" href="../app-arch/createrepo_c-1.2.1-r3-cdepend.svg">cdepend</TD><TD title="portage://app-arch/createrepo_c-1.2.1-r3" href="../app-arch/createrepo_c-1.2.1-r3-depend.svg">depend</TD><TD title="portage://app-arch/createrepo_c-1.2.1-r3" href="../app-arch/createrepo_c-1.2.1-r3-idepend.svg">idepend</TD><TD title="portage://app-arch/createrepo_c-1.2.1-r3" href="../app-arch/createrepo_c-1.2.1-r3-rdepend.svg">rdepend</TD><TD title="portage://app-arch/createrepo_c-1.2.1-r3" href="../app-arch/createrepo_c-1.2.1-r3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-arch/createrepo_c-9999" href="../app-arch/createrepo_c-9999.svg">&lt;&lt; newest</TD><TD title="portage://app-arch/createrepo_c-9999" href="../app-arch/createrepo_c-9999.svg">&lt; newer</TD><TD title="portage://app-arch/createrepo_c-1.2.1-r2" href="../app-arch/createrepo_c-1.2.1-r2.svg">older &gt;</TD><TD tit