fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-text/papers-48.5", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-text/papers-48.5.svg"];
}

