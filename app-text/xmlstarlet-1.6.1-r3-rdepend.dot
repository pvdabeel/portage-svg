digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-text</TD><TD title="repository" href="./xmlstarlet.html">xmlstarlet</TD><TD BORDER='0'></TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3.svg">detail</TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3-bdepend.svg">bdepend</TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3-cdepend.svg">cdepend</TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3-depend.svg">depend</TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3-idepend.svg">idepend</TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3-rdepend.svg"><u>rdepend</u></TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-text/xmlstarlet-1.6.1-r5" href="../app-text/xmlstarlet-1.6.1-r5-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://app-text/xmlstarlet-1.6.1-r4" href="../app-text/xmlstarlet-1.6.1-r4-rdepend.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3-merge.svg">--merge&nbsp;</TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-text/xmlstarlet-1.6.1-r3" href="../app-text/xmlstarlet-1.6.1-r3-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-text/xmlstarlet-1.6.1-r3"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-text/xmlstarlet-1.6.1-r3" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-text/xmlstarlet-1.6.1-r3-rdepend.svg"];
"portage://app-text/xmlstarlet-1.6.1-r3" -> "portage://dev-libs/libxml2-9999"
"portage://app-text/xmlstarlet-1.6.1-r3" -> "portage://dev-libs/libxslt-9999"
"portage://app-text/xmlstarlet-1.6.1-r3" -> "portage://dev-libs/libgcrypt-1.11.2"
"portage://app-text/xmlstarlet-1.6.1-r3" -> "portage://virtual/libiconv-0-r2"
"portage://dev-libs/libxml2-9999" [color=red, penwidth=1, href="../dev-libs/libxml2-9999-rdepend.svg"];
"portage://dev-libs/libxml2-9999" -> "portage://virtual/libiconv-0-r2"
"portage://dev-libs/libxml2-9999" -> "portage://virtual/zlib-1.3.1-r1"
"portage://virtual/libiconv-0-r2" [color=red, penwidth=1, href="../virtual/libiconv-0-r2-rdepend.svg"];
"portage://virtual/zlib-1.3.1-r1" [color=red, penwidth=1, href="../virtual/zlib-1.3.1-r1-rdepend.svg"];
