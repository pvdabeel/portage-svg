node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-text</TD><TD title="repository" href="./discount.html">discount</TD><TD BORDER='0'></TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a.svg">detail</TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a-bdepend.svg">bdepend</TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a-cdepend.svg">cdepend</TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a-depend.svg">depend</TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a-idepend.svg">idepend</TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a-rdepend.svg"><u>rdepend</u></TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-text/discount-3.0.1.2" href="../app-text/discount-3.0.1.2-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://app-text/discount-3.0.0d" href="../app-text/discount-3.0.0d-rdepend.svg">&lt; newer</TD><TD title="portage://app-text/discount-2.2.7c-r1" href="../app-text/discount-2.2.7c-r1-rdepend.svg">older &gt;</TD><TD title="portage://app-text/discount-2.2.7c-r1" href="../app-text/discount-2.2.7c-r1-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a-merge.svg">--merge&nbsp;</TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-text/discount-3.0.0a" href="../app-text/discount-3.0.0a-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
