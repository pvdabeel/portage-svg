digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-text</TD><TD title="repository" href="./pandoc-bin.html">pandoc-bin</TD><TD BORDER='0'></TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1.svg"><u>detail</u></TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1-bdepend.svg">bdepend</TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1-cdepend.svg">cdepend</TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1-depend.svg">depend</TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1-idepend.svg">idepend</TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1-rdepend.svg">rdepend</TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-text/pandoc-bin-3.8.3" href="../app-text/pandoc-bin-3.8.3.svg">&lt;&lt; newest</TD><TD title="portage://app-text/pandoc-bin-3.8.3" href="../app-text/pandoc-bin-3.8.3.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1-merge.svg">--merge&nbsp;</TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-text/pandoc-bin-3.8.2.1" href="../app-text/pandoc-bin-3.8.2.1-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-text/pandoc-bin-3.8.2.1", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-text/pandoc-bin-3.8.2.1.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
use_conditional_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD ROWSPAN="3" CELLPADDING="10">use_conditional</TD></TR>
          <TR><TD>positive</TD></TR><TR><TD>pandoc-symlink</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
weak_blocker1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>app-text</TD></TR><TR><TD>pandoc</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=orange];
}
use_conditional_group1:e -> weak_blocker1:w [weight=20, color="orange", style="dashed",arrowhead="vee"];
subgraph  {
weak_blocker2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>app-text</TD></TR><TR><TD>pandoc-cli</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=orange];
}
use_conditional_group1:e -> weak_blocker2:w [weight=20, color="orange", style="dashed",arrowhead="vee"];
subgraph  {
weak_blocker3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>dev-haskell</TD></TR><TR><TD>pandoc</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=orange];
}
use_conditional_group1:e -> weak_blocker3:w [weight=20, color="orange", style="dashed",arrowhead="vee"];
}
id:e -> use_conditional_group1:w [weight=20, style="solid",arrowhead="odot"];
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"app-text/pandoc-3" [label="portage://app-text/pandoc-3", color=red, width=4,href="../app-text/pandoc-3.svg"];
"app-text/pandoc-2.18-r2" [label="portage://app-text/pandoc-2.18-r2", color=red, width=4,href="../app-text/pandoc-2.18-r2.svg"];
weak_blocker1:e -> "app-text/pandoc-3":w [style=dotted,weight="100"];
weak_blocker1:e -> "app-text/pandoc-2.18-r2":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"app-text/pandoc-cli-0.1.1-r1" [label="portage://app-text/pandoc-cli-0.1.1-r1", color=red, width=4,href="../app-text/pandoc-cli-0.1.1-r1.svg"];
weak_blocker2:e -> "app-text/pandoc-cli-0.1.1-r1":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"dev-haskell/pandoc-3.1.8-r2" [label="portage://dev-haskell/pandoc-3.1.8-r2", color=red, width=4,href="../dev-haskell/pandoc-3.1.8-r2.svg"];
weak_blocker3:e -> "dev-haskell/pandoc-3.1.8-r2":w [style=dotted,weight="100"];
}
}
}
