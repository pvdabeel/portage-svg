digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-text</TD><TD title="repository" href="./poppler.html">poppler</TD><TD BORDER='0'></TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0.svg">detail</TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0-bdepend.svg">bdepend</TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0-cdepend.svg">cdepend</TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0-depend.svg"><u>depend</u></TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0-idepend.svg">idepend</TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0-rdepend.svg">rdepend</TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-text/poppler-9999" href="../app-text/poppler-9999-depend.svg">&lt;&lt; newest</TD><TD title="portage://app-text/poppler-9999" href="../app-text/poppler-9999-depend.svg">&lt; newer</TD><TD title="portage://app-text/poppler-25.11.0" href="../app-text/poppler-25.11.0-depend.svg">older &gt;</TD><TD title="portage://app-text/poppler-25.11.0" href="../app-text/poppler-25.11.0-depend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0-merge.svg">--merge&nbsp;</TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-text/poppler-25.12.0" href="../app-text/poppler-25.12.0-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-text/poppler-25.12.0"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-text/poppler-25.12.0" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-text/poppler-25.12.0-depend.svg"];
"portage://app-text/poppler-25.12.0" -> "portage://media-libs/fontconfig-2.17.1"
"portage://app-text/poppler-25.12.0" -> "portage://media-libs/freetype-9999"
"portage://app-text/poppler-25.12.0" -> "portage://virtual/zlib-1.3.1-r1"
"portage://media-libs/fontconfig-2.17.1" [color=red, penwidth=1, href="../media-libs/fontconfig-2.17.1-depend.svg"];
"portage://media-libs/fontconfig-2.17.1" -> "portage://dev-libs/expat-2.7.3"
"portage://media-libs/fontconfig-2.17.1" -> "portage://media-libs/freetype-9999"
"portage://media-libs/fontconfig-2.17.1" -> "portage://virtual/libintl-0-r2"
"portage://dev-libs/expat-2.7.3" [color=red, penwidth=1, href="../dev-libs/expat-2.7.3-depend.svg"];
"portage://media-libs/freetype-9999" [color=red, penwidth=1, href="../media-libs/freetype-9999-depend.svg"];
