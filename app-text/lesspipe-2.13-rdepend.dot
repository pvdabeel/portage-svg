rtage://app-text/lesspipe-2.13" href="../app-text/lesspipe-2.13-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-text/lesspipe-2.13" href="../app-text/lesspipe-2.13-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-text/lesspipe-2.13" href="../app-text/lesspipe-2.13-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-text/lesspipe-2.13"[minlen=0.2, headport=n, tailport=s, style=invis];

