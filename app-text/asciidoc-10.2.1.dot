# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-text/asciidoc-10.2.1", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-text/asciidoc-10.2.1.svg"];
