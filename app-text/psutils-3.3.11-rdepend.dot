digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-text</TD><TD title="repository" href="./psutils.html">psutils</TD><TD BORDER='0'></TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11.svg">detail</TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11-bdepend.svg">bdepend</TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11-cdepend.svg">cdepend</TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11-depend.svg">depend</TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11-idepend.svg">idepend</TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11-rdepend.svg"><u>rdepend</u></TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://app-text/psutils-2.09" href="../app-text/psutils-2.09-rdepend.svg">older &gt;</TD><TD title="portage://app-text/psutils-1.17-r5" href="../app-text/psutils-1.17-r5-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11-merge.svg">--merge&nbsp;</TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-text/psutils-3.3.11" href="../app-text/psutils-3.3.11-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-text/psutils-3.3.11"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-text/psutils-3.3.11" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-text/psutils-3.3.11-rdepend.svg"];
"portage://app-text/psutils-3.3.11" -> "portage://app-text/libpaper-2.1.3"
"portage://app-text/psutils-3.3.11" -> "portage://dev-python/puremagic-1.30"
"portage://app-text/psutils-3.3.11" -> "portage://dev-python/pypdf-6.4.2"
"portage://app-text/libpaper-2.1.3" [color=red, penwidth=1, href="../app-text/libpaper-2.1.3-rdepend.svg"];
"portage://dev-python/puremagic-1.30" [color=red, penwidth=1, href="../dev-python/puremagic-1.30-rdepend.svg"];
"portage://dev-python/pypdf-6.4.2" [color=red, penwidth=1, href="../dev-python/pypdf-6.4.2-rdepend.svg"];
}
