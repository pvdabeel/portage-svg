4-r4" href="../app-text/html401-19991224-r4-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-text/html401-19991224-r4" href="../app-text/html401-19991224-r4-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-text/html401-19991224-r4" href="../app-text/html401-19991224-r4-emerge.svg">emerge</TD></TR></TABLE>>];

