digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-analyzer</TD><TD title="repository" href="./squid-graph.html">squid-graph</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2.svg">detail</TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2-bdepend.svg">bdepend</TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2-cdepend.svg">cdepend</TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2-depend.svg">depend</TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2-idepend.svg">idepend</TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2-rdepend.svg"><u>rdepend</u></TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2-merge.svg">--merge&nbsp;</TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/squid-graph-3.2-r2" href="../net-analyzer/squid-graph-3.2-r2-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-analyzer/squid-graph-3.2-r2"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-analyzer/squid-graph-3.2-r2" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-analyzer/squid-graph-3.2-r2-rdepend.svg"];
"portage://net-analyzer/squid-graph-3.2-r2" -> "portage://dev-perl/GD-2.830.0-r1"
"portage://dev-perl/GD-2.830.0-r1" [color=red, penwidth=1, href="../dev-perl/GD-2.830.0-r1-rdepend.svg"];
"portage://dev-perl/GD-2.830.0-r1" -> "portage://media-libs/gd-2.3.3-r4"
"portage://dev-perl/GD-2.830.0-r1" -> "portage://media-libs/giflib-5.2.2"
"portage://dev-perl/GD-2.830.0-r1" -> "portage://media-libs/libjpeg-turbo-3.1.3"
"portage://dev-perl/GD-2.830.0-r1" -> "portage://media-libs/libpng-1.6.53"
"portage://dev-perl/GD-2.830.0-r1" -> "portage://virtual/zlib-1.3.1-r1"
"portage://dev-perl/GD-2.830.0-r1" -> "portage://dev-lang/perl-5.42.0-r1"
"portage://dev-perl/GD-2.830.0-r1" -> "portage://dev-lang/perl-5.42.0-r1"
"portage://media-libs/gd-2.3.3-r4" [color=red, penwidth=1, href="../media-libs/gd-2.3.3-r4-rdepend.svg"];
"portage://media-libs/giflib-5.2.2" [color=red, penwidth=1, href="../media-libs/giflib-5.2.2-rdepend.svg"];
"portage://media-libs/libjpeg-turbo-3.1.3" [color=red, penwidth=1, href="../media-libs/libjpeg-turbo-3.1.3-rdepend.svg"];
"portage://media-libs/libpng-1.6.53" [color=red, penwidth=1, href="../media-libs/libpng-1.6.53-rdepend.svg"];
"portage://media-libs/libpng-1.6.53" -> "portage://virtual/zlib-1.3.1-r1"
"portage://virtual/zlib-1.3.1-r1" [color=red, penwidth=1, href="../virtual/zlib-1.3.1-r1-rdepend.svg"];
"portage://dev-lang/perl-5.42.0-r1" [color=red, penwidth=1, href="../dev-lang/perl-5.42.0-r1-rdepend.svg"];
"portage://dev-lang/perl-5.42.0-r1" -> "portage://app-arch/bzip2-9999"
"portage://dev-lang/perl-5.42.0-r1" -> "portage://virtual/zlib-1.3.1-r1"
"portage://dev-lang/perl-5.42.0-r1" -> "portage://virtual/libcrypt-2-r1"
"portage://app-arch/bzip2-9999" [color=red, penwidth=1, href="../app-arch/bzip2-9999-rdepend.svg"];
"portage://virtual/libcrypt-2-r1" [color=red, penwidth=1, href="../virtual/libcrypt-2-r1-rdepend.svg"];
}
