digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-analyzer</TD><TD title="repository" href="./ftester.html">ftester</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/ftester-1.0" href="../net-analyzer/ftester-1.0.svg">detail</TD><TD title="portage://net-analyzer/ftester-1.0" href="../net-analyzer/ftester-1.0-bdepend.svg">bdepend</TD><TD title="portage://net-analyzer/ftester-1.0" href="../net-analyzer/ftester-1.0-cdepend.svg">cdepend</TD><TD title="portage://net-analyzer/ftester-1.0" href="../net-analyzer/ftester-1.0-depend.svg">depend</TD><TD title="portage://net-analyzer/ftester-1.0" href="../net-analyzer/ftester-1.0-idepend.svg">idepend</TD><TD title="portage://net-analyzer/ftester-1.0" href="../net-analyzer/ftester-1.0-rdepend.svg"><u>rdepend</u></TD><TD title="portage://net-analyzer/ftester-1.0" href="../net-analyzer/ftester-1.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/ftester-1.0" href="../net-analyzer/ftester-1.0-merge.svg">--merge&nbsp;</TD><TD title="portage://net-analyzer/ftester-1.0" href="../net-analyzer/ftester-1.0-fetchonly.svg">--fetchon