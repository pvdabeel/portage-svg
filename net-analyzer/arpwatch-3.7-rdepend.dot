digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-analyzer</TD><TD title="repository" href="./arpwatch.html">arpwatch</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7.svg">detail</TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7-bdepend.svg">bdepend</TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7-cdepend.svg">cdepend</TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7-depend.svg">depend</TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7-idepend.svg">idepend</TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7-rdepend.svg"><u>rdepend</u></TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/arpwatch-3.8" href="../net-analyzer/arpwatch-3.8-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://net-analyzer/arpwatch-3.8" href="../net-analyzer/arpwatch-3.8-rdepend.svg">&lt; newer</TD><TD title="portage://net-analyzer/arpwatch-3.6" href="../net-analyzer/arpwatch-3.6-rdepend.svg">older &gt;</TD><TD title="portage://net-analyzer/arpwatch-3.5" href="../net-analyzer/arpwatch-3.5-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7-merge.svg">--merge&nbsp;</TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/arpwatch-3.7" href="../net-analyzer/arpwatch-3.7-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-analyzer/arpwatch-3.7"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-analyzer/arpwatch-3.7" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-analyzer/arpwatch-3.7-rdepend.svg"];
"portage://net-analyzer/arpwatch-3.7" -> "portage://acct-group/arpwatch-0-r2"
"portage://net-analyzer/arpwatch-3.7" -> "portage://net-libs/libpcap-9999"
