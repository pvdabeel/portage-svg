"portage://net-analyzer/arpwatch-3.7" -> "portage://virtual/mta-1-r2"
"portage://acct-group/arpwatch-0-r2" [color=red, penwidth=1, href="../acct-group/arpwatch-0-r2-rdepend.svg"];
"portage://net-libs/libpcap-9999" [color=red, penwidth=1, href="../net-libs/libpcap-9999-rdepend.svg"];
"portage://sys-libs/ncurses-6.5_p20250802" [color=red, penwidth=1, href="../sys-libs/ncurses-6.5_p20250802-rdepend.svg"];
