digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-analyzer</TD><TD title="repository" href="./oinkmaster.html">oinkmaster</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0.svg">detail</TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0-bdepend.svg">bdepend</TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0-cdepend.svg">cdepend</TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0-depend.svg">depend</TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0-idepend.svg">idepend</TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0-rdepend.svg"><u>rdepend</u></TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0-merge.svg">--merge&nbsp;</TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/oinkmaster-2.0" href="../net-analyzer/oinkmaster-2.0-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-analyzer/oinkmaster-2.0"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-analyzer/oinkmaster-2.0" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-analyzer/oinkmaster-2.0-rdepend.svg"];
"portage://net-analyzer/oinkmaster-2.0" -> "portage://app-arch/gzip-1.14"
"portage://net-analyzer/oinkmaster-2.0" -> "portage://app-arch/tar-1.35"
"portage://net-analyzer/oinkmaster-2.0" -> "portage://dev-lang/perl-5.42.0-r1"
"portage://net-analyzer/oinkmaster-2.0" -> "portage://net-misc/wget-1.25.0-r1"
"portage://app-arch/gzip-1.14" [color=red, penwidth=1, href="../app-arch/gzip-1.14-rdepend.svg"];
"portage://app-arch/gzip-1.14" -> "portage://app-arch/pigz-2.8" [style=dashed, color=orange];
"portage://app-arch/pigz-2.8" [color=red, penwidth=1, href="../app-arch/pigz-2.8-rdepend.svg"];
"portage://app-arch/tar-1.35" [color=red, penwidth=1, href="../app-arch/tar-1.35-rdepend.svg"];
"portage://dev-lang/perl-5.42.0-r1" [color=red, penwidth=1, href="../dev-lang/perl-5.42.0-r1-rdepend.svg"];
"portage://dev-lang/perl-5.42.0-r1" -> "portage://app-arch/bzip2-9999"
"portage://dev-lang/perl-5.42.0-r1" -> "portage://virtual/zlib-1.3.1-r1"
"portage://dev-lang/perl-5.42.0-r1" -> "portage://virtual/libcrypt-2-r1"
"portage://app-arch/bzip2-9999" [color=red, penwidth=1, href="../app-arch/bzip2-9999-rdepend.svg"];
"portage://virtual/zlib-1.3.1-r1" [color=red, penwidth=1, href="../virtual/zlib-1.3.1-r1-rdepend.svg"];
