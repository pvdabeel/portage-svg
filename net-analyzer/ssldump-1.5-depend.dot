digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-analyzer</TD><TD title="repository" href="./ssldump.html">ssldump</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5.svg">detail</TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5-bdepend.svg">bdepend</TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5-cdepend.svg">cdepend</TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5-depend.svg"><u>depend</u></TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5-idepend.svg">idepend</TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5-rdepend.svg">rdepend</TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/ssldump-1.9" href="../net-analyzer/ssldump-1.9-depend.svg">&lt;&lt; newest</TD><TD title="portage://net-analyzer/ssldump-1.8" href="../net-analyzer/ssldump-1.8-depend.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5-merge.svg">--merge&nbsp;</TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-analyzer/ssldump-1.5" href="../net-analyzer/ssldump-1.5-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-analyzer/ssldump-1.5"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-analyzer/ssldump-1.5" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-analyzer/ssldump-1.5-depend.svg"];
"portage://net-analyzer/ssldump-1.5" -> "portage://dev-libs/json-c-9999"
"portage://net-analyzer/ssldump-1.5" -> "portage://dev-libs/openssl-3.6.9999"
"portage://net-analyzer/ssldump-1.5" -> "portage://net-libs/libnet-1.3-r1"
"portage://net-analyzer/ssldump-1.5" -> "portage://net-libs/libpcap-9999"
"portage://dev-libs/json-c-9999" [color=red, penwidth=1, href="../dev-libs/json-c-9999-depend.svg"];
"portage://dev-libs/openssl-3.6.9999" [color=red, penwidth=1, href="../dev-libs/openssl-3.6.9999-depend.svg"];
"portage://net-libs/libnet-1.3-r1" [color=red, penwidth=1, href="../net-libs/libnet-1.3-r1-depend.svg"];
"portage://net-libs/libpcap-9999" [color=red, penwidth=1, href="../net-libs/libpcap-9999-depend.svg"];
}
