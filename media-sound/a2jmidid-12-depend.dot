digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-sound</TD><TD title="repository" href="./a2jmidid.html">a2jmidid</TD><TD BORDER='0'></TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12.svg">detail</TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12-bdepend.svg">bdepend</TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12-cdepend.svg">cdepend</TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12-depend.svg"><u>depend</u></TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12-idepend.svg">idepend</TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12-rdepend.svg">rdepend</TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://media-sound/a2jmidid-9999" href="../media-sound/a2jmidid-9999-depend.svg">&lt;&lt; newest</TD><TD title="portage://media-sound/a2jmidid-9999" href="../media-sound/a2jmidid-9999-depend.svg">&lt; newer</TD><TD title="portage://media-sound/a2jmidid-9-r1" href="../media-sound/a2jmidid-9-r1-depend.svg">older &gt;</TD><TD title="portage://media-sound/a2jmidid-9-r1" href="../media-sound/a2jmidid-9-r1-depend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12-merge.svg">--merge&nbsp;</TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-sound/a2jmidid-12" href="../media-sound/a2jmidid-12-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://media-sound/a2jmidid-12"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://media-sound/a2jmidid-12" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../media-sound/a2jmidid-12-depend.svg"];
"portage://media-sound/a2jmidid-12" -> "portage://media-libs/alsa-lib-1.2.15-r3"
"portage://media-sound/a2jmidid-12" -> "portage://virtual/jack-2"
"portage://media-libs/alsa-lib-1.2.15-r3" [color=red, penwidth=1, href="../media-libs/alsa-lib-1.2.15-r3-depend.svg"];
"portage://media-libs/alsa-lib-1.2.15-r3" -> "portage://media-libs/alsa-topology-conf-1.2.5.1"
"portage://media-libs/alsa-lib-1.2.15-r3" -> "portage://media-libs/alsa-ucm-conf-1.2.15"
"portage://media-libs/alsa-topology-conf-1.2.5.1" [color=red, penwidth=1, href="../media-libs/alsa-topology-conf-1.2.5.1-depend.svg"];
"portage://media-libs/alsa-ucm-conf-1.2.15" [color=red, penwidth=1, href="../media-libs/alsa-ucm-conf-1.2.15-depend.svg"];
"portage://virtual/jack-2" [color=red, penwidth=1, href="../virtual/jack-2-depend.svg"];
}
