# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"media-libs/libpulse-17.0" [label="portage://media-libs/libpulse-17.0", color=red, width=4,href="../media-libs/libpulse-17.0.svg"];
package_dependency1:e -> "media-libs/libpulse-17.0":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"media-sound/pulseaudio-daemon-17.0-r1" [label="portage://media-sound/pulseaudio-daemon-17.0-r1", color=red, width=4,href="../media-sound/pulseaudio-daemon-17.0-r1.svg"];
package_dependency2:e -> "media-sound/pulseaudio-daemon-17.0-r1":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
}
}
}
