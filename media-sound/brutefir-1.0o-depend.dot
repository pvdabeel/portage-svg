"portage://media-libs/alsa-lib-1.2.15-r3" [color=red, penwidth=1, href="../media-libs/alsa-lib-1.2.15-r3-depend.svg"];
"portage://media-libs/alsa-lib-1.2.15-r3" -> "portage://media-libs/alsa-topology-conf-1.2.5.1"
"portage://media-libs/alsa-lib-1.2.15-r3" -> "portage://media-libs/alsa-ucm-conf-1.2.15"
"portage://media-libs/alsa-topology-conf-1.2.5.1" [color=red, penwidth=1, href="../media-libs/alsa-topology-conf-1.2.5.1-depend.svg"];
"portage://media-libs/alsa-ucm-conf-1.2.15" [color=red, penwidth=1, href="../media-libs/alsa-ucm-conf-1.2.15-depend.svg"];
"portage://sci-libs/fftw-9999" [color=red, penwidth=1, href="../sci-libs/fftw-9999-depend.svg"];
