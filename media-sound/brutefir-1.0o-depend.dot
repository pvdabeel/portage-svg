digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-sound</TD><TD title="repository" href="./brutefir.html">brutefir</TD><TD BORDER='0'></TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o.svg">detail</TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o-bdepend.svg">bdepend</TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o-cdepend.svg">cdepend</TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o-depend.svg"><u>depend</u></TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o-idepend.svg">idepend</TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o-rdepend.svg">rdepend</TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o-merge.svg">--merge&nbsp;</TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-sound/brutefir-1.0o" href="../media-sound/brutefir-1.0o-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://media-sound/brutefir-1.0o"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://media-sound/brutefir-1.0o" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../media-sound/brutefir-1.0o-depend.svg"];
"portage://media-sound/brutefir-1.0o" -> "portage://media-libs/alsa-lib-1.2.15-r3"
"portage://media-sound/brutefir-1.0o" -> "portage://sci-libs/fftw-9999"
