D title="portage://media-sound/streamtranscoder-3.1.11-r2" href="../media-sound/streamtranscoder-3.1.11-r2-merge.svg">--merge&nbsp;</TD><TD title="portage://media-sound/streamtranscoder-3.1.11-r2" href="../media-sound/streamtranscoder-3.1.11-r2-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-sound/streamtranscoder-3.1.11-r2" href="../media-sound/streamtranscoder-3.1.11-r2-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-sound/streamtranscoder-3.1.11-r2" href="../media-sound/streamtranscoder-3.1.11-r2-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://media-sound/streamtranscoder-3.1.11-r2"[minlen=0.2, headport=n, tailport=s, style=invis];

