digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-sound</TD><TD title="repository" href="./id3tool.html">id3tool</TD><TD BORDER='0'></TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a.svg">detail</TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a-bdepend.svg">bdepend</TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a-cdepend.svg">cdepend</TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a-depend.svg"><u>depend</u></TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a-idepend.svg">idepend</TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a-rdepend.svg">rdepend</TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://media-sound/id3tool-1.2a-r1" href="../media-sound/id3tool-1.2a-r1-depend.svg">&lt;&lt; newest</TD><TD title="portage://media-sound/id3tool-1.2a-r1" href="../media-sound/id3tool-1.2a-r1-depend.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a-merge.svg">--merge&nbsp;</TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-sound/id3tool-1.2a" href="../media-sound/id3tool-1.2a-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://media-sound/id3tool-1.2a"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://media-sound/id3tool-1.2a" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../media-sound/id3tool-1.2a-depend.svg"];
}
