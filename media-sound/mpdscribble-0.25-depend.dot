digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-sound</TD><TD title="repository" href="./mpdscribble.html">mpdscribble</TD><TD BORDER='0'></TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25.svg">detail</TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25-bdepend.svg">bdepend</TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25-cdepend.svg">cdepend</TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25-depend.svg"><u>depend</u></TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25-idepend.svg">idepend</TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25-rdepend.svg">rdepend</TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25-merge.svg">--merge&nbsp;</TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-sound/mpdscribble-0.25" href="../media-sound/mpdscribble-0.25-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://media-sound/mpdscribble-0.25"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://media-sound/mpdscribble-0.25" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../media-sound/mpdscribble-0.25-depend.svg"];
"portage://media-sound/mpdscribble-0.25" -> "portage://dev-libs/boost-1.89.0"
"portage://media-sound/mpdscribble-0.25" -> "portage://dev-libs/libgcrypt-1.11.2"
"portage://media-sound/mpdscribble-0.25" -> "portage://media-libs/libmpdclient-2.23-r1"
"portage://media-sound/mpdscribble-0.25" -> "portage://net-misc/curl-9999"
"portage://dev-libs/boost-1.89.0" [color=red, penwidth=1, href="../dev-libs/boost-1.89.0-depend.svg"];
"portage://dev-libs/libgcrypt-1.11.2" [color=red, penwidth=1, href="../dev-libs/libgcrypt-1.11.2-depend.svg"];
"portage://dev-libs/libgcrypt-1.11.2" -> "portage://dev-libs/libgpg-error-1.57"
"portage://dev-libs/libgpg-error-1.57" [color=red, penwidth=1, href="../dev-libs/libgpg-error-1.57-depend.svg"];
"portage://media-libs/libmpdclient-2.23-r1" [color=red, penwidth=1, href="../media-libs/libmpdclient-2.23-r1-depend.svg"];
"portage://net-misc/curl-9999" [color=red, penwidth=1, href="../net-misc/curl-9999-depend.svg"];
"portage://net-misc/curl-9999" -> "portage://virtual/zlib-1.3.1-r1"
"portage://virtual/zlib-1.3.1-r1" [color=red, penwidth=1, href="../virtual/zlib-1.3.1-r1-depend.svg"];
}
