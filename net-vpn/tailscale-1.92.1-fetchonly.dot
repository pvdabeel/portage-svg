digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-vpn</TD><TD title="repository" href="./tailscale.html">tailscale</TD><TD BORDER='0'></TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1.svg">detail</TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1-bdepend.svg">bdepend</TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1-cdepend.svg">cdepend</TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1-depend.svg">depend</TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1-idepend.svg">idepend</TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1-rdepend.svg">rdepend</TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://net-vpn/tailscale-1.90.6" href="../net-vpn/tailscale-1.90.6-fetchonly.svg">older &gt;</TD><TD title="portage://net-vpn/tailscale-1.82.5" href="../net-vpn/tailscale-1.82.5-fetchonly.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1-merge.svg">--merge&nbsp;</TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1-fetchonly.svg">--<u>fetchonly</u>&nbsp;</TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-vpn/tailscale-1.92.1" href="../net-vpn/tailscale-1.92.1-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
