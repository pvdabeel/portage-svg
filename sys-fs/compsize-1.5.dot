digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-fs</TD><TD title="repository" href="./compsize.html">compsize</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5.svg"><u>detail</u></TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5-bdepend.svg">bdepend</TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5-cdepend.svg">cdepend</TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5-depend.svg">depend</TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5-idepend.svg">idepend</TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5-rdepend.svg">rdepend</TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/compsize-9999" href="../sys-fs/compsize-9999.svg">&lt;&lt; newest</TD><TD title="portage://sys-fs/compsize-9999" href="../sys-fs/compsize-9999.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/compsize-1.5" href="../sys-fs/compsize-1.5-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://sys-fs/compsize-1.5", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../sys-fs/compsize-1.5.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>sys-fs</TD></TR><TR><TD>btrfs-progs</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

