digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-fs</TD><TD title="repository" href="./genfstab.html">genfstab</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29.svg"><u>detail</u></TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29-bdepend.svg">bdepend</TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29-cdepend.svg">cdepend</TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29-depend.svg">depend</TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29-idepend.svg">idepend</TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29-rdepend.svg">rdepend</TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://sys-fs/genfstab-28-r1" href="../sys-fs/genfstab-28-r1.svg">older &gt;</TD><TD title="portage://sys-fs/genfstab-28-r1" href="../sys-fs/genfstab-28-r1.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/genfstab-29" href="../sys-fs/genfstab-29-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://sys-fs/genfstab-29", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../sys-fs/genfstab-29.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>app-alternatives</TD></TR><TR><TD>awk</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>app-text</TD></TR><TR><TD>asciidoc</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency2:w [weight=20, style="solid",arrowhead="vee"];
subgraph  {
package_dependency3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>sys-devel</TD></TR><TR><TD>m4</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency3:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"app-alternatives/awk-4" [label="portage://app-alternatives/awk-4", color=red, width=4,href="../app-alternatives/awk-4.svg"];
"app-alternatives/awk-4" [label="pkg://app-alternatives/awk-4", color=red, width=4,href="../app-alternatives/awk-4.svg"];
package_dependency1:e -> "app-alternatives/awk-4":w [style=dotted,weight="100"];
package_dependency1:e -> "app-alternatives/awk-4":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"app-text/asciidoc-10.2.1" [label="portage://app-text/asciidoc-10.2.1", color=red, width=4,href="../app-text/asciidoc-10.2.1.svg"];
package_dependency2:e -> "app-text/asciidoc-10.2.1":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"sys-devel/m4-1.4.20" [label="portage://sys-devel/m4-1.4.20", color=red, width=4,href="../sys-devel/m4-1.4.20.svg"];
"sys-devel/m4-1.4.19-r2" [label="portage://sys-devel/m4-1.4.19-r2", color=red, width=4,href="../sys-devel/m4-1.4.19-r2.svg"];
"sys-devel/m4-1.4.20" [label="pkg://sys-devel/m4-1.4.20", color=red, width=4,href="../sys-devel/m4-1.4.20.svg"];
package_dependency3:e -> "sys-devel/m4-1.4.20":w [style=dotted,weight="100"];
package_dependency3:e -> "sys-devel/m4-1.4.19-r2":w [style=dotted,weight="100"];
package_dependency3:e -> "sys-devel/m4-1.4.20":w [style=dotted,weight="100"];
}
}
}
