graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-fs</TD><TD title="repository" href="./bees.html">bees</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/bees-0.11" href="../sys-fs/bees-0.11.svg"><u>detail</u></TD><TD title="portage://sys-fs/bees-0.11" href="../sys-fs/bees-0.11-bdepend.svg">bdepend</TD><TD title="portage://sys-fs/bees-0.11" href="../sys-fs/bees-0.11-cdepend.svg">cdepend</TD><TD title="portage://sys-fs/bees-0.11" href="../sys-fs/bees-0.11-depend.svg">depend</TD><TD title="portage://sys-fs/bees-0.11" href="../sys-fs/bees-0.11-idepend.svg">idepend</TD><TD title="portage://sys-fs/bees-0.11" href="../sys-fs/bees-0.11-rdepend.svg">rdepend</TD><TD title="portage://sys-fs/bees-0.11" href="../sys-fs/bees-0.11-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/bees-9999" href="../sys-fs/bees-9999.svg">&lt;&lt; newest</TD><TD title="portage://sys-fs/bees-9999" href="../sys-fs/bees-9999.svg">&lt; newer</TD><TD title="portage://sys-fs/bees-0.10-r1" href="../sys-fs/bees-0.10-r1.svg">older &gt;</TD><TD title="portage://sys-fs/bees-0.10-r1" href="../sys-fs/bees-0.10-r1.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/bees-0.11" href="../sys-fs/bees-0.11-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-fs/bees-0.11" href="../sys-fs/bees-0.11-fetchonl