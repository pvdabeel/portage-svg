digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-fs</TD><TD title="repository" href="./xfsprogs.html">xfsprogs</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0.svg">detail</TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0-bdepend.svg">bdepend</TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0-cdepend.svg">cdepend</TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0-depend.svg">depend</TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0-idepend.svg">idepend</TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0-rdepend.svg">rdepend</TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/xfsprogs-6.17.0-r1" href="../sys-fs/xfsprogs-6.17.0-r1-info.svg">&lt;&lt; newest</TD><TD title="portage://sys-fs/xfsprogs-6.15.0" href="../sys-fs/xfsprogs-6.15.0-info.svg">&lt; newer</TD><TD title="portage://sys-fs/xfsprogs-6.13.0-r1" href="../sys-fs/xfsprogs-6.13.0-r1-info.svg">older &gt;</TD><TD title="portage://sys-fs/xfsprogs-6.12.0" href="../sys-fs/xfsprogs-6.12.0-info.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0-info.svg">--<u>info</u>&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-fs/xfsprogs-6.14.0" href="../sys-fs/xfsprogs-6.14.0-emerge.svg">emerge</TD></TR></TABLE>>];

