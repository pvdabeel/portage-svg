digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-vcs</TD><TD title="repository" href="./sourcegit.html">sourcegit</TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34.svg">detail</TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34-bdepend.svg">bdepend</TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34-cdepend.svg">cdepend</TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34-depend.svg">depend</TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34-idepend.svg">idepend</TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34-rdepend.svg">rdepend</TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/sourcegit-9999" href="../dev-vcs/sourcegit-9999-info.svg">&lt;&lt; newest</TD><TD title="portage://dev-vcs/sourcegit-2025.35" href="../dev-vcs/sourcegit-2025.35-info.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34-info.svg">--<u>info</u>&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/sourcegit-2025.34" href="../dev-vcs/sourcegit-2025.34-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
