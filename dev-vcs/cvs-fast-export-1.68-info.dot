digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-vcs</TD><TD title="repository" href="./cvs-fast-export.html">cvs-fast-export</TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68.svg">detail</TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68-bdepend.svg">bdepend</TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68-cdepend.svg">cdepend</TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68-depend.svg">depend</TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68-idepend.svg">idepend</TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68-rdepend.svg">rdepend</TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://dev-vcs/cvs-fast-export-1.67" href="../dev-vcs/cvs-fast-export-1.67-info.svg">older &gt;</TD><TD title="portage://dev-vcs/cvs-fast-export-1.61" href="../dev-vcs/cvs-fast-export-1.61-info.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68-info.svg">--<u>info</u>&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/cvs-fast-export-1.68" href="../dev-vcs/cvs-fast-export-1.68-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
