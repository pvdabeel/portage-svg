digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-vcs</TD><TD title="repository" href="./git-crypt.html">git-crypt</TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0.svg">detail</TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0-bdepend.svg">bdepend</TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0-cdepend.svg">cdepend</TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0-depend.svg">depend</TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0-idepend.svg">idepend</TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0-rdepend.svg">rdepend</TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/git-crypt-0.8.0" href="../dev-vcs/git-crypt-0.8.0-emerge.svg">&lt;&lt; newest</TD><TD title="portage://dev-vcs/git-crypt-0.8.0" href="../dev-vcs/git-crypt-0.8.0-emerge.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-vcs/git-crypt-0.7.0" href="../dev-vcs/git-crypt-0.7.0-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
