fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://net-ftp/lftp-9999", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../net-ftp/lftp-9999.svg"];
}

