digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-doc</TD><TD title="repository" href="./gnucash-docs.html">gnucash-docs</TD><TD BORDER='0'></TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12.svg"><u>detail</u></TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12-bdepend.svg">bdepend</TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12-cdepend.svg">cdepend</TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12-depend.svg">depend</TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12-idepend.svg">idepend</TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12-rdepend.svg">rdepend</TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://app-doc/gnucash-docs-5.11" href="../app-doc/gnucash-docs-5.11.svg">older &gt;</TD><TD title="portage://app-doc/gnucash-docs-5.10" href="../app-doc/gnucash-docs-5.10.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12-merge.svg">--merge&nbsp;</TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-doc/gnucash-docs-5.12" href="../app-doc/gnucash-docs-5.12-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-doc/gnucash-docs-5.12", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-doc/gnucash-docs-5.12.svg"];
}

