digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-doc</TD><TD title="repository" href="./single-unix-specification.html">single-unix-specification</TD><TD BORDER='0'></TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018.svg"><u>detail</u></TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018-bdepend.svg">bdepend</TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018-cdepend.svg">cdepend</TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018-depend.svg">depend</TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018-idepend.svg">idepend</TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018-rdepend.svg">rdepend</TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-doc/single-unix-specification-5-r2" href="../app-doc/single-unix-specification-5-r2.svg">&lt;&lt; newest</TD><TD title="portage://app-doc/single-unix-specification-5-r2" href="../app-doc/single-unix-specification-5-r2.svg">&lt; newer</TD><TD title="portage://app-doc/single-unix-specification-4_p2" href="../app-doc/single-unix-specification-4_p2.svg">older &gt;</TD><TD title="portage://app-doc/single-unix-specification-4_p2" href="../app-doc/single-unix-specification-4_p2.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018-merge.svg">--merge&nbsp;</TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-doc/single-unix-specification-4_p2018" href="../app-doc/single-unix-specification-4_p2018-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-doc/single-unix-specification-4_p2018", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-doc/single-unix-specification-4_p2018.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

}
}
