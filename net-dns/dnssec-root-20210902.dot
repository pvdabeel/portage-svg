digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-dns</TD><TD title="repository" href="./dnssec-root.html">dnssec-root</TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902.svg"><u>detail</u></TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902-bdepend.svg">bdepend</TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902-cdepend.svg">cdepend</TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902-depend.svg">depend</TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902-idepend.svg">idepend</TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902-rdepend.svg">rdepend</TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902-merge.svg">--merge&nbsp;</TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnssec-root-20210902" href="../net-dns/dnssec-root-20210902-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://net-dns/dnssec-root-20210902", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../net-dns/dnssec-root-20210902.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>dev-perl</TD></TR><TR><TD>XML-XPath</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[1,420,0],,,1.420.0]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"dev-perl/XML-XPath-1.480.0" [label="portage://dev-perl/XML-XPath-1.480.0", color=red, width=4,href="../dev-perl/XML-XPath-1.480.0.svg"];
package_dependency1:e -> "dev-perl/XML-XPath-1.480.0":w [style=dotted,weight="100"];
}
}
}
