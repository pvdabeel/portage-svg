digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-dns</TD><TD title="repository" href="./dnsdist.html">dnsdist</TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1.svg">detail</TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-bdepend.svg">bdepend</TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-cdepend.svg">cdepend</TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-depend.svg">depend</TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-idepend.svg">idepend</TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-rdepend.svg"><u>rdepend</u></TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnsdist-9999" href="../net-dns/dnsdist-9999-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://net-dns/dnsdist-2.0.2" href="../net-dns/dnsdist-2.0.2-rdepend.svg">&lt; newer</TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-rdepend.svg">older &gt;</TD><TD title="portage://net-dns/dnsdist-1.9.10" href="../net-dns/dnsdist-1.9.10-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-merge.svg">--merge&nbsp;</TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-dns/dnsdist-2.0.1"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-dns/dnsdist-2.0.1" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-dns/dnsdist-2.0.1-rdepend.svg"];
