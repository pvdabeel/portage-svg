"portage://net-dns/dnsdist-2.0.1" -> "portage://acct-user/dnsdist-0-r3"
"portage://net-dns/dnsdist-2.0.1" -> "portage://dev-libs/boost-1.89.0"
"portage://net-dns/dnsdist-2.0.1" -> "portage://sys-libs/libcap-9999"
"portage://net-dns/dnsdist-2.0.1" -> "portage://dev-libs/libedit-20240808.3.1"
"portage://net-dns/dnsdist-2.0.1" -> "portage://dev-libs/libsodium-1.0.20_p20250606"
"portage://acct-group/dnsdist-0-r3" [color=red, penwidth=1, href="../acct-group/dnsdist-0-r3-rdepend.svg"];
"portage://acct-user/dnsdist-0-r3" [color=red, penwidth=1, href="../acct-user/dnsdist-0-r3-rdepend.svg"];
