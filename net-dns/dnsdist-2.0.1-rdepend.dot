"portage://sys-libs/libcap-9999" [color=red, penwidth=1, href="../sys-libs/libcap-9999-rdepend.svg"];
"portage://dev-libs/libedit-20240808.3.1" [color=red, penwidth=1, href="../dev-libs/libedit-20240808.3.1-rdepend.svg"];
"portage://dev-libs/libedit-20240808.3.1" -> "portage://sys-libs/ncurses-6.5_p20250802"
"portage://sys-libs/ncurses-6.5_p20250802" [color=red, penwidth=1, href="../sys-libs/ncurses-6.5_p20250802-rdepend.svg"];
"portage://dev-libs/libsodium-1.0.20_p20250606" [color=red, penwidth=1, href="../dev-libs/libsodium-1.0.20_p20250606-rdepend.svg"];
