digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-dns</TD><TD title="repository" href="./dnsdist.html">dnsdist</TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11.svg">detail</TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-bdepend.svg">bdepend</TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-cdepend.svg">cdepend</TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-depend.svg">depend</TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-idepend.svg">idepend</TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-rdepend.svg">rdepend</TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-pdepend.svg"><u>pdepend</u></TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnsdist-9999" href="../net-dns/dnsdist-9999-pdepend.svg">&lt;&lt; newest</TD><TD title="portage://net-dns/dnsdist-2.0.1" href="../net-dns/dnsdist-2.0.1-pdepend.svg">&lt; newer</TD><TD title="portage://net-dns/dnsdist-1.9.10" href="../net-dns/dnsdist-1.9.10-pdepend.svg">older &gt;</TD><TD title="portage://net-dns/dnsdist-1.9.10" href="../net-dns/dnsdist-1.9.10-pdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-merge.svg">--merge&nbsp;</TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-dns/dnsdist-1.9.11" href="../net-dns/dnsdist-1.9.11-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-dns/dnsdist-1.9.11"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-dns/dnsdist-1.9.11" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-dns/dnsdist-1.9.11-pdepend.svg"];
}
