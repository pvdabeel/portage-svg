digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-dns</TD><TD title="repository" href="./pdns.html">pdns</TD><TD BORDER='0'></TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1.svg">detail</TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1-bdepend.svg">bdepend</TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1-cdepend.svg">cdepend</TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1-depend.svg"><u>depend</u></TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1-idepend.svg">idepend</TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1-rdepend.svg">rdepend</TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-dns/pdns-5.0.2" href="../net-dns/pdns-5.0.2-depend.svg">&lt;&lt; newest</TD><TD title="portage://net-dns/pdns-5.0.2" href="../net-dns/pdns-5.0.2-depend.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1-merge.svg">--merge&nbsp;</TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-dns/pdns-5.0.1" href="../net-dns/pdns-5.0.1-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-dns/pdns-5.0.1"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-dns/pdns-5.0.1" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-dns/pdns-5.0.1-depend.svg"];
"portage://net-dns/pdns-5.0.1" -> "portage://dev-libs/openssl-3.6.9999"
"portage://net-dns/pdns-5.0.1" -> "portage://dev-libs/boost-1.89.0"
"portage://dev-libs/openssl-3.6.9999" [color=red, penwidth=1, href="../dev-libs/openssl-3.6.9999-depend.svg"];
"portage://dev-libs/boost-1.89.0" [color=red, penwidth=1, href="../dev-libs/boost-1.89.0-depend.svg"];
}
