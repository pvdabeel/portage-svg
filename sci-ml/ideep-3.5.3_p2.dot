digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sci-ml</TD><TD title="repository" href="./ideep.html">ideep</TD><TD BORDER='0'></TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2.svg"><u>detail</u></TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2-bdepend.svg">bdepend</TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2-cdepend.svg">cdepend</TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2-depend.svg">depend</TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2-idepend.svg">idepend</TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2-rdepend.svg">rdepend</TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sci-ml/ideep-3.5.3_p3" href="../sci-ml/ideep-3.5.3_p3.svg">&lt;&lt; newest</TD><TD title="portage://sci-ml/ideep-3.5.3_p3" href="../sci-ml/ideep-3.5.3_p3.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2-merge.svg">--merge&nbsp;</TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sci-ml/ideep-3.5.3_p2" href="../sci-ml/ideep-3.5.3_p2-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://sci-ml/ideep-3.5.3_p2", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../sci-ml/ideep-3.5.3_p2.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

}
}
