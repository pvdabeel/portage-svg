"dev-perl/TermReadKey-2.380.0-r1" [label="pkg://dev-perl/TermReadKey-2.380.0-r1", color=red, width=4,href="../dev-perl/TermReadKey-2.380.0-r1.svg"];
package_dependency3:e -> "dev-perl/TermReadKey-2.380.0-r1":w [style=dotted,weight="100"];
package_dependency3:e -> "dev-perl/TermReadKey-2.380.0-r1":w [style=dotted,weight="100"];
}
}
}
