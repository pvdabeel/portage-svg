digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-xemacs</TD><TD title="repository" href="./guided-tour.html">guided-tour</TD><TD BORDER='0'></TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54.svg"><u>detail</u></TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54-bdepend.svg">bdepend</TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54-cdepend.svg">cdepend</TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54-depend.svg">depend</TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54-idepend.svg">idepend</TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54-rdepend.svg">rdepend</TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54-merge.svg">--merge&nbsp;</TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-xemacs/guided-tour-0.54" href="../app-xemacs/guided-tour-0.54-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-xemacs/guided-tour-0.54", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-xemacs/guided-tour-0.54.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>app-editors</TD></TR><TR><TD>xemacs</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="odot"];
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"app-editors/xemacs-21.5.9999" [label="portage://app-editors/xemacs-21.5.9999", color=red, width=4,href="../app-editors/xemacs-21.5.9999.svg"];
"app-editors/xemacs-21.5.36-r5" [label="portage://app-editors/xemacs-21.5.36-r5", color=red, width=4,href="../app-editors/xemacs-21.5.36-r5.svg"];
"app-editors/xemacs-21.5.36-r3" [label="portage://app-editors/xemacs-21.5.36-r3", color=red, width=4,href="../app-editors/xemacs-21.5.36-r3.svg"];
package_dependency1:e -> "app-editors/xemacs-21.5.9999":w [style=dotted,weight="100"];
package_dependency1:e -> "app-editors/xemacs-21.5.36-r5":w [style=dotted,weight="100"];
package_dependency1:e -> "app-editors/xemacs-21.5.36-r3":w [style=dotted,weight="100"];
}
}
}
