etchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-vim/extra-syntax-4-r3" href="../app-vim/extra-syntax-4-r3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-vim/extra-syntax-4-r3" href="../app-vim/extra-syntax-4-r3-emerge.svg">emerge</TD></TR></TABLE>>];

