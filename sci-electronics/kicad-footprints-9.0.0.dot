digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sci-electronics</TD><TD title="repository" href="./kicad-footprints.html">kicad-footprints</TD><TD BORDER='0'></TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0.svg"><u>detail</u></TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0-bdepend.svg">bdepend</TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0-cdepend.svg">cdepend</TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0-depend.svg">depend</TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0-idepend.svg">idepend</TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0-rdepend.svg">rdepend</TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sci-electronics/kicad-footprints-9999" href="../sci-electronics/kicad-footprints-9999.svg">&lt;&lt; newest</TD><TD title="portage://sci-electronics/kicad-footprints-9.0.5" href="../sci-electronics/kicad-footprints-9.0.5.svg">&lt; newer</TD><TD title="portage://sci-electronics/kicad-footprints-8.0.9" href="../sci-electronics/kicad-footprints-8.0.9.svg">older &gt;</TD><TD title="portage://sci-electronics/kicad-footprints-8.0.9" href="../sci-electronics/kicad-footprints-8.0.9.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0-merge.svg">--merge&nbsp;</TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sci-electronics/kicad-footprints-9.0.0" href="../sci-electronics/kicad-footprints-9.0.0-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://sci-electronics/kicad-footprints-9.0.0", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../sci-electronics/kicad-footprints-9.0.0.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>app-alternatives</TD></TR><TR><TD>ninja</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>dev-build</TD></TR><TR><TD>cmake</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[3,28,5],,,3.28.5]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency2:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
package_dependency3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>sci-electronics</TD></TR><TR><TD>kicad</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[8,0,0],,,8.0.0]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency3:w [weight=20, style="solid",arrowhead="odot"];
}
}

