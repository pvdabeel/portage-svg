"portage://dev-build/cmake-4.1.4" -> "portage://dev-libs/libuv-9999"
"portage://dev-build/cmake-4.1.4" -> "portage://net-misc/curl-9999"
"portage://dev-build/cmake-4.1.4" -> "portage://virtual/zlib-1.3.1-r1"
"portage://dev-build/cmake-4.1.4" -> "portage://virtual/pkgconfig-3"
"portage://app-arch/libarchive-3.8.4" [color=red, penwidth=1, href="../app-arch/libarchive-3.8.4-rdepend.svg"];
