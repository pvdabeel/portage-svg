digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-build</TD><TD title="repository" href="./cmake.html">cmake</TD><TD BORDER='0'></TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4.svg">detail</TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4-bdepend.svg">bdepend</TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4-cdepend.svg">cdepend</TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4-depend.svg">depend</TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4-idepend.svg">idepend</TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4-rdepend.svg"><u>rdepend</u></TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-build/cmake-9999" href="../dev-build/cmake-9999-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://dev-build/cmake-4.2.1" href="../dev-build/cmake-4.2.1-rdepend.svg">&lt; newer</TD><TD title="portage://dev-build/cmake-4.1.3" href="../dev-build/cmake-4.1.3-rdepend.svg">older &gt;</TD><TD title="portage://dev-build/cmake-3.31.9-r1" href="../dev-build/cmake-3.31.9-r1-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-build/cmake-4.1.4" href="../dev-build/cmake-4.1.4-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://dev-build/cmake-4.1.4"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://dev-build/cmake-4.1.4" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../dev-build/cmake-4.1.4-rdepend.svg"];
