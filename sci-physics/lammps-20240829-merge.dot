graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sci-physics</TD><TD title="repository" href="./lammps.html">lammps</TD><TD BORDER='0'></TD><TD title="portage://sci-physics/lammps-20240829" href="../sci-physics/lammps-20240829.svg">detail</TD><TD title="portage://sci-physics/lammps-20240829" href="../sci-physics/lammps-20240829-bdepend.svg">bdepend</TD><TD title="portage://sci-physics/lammps-20240829" href="../sci-physics/lammps-20240829-cdepend.svg">cdepend</TD><TD title="portage://sci-physics/lammps-20240829" href="../sci-physics/lammps-20240829-depend.svg">depend</TD><TD title="portage://sci-physics/lammps-20240829" href="../sci-physics/lammps-20240829-idepend.svg">idepend</TD><TD title="portage://sci-physics/lammps-20240829" href="../sci-physics/lammps-20240829-rdepend.svg">rdepend</TD><TD title="portage://sci-physics/lammps-20240829" href="../sci-physics/lammps-20240829-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://sci-physics/lammps-20230802-r1" href="../sci-physics/lammps-20230802-r1-merge.svg">older &gt;</TD><TD title="portage://sci-physics/lammps-20230802" href="../sci-physics/lammps-20230802-merge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sci-physics/lammps-2