# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://dev-debug/systemtap-9999", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../dev-debug/systemtap-9999.svg"];
}

