subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"kde-plasma/breeze-grub-6.5.4" [label="portage://kde-plasma/breeze-grub-6.5.4", color=red, width=4,href="../kde-plasma/breeze-grub-6.5.4.svg"];
"kde-plasma/breeze-grub-6.4.5" [label="portage://kde-plasma/breeze-grub-6.4.5", color=red, width=4,href="../kde-plasma/breeze-grub-6.4.5.svg"];
weak_blocker1:e -> "kde-plasma/breeze-grub-6.5.4":w [style=dotted,weight="100"];
weak_blocker1:e -> "kde-plasma/breeze-grub-6.4.5":w [style=dotted,weight="100"];
}
}
}
