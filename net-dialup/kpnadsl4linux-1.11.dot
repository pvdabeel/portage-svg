subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"net-dialup/ppp-2.5.2" [label="portage://net-dialup/ppp-2.5.2", color=red, width=4,href="../net-dialup/ppp-2.5.2.svg"];
"net-dialup/ppp-2.5.1-r1" [label="portage://net-dialup/ppp-2.5.1-r1", color=red, width=4,href="../net-dialup/ppp-2.5.1-r1.svg"];
"net-dialup/ppp-2.5.0-r7" [label="portage://net-dialup/ppp-2.5.0-r7", color=red, width=4,href="../net-dialup/ppp-2.5.0-r7.svg"];
package_dependency1:e -> "net-dialup/ppp-2.5.2":w [style=dotted,weight="100"];
package_dependency1:e -> "net-dialup/ppp-2.5.1-r1":w [style=dotted,weight="100"];
package_dependency1:e -> "net-dialup/ppp-2.5.0-r7":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"net-dialup/pptpclient-1.10.0" [label="portage://net-dialup/pptpclient-1.10.0", color=red, width=4,href="../net-dialup/pptpclient-1.10.0.svg"];
