# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://games-engines/scummvm-9999", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../games-engines/scummvm-9999.svg"];
