digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">x11-misc</TD><TD title="repository" href="./dunst.html">dunst</TD><TD BORDER='0'></TD><TD title="portage://x11-misc/dunst-1.13.0-r1" href="../x11-misc/dunst-1.13.0-r1.svg"><u>detail</u></TD><TD title="portage://x11-misc/dunst-1.13.0-r1" href="../x11-misc/dunst-1.13.0-r1-bdepend.svg">bdepend</TD><TD title="portage://x11-misc/dunst-1.13.0-r1" href="../x11-misc/dunst-1.13.0-r1-cdepend.svg">cdepend</TD><TD title="portage://x11-misc/dunst-1.13.0-r1" href="../x11-misc/dunst-1.13.0-r1-depend.svg">depend</TD><TD title="portage://x11-misc/dunst-1.13.0-r1" href="../x11-misc/dunst-1.13.0-r1-idepend.svg">idepend</TD><TD title="portage://x11-misc/dunst-1.13.0-r1" href="../x11-misc/dunst-1.13.0-r1-rdepend.svg">rdepend</TD><TD title="portage://x11-misc/dunst-1.13.0-r1" href="../x11-misc/dunst-1.13.0-r1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://x11-misc/dunst-9999" href="../x11-misc/dunst-9999.svg">&lt;&lt; newest</TD><TD title="portage://x11-misc/dunst-9999" href="../x11-misc/dunst-9999.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://x11-misc/dunst-1.13.0-r1" href="../x11-misc/dunst-1.13.0-r1-merge.svg">--merge&nbsp;</TD><TD title="portage://