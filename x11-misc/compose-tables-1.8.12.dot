digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">x11-misc</TD><TD title="repository" href="./compose-tables.html">compose-tables</TD><TD BORDER='0'></TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12.svg"><u>detail</u></TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12-bdepend.svg">bdepend</TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12-cdepend.svg">cdepend</TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12-depend.svg">depend</TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12-idepend.svg">idepend</TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12-rdepend.svg">rdepend</TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12-merge.svg">--merge&nbsp;</TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://x11-misc/compose-tables-1.8.12" href="../x11-misc/compose-tables-1.8.12-emerge.svg">emerge</TD></TR></TABLE>>];

