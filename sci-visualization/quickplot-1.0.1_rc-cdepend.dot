digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sci-visualization</TD><TD title="repository" href="./quickplot.html">quickplot</TD><TD BORDER='0'></TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc.svg">detail</TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc-bdepend.svg">bdepend</TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc-cdepend.svg"><u>cdepend</u></TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc-depend.svg">depend</TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc-idepend.svg">idepend</TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc-rdepend.svg">rdepend</TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://sci-visualization/quickplot-0.10.6-r1" href="../sci-visualization/quickplot-0.10.6-r1-cdepend.svg">older &gt;</TD><TD title="portage://sci-visualization/quickplot-0.10.6-r1" href="../sci-visualization/quickplot-0.10.6-r1-cdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc-merge.svg">--merge&nbsp;</TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sci-visualization/quickplot-1.0.1_rc" href="../sci-visualization/quickplot-1.0.1_rc-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://sci-visualization/quickplot-1.0.1_rc"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://sci-visualization/quickplot-1.0.1_rc" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../sci-visualization/quickplot-1.0.1_rc-cdepend.svg"];
}
