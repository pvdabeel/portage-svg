fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-admin/restart-services-1.5", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-admin/restart-services-1.5.svg"];
