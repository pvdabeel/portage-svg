digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-firmware</TD><TD title="repository" href="./atmel-firmware.html">atmel-firmware</TD><TD BORDER='0'></TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3.svg"><u>detail</u></TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3-bdepend.svg">bdepend</TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3-cdepend.svg">cdepend</TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3-depend.svg">depend</TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3-idepend.svg">idepend</TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3-rdepend.svg">rdepend</TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-firmware/atmel-firmware-1.3-r3" href="../sys-firmware/atmel-firmware-1.3-r3-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://sys-firmware/atmel-firmware-1.3-r3", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../sys-firmware/atmel-firmware-1.3-r3.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
use_conditional_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD ROWSPAN="3" CELLPADDING="10">use_conditional</TD></TR>
          <TR><TD>positive</TD></TR><TR><TD>pcmcia</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>sys-apps</TD></TR><TR><TD>pcmciautils</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
use_conditional_group1:e -> package_dependency1:w [weight=20, style="dashed",arrowhead="vee"];
}
id:e -> use_conditional_group1:w [weight=20, style="solid",arrowhead="odot"];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>net-wireless</TD></TR><TR><TD>wireless-tools</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[26],,-r1,26-r1]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency2:w [weight=20, style="solid",arrowhead="odot"];
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"sys-apps/pcmciautils-018_p18" [label="portage://sys-apps/pcmciautils-018_p18", color=red, width=4,href="../sys-apps/pcmciautils-018_p18.svg"];
package_dependency1:e -> "sys-apps/pcmciautils-018_p18":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"net-wireless/wireless-tools-30_pre9-r2" [label="portage://net-wireless/wireless-tools-30_pre9-r2", color=red, width=4,href="../net-wireless/wireless-tools-30_pre9-r2.svg"];
"net-wireless/wireless-tools-30_pre9-r1" [label="portage://net-wireless/wireless-tools-30_pre9-r1", color=red, width=4,href="../net-wireless/wireless-tools-30_pre9-r1.svg"];
package_dependency2:e -> "net-wireless/wireless-tools-30_pre9-r2":w [style=dotted,weight="100"];
package_dependency2:e -> "net-wireless/wireless-tools-30_pre9-r1":w [style=dotted,weight="100"];
}
}
}
