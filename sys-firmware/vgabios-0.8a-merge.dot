e/vgabios-0.7a-merge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-firmware/vgabios-0.8a" href="../sys-firmware/vgabios-0.8a-merge.svg">--<u>merge</u>&nbsp;</TD><TD title="portage://sys-firmware/vgabios-0.8a" href="../sys-firmware/vgabios-0.8a-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-firmware/vgabios-0.8a" href="../sys-firmware/vgabios-0.8a-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-firmware/vgabios-0.8a" href="../sys-firmware/vgabios-0.8a-emerge.svg">emerge</TD></TR></TABLE>>];

