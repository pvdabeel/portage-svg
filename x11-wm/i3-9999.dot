fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://x11-wm/i3-9999", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../x11-wm/i3-9999.svg"];
}

