digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-kernel</TD><TD title="repository" href="./dracut.html">dracut</TD><TD BORDER='0'></TD><TD title="portage://sys-kernel/dracut-106-r2" href="../sys-kernel/dracut-106-r2.svg"><u>detail</u></TD><TD title="portage://sys-kernel/dracut-106-r2" href="../sys-kernel/dracut-106-r2-bdepend.svg">bdepend</TD><TD title="portage://sys-kernel/dracut-106-r2" href="../sys-kernel/dracut-106-r2-cdepend.svg">cdepend</TD><TD title="portage://sys-kernel/dracut-106-r2" href="../sys-kernel/dracut-106-r2-depend.svg">depend</TD><TD title="portage://sys-kernel/dracut-106-r2" href="../sys-kernel/dracut-106-r2-idepend.svg">idepend</TD><TD title="portage://sys-kernel/dracut-106-r2" href="../sys-kernel/dracut-106-r2-rdepend.svg">rdepend</TD><TD title="portage://sys-kernel/dracut-106-r2" href="../sys-kernel/dracut-106-r2-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-kernel/dracut-9999" href="../sys-kernel/dracut-9999.svg">&lt;&lt; newest</TD><TD title="portage://sys-kernel/dracut-108-r4" href="../sys-kernel/dracut-108-r4.svg">&lt; newer</TD><TD title="portage://sys-kernel/dracut-103-r4" href="../sys-kernel/dracut-103-r4.svg">older &gt;</TD><TD title="portage://sys-kernel/dracut-060_pre20240104-r4" href="../sys-kernel/dracut-060_pre20240104-r4.svg">oldest &gt;&gt;