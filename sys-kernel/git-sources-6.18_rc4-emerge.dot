digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-kernel</TD><TD title="repository" href="./git-sources.html">git-sources</TD><TD BORDER='0'></TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4.svg">detail</TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4-bdepend.svg">bdepend</TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4-cdepend.svg">cdepend</TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4-depend.svg">depend</TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4-idepend.svg">idepend</TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4-rdepend.svg">rdepend</TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-kernel/git-sources-6.18_rc7" href="../sys-kernel/git-sources-6.18_rc7-emerge.svg">&lt;&lt; newest</TD><TD title="portage://sys-kernel/git-sources-6.18_rc5" href="../sys-kernel/git-sources-6.18_rc5-emerge.svg">&lt; newer</TD><TD title="portage://sys-kernel/git-sources-6.18_rc3" href="../sys-kernel/git-sources-6.18_rc3-emerge.svg">older &gt;</TD><TD title="portage://sys-kernel/git-sources-6.18_rc1" href="../sys-kernel/git-sources-6.18_rc1-emerge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-kernel/git-sources-6.18_rc4" href="../sys-kernel/git-sources-6.18_rc4-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
