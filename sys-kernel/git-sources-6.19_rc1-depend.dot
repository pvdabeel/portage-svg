graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-kernel</TD><TD title="repository" href="./git-sources.html">git-sources</TD><TD BORDER='0'></TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1.svg">detail</TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1-bdepend.svg">bdepend</TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1-cdepend.svg">cdepend</TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1-depend.svg"><u>depend</u></TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1-idepend.svg">idepend</TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1-rdepend.svg">rdepend</TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-kernel/git-sources-6.19_rc1" href="../sys-kernel/git-sources-6.19_rc1-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://sys-kernel/git-sources-6.19_rc1"[minlen=0.2, headport=n, tailport=s, style=invis];

