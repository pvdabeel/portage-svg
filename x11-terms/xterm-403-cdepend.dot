digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">x11-terms</TD><TD title="repository" href="./xterm.html">xterm</TD><TD BORDER='0'></TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403.svg">detail</TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403-bdepend.svg">bdepend</TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403-cdepend.svg"><u>cdepend</u></TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403-depend.svg">depend</TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403-idepend.svg">idepend</TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403-rdepend.svg">rdepend</TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://x11-terms/xterm-405" href="../x11-terms/xterm-405-cdepend.svg">&lt;&lt; newest</TD><TD title="portage://x11-terms/xterm-404" href="../x11-terms/xterm-404-cdepend.svg">&lt; newer</TD><TD title="portage://x11-terms/xterm-402" href="../x11-terms/xterm-402-cdepend.svg">older &gt;</TD><TD title="portage://x11-terms/xterm-401" href="../x11-terms/xterm-401-cdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403-merge.svg">--merge&nbsp;</TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://x11-terms/xterm-403" href="../x11-terms/xterm-403-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://x11-terms/xterm-403"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://x11-terms/xterm-403" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../x11-terms/xterm-403-cdepend.svg"];
}
