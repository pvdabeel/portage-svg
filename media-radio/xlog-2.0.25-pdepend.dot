digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-radio</TD><TD title="repository" href="./xlog.html">xlog</TD><TD BORDER='0'></TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25.svg">detail</TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25-bdepend.svg">bdepend</TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25-cdepend.svg">cdepend</TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25-depend.svg">depend</TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25-idepend.svg">idepend</TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25-rdepend.svg">rdepend</TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25-pdepend.svg"><u>pdepend</u></TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25-merge.svg">--merge&nbsp;</TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-radio/xlog-2.0.25" href="../media-radio/xlog-2.0.25-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://media-radio/xlog-2.0.25"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://media-radio/xlog-2.0.25" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../media-radio/xlog-2.0.25-pdepend.svg"];
}
