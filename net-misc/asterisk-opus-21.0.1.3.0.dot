digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-misc</TD><TD title="repository" href="./asterisk-opus.html">asterisk-opus</TD><TD BORDER='0'></TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0.svg"><u>detail</u></TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0-bdepend.svg">bdepend</TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0-cdepend.svg">cdepend</TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0-depend.svg">depend</TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0-idepend.svg">idepend</TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0-rdepend.svg">rdepend</TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-misc/asterisk-opus-22.0.1.3.0" href="../net-misc/asterisk-opus-22.0.1.3.0.svg">&lt;&lt; newest</TD><TD title="portage://net-misc/asterisk-opus-22.0.1.3.0" href="../net-misc/asterisk-opus-22.0.1.3.0.svg">&lt; newer</TD><TD title="portage://net-misc/asterisk-opus-20.0.1.3.0" href="../net-misc/asterisk-opus-20.0.1.3.0.svg">older &gt;</TD><TD title="portage://net-misc/asterisk-opus-18.0.1.3.0-r1" href="../net-misc/asterisk-opus-18.0.1.3.0-r1.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0-merge.svg">--merge&nbsp;</TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/asterisk-opus-21.0.1.3.0" href="../net-misc/asterisk-opus-21.0.1.3.0-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://net-misc/asterisk-opus-21.0.1.3.0", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../net-misc/asterisk-opus-21.0.1.3.0.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>net-misc</TD></TR><TR><TD>asterisk</TD></TR>
                     <TR><TD>equal</TD></TR><TR><TD>[[21],,,21*]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="odot"];
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"net-misc/asterisk-21.12.0" [label="portage://net-misc/asterisk-21.12.0", color=red, width=4,href="../net-misc/asterisk-21.12.0.svg"];
"net-misc/asterisk-21.10.2" [label="portage://net-misc/asterisk-21.10.2", color=red, width=4,href="../net-misc/asterisk-21.10.2.svg"];
package_dependency1:e -> "net-misc/asterisk-21.12.0":w [style=dotted,weight="100"];
package_dependency1:e -> "net-misc/asterisk-21.10.2":w [style=dotted,weight="100"];
}
}
}
