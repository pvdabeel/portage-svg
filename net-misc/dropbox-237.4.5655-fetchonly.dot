graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-misc</TD><TD title="repository" href="./dropbox.html">dropbox</TD><TD BORDER='0'></TD><TD title="portage://net-misc/dropbox-237.4.5655" href="../net-misc/dropbox-237.4.5655.svg">detail</TD><TD title="portage://net-misc/dropbox-237.4.5655" href="../net-misc/dropbox-237.4.5655-bdepend.svg">bdepend</TD><TD title="portage://net-misc/dropbox-237.4.5655" href="../net-misc/dropbox-237.4.5655-cdepend.svg">cdepend</TD><TD title="portage://net-misc/dropbox-237.4.5655" href="../net-misc/dropbox-237.4.5655-depend.svg">depend</TD><TD title="portage://net-misc/dropbox-237.4.5655" href="../net-misc/dropbox-237.4.5655-idepend.svg">idepend</TD><TD title="portage://net-misc/dropbox-237.4.5655" href="../net-misc/dropbox-237.4.5655-rdepend.svg">rdepend</TD><TD title="portage://net-misc/dropbox-237.4.5655" href="../net-misc/dropbox-237.4.5655-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://net-misc/dropbox-236.4.5918" href="../net-misc/dropbox-236.4.5918-fetchonly.svg">older &gt;</TD><TD title="portage://net-misc/dropbox-232.4.5988" href="../net-misc/dropbox-232.4.5988-fetchonly.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/dropbox-23