"dev-lang/perl-5.42.0" [label="portage://dev-lang/perl-5.42.0", color=red, width=4,href="../dev-lang/perl-5.42.0.svg"];
"dev-lang/perl-5.40.2" [label="portage://dev-lang/perl-5.40.2", color=red, width=4,href="../dev-lang/perl-5.40.2.svg"];
"dev-lang/perl-5.40.1" [label="portage://dev-lang/perl-5.40.1", color=red, width=4,href="../dev-lang/perl-5.40.1.svg"];
"dev-lang/perl-5.40.0-r1" [label="portage://dev-lang/perl-5.40.0-r1", color=red, width=4,href="../dev-lang/perl-5.40.0-r1.svg"];
"dev-lang/perl-5.40.2" [label="pkg://dev-lang/perl-5.40.2", color=red, width=4,href="../dev-lang/perl-5.40.2.svg"];
package_dependency1:e -> "dev-lang/perl-5.42.0-r1":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-lang/perl-5.42.0":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-lang/perl-5.40.2":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-lang/perl-5.40.1":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-lang/perl-5.40.0-r1":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-lang/perl-5.40.2":w [style=dotted,weight="100"];
}
}
}
