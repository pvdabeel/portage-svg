"virtual/ssh-0-r2" [label="pkg://virtual/ssh-0-r2", color=red, width=4,href="../virtual/ssh-0-r2.svg"];
package_dependency3:e -> "virtual/ssh-0-r2":w [style=dotted,weight="100"];
package_dependency3:e -> "virtual/ssh-0-r2":w [style=dotted,weight="100"];
}
}
}
