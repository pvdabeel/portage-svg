package_dependency2:e -> "dev-lang/tk-8.6.17":w [style=dotted,weight="100"];
package_dependency2:e -> "dev-lang/tk-8.6.16":w [style=dotted,weight="100"];
package_dependency2:e -> "dev-lang/tk-8.6.15":w [style=dotted,weight="100"];
package_dependency2:e -> "dev-lang/tk-8.6.14":w [style=dotted,weight="100"];
