digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-misc</TD><TD title="repository" href="./tinyssh.html">tinyssh</TD><TD BORDER='0'></TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999.svg">detail</TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-bdepend.svg">bdepend</TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-cdepend.svg">cdepend</TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-depend.svg">depend</TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-idepend.svg">idepend</TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-rdepend.svg"><u>rdepend</u></TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-rdepend.svg">older &gt;</TD><TD title="portage://net-misc/tinyssh-20250411" href="../net-misc/tinyssh-20250411-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-merge.svg">--merge&nbsp;</TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-misc/tinyssh-99999999"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-misc/tinyssh-99999999" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-misc/tinyssh-99999999-rdepend.svg"];
"portage://net-misc/tinyssh-99999999" -> "portage://sys-apps/ucspi-tcp-0.88-r20"
"portage://sys-apps/ucspi-tcp-0.88-r20" [color=red, penwidth=1, href="../sys-apps/ucspi-tcp-0.88-r20-rdepend.svg"];
}
