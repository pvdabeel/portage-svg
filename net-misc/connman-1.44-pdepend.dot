digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-misc</TD><TD title="repository" href="./connman.html">connman</TD><TD BORDER='0'></TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44.svg">detail</TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44-bdepend.svg">bdepend</TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44-cdepend.svg">cdepend</TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44-depend.svg">depend</TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44-idepend.svg">idepend</TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44-rdepend.svg">rdepend</TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44-pdepend.svg"><u>pdepend</u></TD><TD BORDER='0'></TD><TD title="portage://net-misc/connman-9999" href="../net-misc/connman-9999-pdepend.svg">&lt;&lt; newest</TD><TD title="portage://net-misc/connman-1.45" href="../net-misc/connman-1.45-pdepend.svg">&lt; newer</TD><TD title="portage://net-misc/connman-1.43" href="../net-misc/connman-1.43-pdepend.svg">older &gt;</TD><TD title="portage://net-misc/connman-1.43" href="../net-misc/connman-1.43-pdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44-merge.svg">--merge&nbsp;</TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/connman-1.44" href="../net-misc/connman-1.44-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-misc/connman-1.44"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-misc/connman-1.44" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-misc/connman-1.44-pdepend.svg"];
}
