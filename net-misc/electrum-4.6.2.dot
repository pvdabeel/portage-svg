fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://net-misc/electrum-4.6.2", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../net-misc/electrum-4.6.2.svg"];
