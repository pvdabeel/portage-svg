rtage://net-misc/asterisk-g729-18.0.3.1.10-r1" href="../net-misc/asterisk-g729-18.0.3.1.10-r1.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/asterisk-g729-22.0.3.1.10-r1" href="../net-misc/asterisk-g729-22.0.3.1.10-r1-merge.svg">--merge&nbsp;</TD><TD title="portage://net-misc/asterisk-g729-22.0.3.1.10-r1" href="../net-misc/asterisk-g729-22.0.3.1.10-r1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-misc/asterisk-g729-22.0.3.1.10-r1" href="../net-misc/asterisk-g729-22.0.3.1.10-r1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/asterisk-g729-22.0.3.1.10-r1" href="../net-misc/asterisk-g729-22.0.3.1.10-r1-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://net-misc/asterisk-g729-22.0.3.1.10-r1", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../net-misc/asterisk-g729-22.0.3.1.10-r1.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>net-misc</TD></TR><TR><TD>asterisk</TD></TR>
                     <TR><TD>equal</TD></TR><TR><TD>[[22],,,22*]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="odot"];
}
}

