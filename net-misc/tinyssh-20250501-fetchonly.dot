digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-misc</TD><TD title="repository" href="./tinyssh.html">tinyssh</TD><TD BORDER='0'></TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501.svg">detail</TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-bdepend.svg">bdepend</TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-cdepend.svg">cdepend</TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-depend.svg">depend</TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-idepend.svg">idepend</TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-rdepend.svg">rdepend</TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-fetchonly.svg">&lt;&lt; newest</TD><TD title="portage://net-misc/tinyssh-99999999" href="../net-misc/tinyssh-99999999-fetchonly.svg">&lt; newer</TD><TD title="portage://net-misc/tinyssh-20250411" href="../net-misc/tinyssh-20250411-fetchonly.svg">older &gt;</TD><TD title="portage://net-misc/tinyssh-20250411" href="../net-misc/tinyssh-20250411-fetchonly.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-merge.svg">--merge&nbsp;</TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-fetchonly.svg">--<u>fetchonly</u>&nbsp;</TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-misc/tinyssh-20250501" href="../net-misc/tinyssh-20250501-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
