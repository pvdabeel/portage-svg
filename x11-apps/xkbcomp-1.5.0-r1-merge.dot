digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">x11-apps</TD><TD title="repository" href="./xkbcomp.html">xkbcomp</TD><TD BORDER='0'></TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1.svg">detail</TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1-bdepend.svg">bdepend</TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1-cdepend.svg">cdepend</TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1-depend.svg">depend</TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1-idepend.svg">idepend</TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1-rdepend.svg">rdepend</TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://x11-apps/xkbcomp-1.4.7" href="../x11-apps/xkbcomp-1.4.7-merge.svg">older &gt;</TD><TD title="portage://x11-apps/xkbcomp-1.4.7" href="../x11-apps/xkbcomp-1.4.7-merge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1-merge.svg">--<u>merge</u>&nbsp;</TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://x11-apps/xkbcomp-1.5.0-r1" href="../x11-apps/xkbcomp-1.5.0-r1-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
