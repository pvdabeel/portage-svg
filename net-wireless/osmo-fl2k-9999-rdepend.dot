digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-wireless</TD><TD title="repository" href="./osmo-fl2k.html">osmo-fl2k</TD><TD BORDER='0'></TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999.svg">detail</TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999-bdepend.svg">bdepend</TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999-cdepend.svg">cdepend</TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999-depend.svg">depend</TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999-idepend.svg">idepend</TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999-rdepend.svg"><u>rdepend</u></TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://net-wireless/osmo-fl2k-0.2.0" href="../net-wireless/osmo-fl2k-0.2.0-rdepend.svg">older &gt;</TD><TD title="portage://net-wireless/osmo-fl2k-0.2.0" href="../net-wireless/osmo-fl2k-0.2.0-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999-merge.svg">--merge&nbsp;</TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-wireless/osmo-fl2k-9999" href="../net-wireless/osmo-fl2k-9999-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-wireless/osmo-fl2k-9999"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-wireless/osmo-fl2k-9999" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-wireless/osmo-fl2k-9999-rdepend.svg"];
"portage://net-wireless/osmo-fl2k-9999" -> "portage://virtual/libusb-1-r2"
"portage://net-wireless/osmo-fl2k-9999" -> "portage://media-sound/sox-14.6.0.4"
"portage://net-wireless/osmo-fl2k-9999" -> "portage://sys-apps/pv-9999"
"portage://virtual/libusb-1-r2" [color=red, penwidth=1, href="../virtual/libusb-1-r2-rdepend.svg"];
"portage://virtual/libusb-1-r2" -> "portage://dev-libs/libusb-1.0.29"
"portage://dev-libs/libusb-1.0.29" [color=red, penwidth=1, href="../dev-libs/libusb-1.0.29-rdepend.svg"];
"portage://media-sound/sox-14.6.0.4" [color=red, penwidth=1, href="../media-sound/sox-14.6.0.4-rdepend.svg"];
"portage://media-sound/sox-14.6.0.4" -> "portage://dev-libs/libltdl-2.6.0"
"portage://media-sound/sox-14.6.0.4" -> "portage://media-sound/gsm-1.0.23"
"portage://media-sound/sox-14.6.0.4" -> "portage://sys-apps/file-9999"
"portage://dev-libs/libltdl-2.6.0" [color=red, penwidth=1, href="../dev-libs/libltdl-2.6.0-rdepend.svg"];
"portage://media-sound/gsm-1.0.23" [color=red, penwidth=1, href="../media-sound/gsm-1.0.23-rdepend.svg"];
"portage://sys-apps/file-9999" [color=red, penwidth=1, href="../sys-apps/file-9999-rdepend.svg"];
"portage://sys-apps/pv-9999" [color=red, penwidth=1, href="../sys-apps/pv-9999-rdepend.svg"];
}
