digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-wireless</TD><TD title="repository" href="./wireless-regdb.html">wireless-regdb</TD><TD BORDER='0'></TD><TD title="portage://net-wireless/wireless-regdb-20250710" href="../net-wireless/wireless-regdb-20250710.svg">detail</TD><TD title="portage://net-wireless/wireless-regdb-20250710" href="../net-wireless/wireless-regdb-20250710-bdepend.svg"><u>bdepend</u></TD><TD title="portage://net-wireless/wireless-regdb-20250710" href="../net-wireless/wireless-regdb-20250710-cdepend.svg">cdepend</TD><TD title="portage://net-wireless/wireless-regdb-20250710" href="../net-wireless/wireless-regdb-20250710-depend.svg">depend</TD><TD title="portage://net-wireless/wireless-regdb-20250710" href="../net-wireless/wireless-regdb-20250710-idepend.svg">idepend</TD><TD title="portage://net-wireless/wireless-regdb-20250710" href="../net-wireless/wireless-regdb-20250710-rdepend.svg">rdepend</TD><TD title="portage://net-wireless/wireless-regdb-20250710" href="../net-wireless/wireless-regdb-20250710-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-wireless/wireless-regdb-20251007" href="../net-wireless/wireless-regdb-20251007-bdepend.svg">&lt;&lt; newest</TD><TD title="portage://net-wireless/wireless-regdb-20251007" href="../net-wireless/wireless-regdb-20251007-