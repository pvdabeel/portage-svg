digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-wireless</TD><TD title="repository" href="./hidclient.html">hidclient</TD><TD BORDER='0'></TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728.svg"><u>detail</u></TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728-bdepend.svg">bdepend</TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728-cdepend.svg">cdepend</TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728-depend.svg">depend</TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728-idepend.svg">idepend</TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728-rdepend.svg">rdepend</TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728-merge.svg">--merge&nbsp;</TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-wireless/hidclient-20120728" href="../net-wireless/hidclient-20120728-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://net-wireless/hidclient-20120728", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../net-wireless/hidclient-20120728.svg"];
}

