digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-emacs</TD><TD title="repository" href="./emms.html">emms</TD><TD BORDER='0'></TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23.svg">detail</TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23-bdepend.svg">bdepend</TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23-cdepend.svg">cdepend</TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23-depend.svg"><u>depend</u></TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23-idepend.svg">idepend</TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23-rdepend.svg">rdepend</TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-emacs/emms-24" href="../app-emacs/emms-24-depend.svg">&lt;&lt; newest</TD><TD title="portage://app-emacs/emms-24" href="../app-emacs/emms-24-depend.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23-merge.svg">--merge&nbsp;</TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-emacs/emms-23" href="../app-emacs/emms-23-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-emacs/emms-23"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-emacs/emms-23" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-emacs/emms-23-depend.svg"];
"portage://app-emacs/emms-23" -> "portage://media-libs/taglib-2.1.1"
"portage://media-libs/taglib-2.1.1" [color=red, penwidth=1, href="../media-libs/taglib-2.1.1-depend.svg"];
