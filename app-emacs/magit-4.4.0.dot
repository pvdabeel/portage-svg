it-4.4.0-merge.svg">--merge&nbsp;</TD><TD title="portage://app-emacs/magit-4.4.0" href="../app-emacs/magit-4.4.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-emacs/magit-4.4.0" href="../app-emacs/magit-4.4.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-emacs/magit-4.4.0" href="../app-emacs/magit-4.4.0-emerge.svg">emerge</TD></TR></TABLE>>];

