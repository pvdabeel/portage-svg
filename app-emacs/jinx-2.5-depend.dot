"portage://virtual/libiconv-0-r2" [color=red, penwidth=1, href="../virtual/libiconv-0-r2-depend.svg"];
"portage://dev-libs/libpcre2-10.47" [color=red, penwidth=1, href="../dev-libs/libpcre2-10.47-depend.svg"];
"portage://dev-libs/libffi-9999" [color=red, penwidth=1, href="../dev-libs/libffi-9999-depend.svg"];
