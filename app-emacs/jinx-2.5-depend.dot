"portage://app-text/enchant-2.8.12" -> "portage://dev-libs/glib-2.86.1"
"portage://dev-libs/glib-2.86.1" [color=red, penwidth=1, href="../dev-libs/glib-2.86.1-depend.svg"];
"portage://dev-libs/glib-2.86.1" -> "portage://dev-util/gdbus-codegen-2.84.4" [style=dashed, color=orange];
"portage://dev-libs/glib-2.86.1" -> "portage://virtual/libiconv-0-r2"
"portage://dev-libs/glib-2.86.1" -> "portage://dev-libs/libpcre2-10.47"
"portage://dev-libs/glib-2.86.1" -> "portage://dev-libs/libffi-9999"
"portage://dev-libs/glib-2.86.1" -> "portage://virtual/zlib-1.3.1-r1"
"portage://dev-libs/glib-2.86.1" -> "portage://virtual/libintl-0-r2"
"portage://dev-util/gdbus-codegen-2.84.4" [color=red, penwidth=1, href="../dev-util/gdbus-codegen-2.84.4-depend.svg"];
