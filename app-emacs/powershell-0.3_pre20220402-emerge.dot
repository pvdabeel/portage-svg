digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-emacs</TD><TD title="repository" href="./powershell.html">powershell</TD><TD BORDER='0'></TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402.svg">detail</TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402-bdepend.svg">bdepend</TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402-cdepend.svg">cdepend</TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402-depend.svg">depend</TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402-idepend.svg">idepend</TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402-rdepend.svg">rdepend</TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-emacs/powershell-0.3_pre20220805" href="../app-emacs/powershell-0.3_pre20220805-emerge.svg">&lt;&lt; newest</TD><TD title="portage://app-emacs/powershell-0.3_pre20220805" href="../app-emacs/powershell-0.3_pre20220805-emerge.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402-merge.svg">--merge&nbsp;</TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-emacs/powershell-0.3_pre20220402" href="../app-emacs/powershell-0.3_pre20220402-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
