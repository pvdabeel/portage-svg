}
any_of_group1:e -> package_dependency2:w [weight=20, style="dotted",arrowhead="oinv"];
}
id:e -> any_of_group1:w [weight=20, style="solid",arrowhead="vee"];
subgraph  {
strong_blocker1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (strong)</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>net-mail</TD></TR><TR><TD>stalwart-mail</TD></TR>
                     <TR><TD>smaller</TD></TR><TR><TD>[[0,12,0],,,0.12.0]</TD></TR></TABLE>>, shape=none, color=red];
}
id:e -> strong_blocker1:w [weight=20, color="red", style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
