"portage://net-libs/cvm-0.97-r2" -> "portage://dev-libs/bglibs-2.04-r5"
"portage://net-libs/cvm-0.97-r2" -> "portage://virtual/libcrypt-2-r1"
"portage://dev-db/cdb-0.75-r5" [color=red, penwidth=1, href="../dev-db/cdb-0.75-r5-depend.svg"];
