digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-mail</TD><TD title="repository" href="./dbmail.html">dbmail</TD><TD BORDER='0'></TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1.svg">detail</TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1-bdepend.svg">bdepend</TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1-cdepend.svg">cdepend</TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1-depend.svg">depend</TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1-idepend.svg">idepend</TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1-rdepend.svg">rdepend</TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-mail/dbmail-3.5.5" href="../net-mail/dbmail-3.5.5-emerge.svg">&lt;&lt; newest</TD><TD title="portage://net-mail/dbmail-3.4.1" href="../net-mail/dbmail-3.4.1-emerge.svg">&lt; newer</TD><TD title="portage://net-mail/dbmail-3.2.5-r2" href="../net-mail/dbmail-3.2.5-r2-emerge.svg">older &gt;</TD><TD title="portage://net-mail/dbmail-3.2.3-r5" href="../net-mail/dbmail-3.2.3-r5-emerge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1-merge.svg">--merge&nbsp;</TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-mail/dbmail-3.3.1" href="../net-mail/dbmail-3.3.1-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
