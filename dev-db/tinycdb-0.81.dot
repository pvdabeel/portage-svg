digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-db</TD><TD title="repository" href="./tinycdb.html">tinycdb</TD><TD BORDER='0'></TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81.svg"><u>detail</u></TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81-bdepend.svg">bdepend</TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81-cdepend.svg">cdepend</TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81-depend.svg">depend</TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81-idepend.svg">idepend</TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81-rdepend.svg">rdepend</TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-db/tinycdb-0.81" href="../dev-db/tinycdb-0.81-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://dev-db/tinycdb-0.81", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../dev-db/tinycdb-0.81.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
weak_blocker1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>dev-db</TD></TR><TR><TD>cdb</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker1:w [weight=20, color="orange", style="solid",arrowhead="odot"];
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"dev-db/cdb-0.75-r5" [label="portage://dev-db/cdb-0.75-r5", color=red, width=4,href="../dev-db/cdb-0.75-r5.svg"];
"dev-db/cdb-0.75-r4" [label="portage://dev-db/cdb-0.75-r4", color=red, width=4,href="../dev-db/cdb-0.75-r4.svg"];
weak_blocker1:e -> "dev-db/cdb-0.75-r5":w [style=dotted,weight="100"];
weak_blocker1:e -> "dev-db/cdb-0.75-r4":w [style=dotted,weight="100"];
}
}
}
