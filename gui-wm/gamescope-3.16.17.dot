graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">gui-wm</TD><TD title="repository" href="./gamescope.html">gamescope</TD><TD BORDER='0'></TD><TD title="portage://gui-wm/gamescope-3.16.17" href="../gui-wm/gamescope-3.16.17.svg"><u>detail</u></TD><TD title="portage://gui-wm/gamescope-3.16.17" href="../gui-wm/gamescope-3.16.17-bdepend.svg">bdepend</TD><TD title="portage://gui-wm/gamescope-3.16.17" href="../gui-wm/gamescope-3.16.17-cdepend.svg">cdepend</TD><TD title="portage://gui-wm/gamescope-3.16.17" href="../gui-wm/gamescope-3.16.17-depend.svg">depend</TD><TD title="portage://gui-wm/gamescope-3.16.17" href="../gui-wm/gamescope-3.16.17-idepend.svg">idepend</TD><TD title="portage://gui-wm/gamescope-3.16.17" href="../gui-wm/gamescope-3.16.17-rdepend.svg">rdepend</TD><TD title="portage://gui-wm/gamescope-3.16.17" href="../gui-wm/gamescope-3.16.17-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://gui-wm/gamescope-3.16.17" href="../gui-wm/gamescope-3.16.17-merge.svg">--merge&nbsp;</TD><TD title="portage://gui-wm/gamescope-3.16.17" href="../gui-wm/gamescope-3.16.17-fetchonly.svg">--fetchonly