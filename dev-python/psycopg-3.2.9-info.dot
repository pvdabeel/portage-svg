graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-python</TD><TD title="repository" href="./psycopg.html">psycopg</TD><TD BORDER='0'></TD><TD title="portage://dev-python/psycopg-3.2.9" href="../dev-python/psycopg-3.2.9.svg">detail</TD><TD title="portage://dev-python/psycopg-3.2.9" href="../dev-python/psycopg-3.2.9-bdepend.svg">bdepend</TD><TD title="portage://dev-python/psycopg-3.2.9" href="../dev-python/psycopg-3.2.9-cdepend.svg">cdepend</TD><TD title="portage://dev-python/psycopg-3.2.9" href="../dev-python/psycopg-3.2.9-depend.svg">depend</TD><TD title="portage://dev-python/psycopg-3.2.9" href="../dev-python/psycopg-3.2.9-idepend.svg">idepend</TD><TD title="portage://dev-python/psycopg-3.2.9" href="../dev-python/psycopg-3.2.9-rdepend.svg">rdepend</TD><TD title="portage://dev-python/psycopg-3.2.9" href="../dev-python/psycopg-3.2.9-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-python/psycopg-3.3.2" href="../dev-python/psycopg-3.3.2-info.svg">&lt;&lt; newest</TD><TD title="portage://dev-python/psycopg-3.2.10" href="../dev-python/psycopg-3.2.10-info.svg">&lt; newer</TD><TD title="portage://dev-python/psycopg-2.9.11" href="../dev-python/psycopg-2.9.11-info.svg">older &gt;</TD><TD title="portage://dev-python/psycopg-2.9.10" href="../dev-python/psycopg-2.9.10-info.svg">oldest &gt;&gt