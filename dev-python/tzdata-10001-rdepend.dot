root [style=invis];
root -> "portage://dev-python/tzdata-10001"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://dev-python/tzdata-10001" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../dev-python/tzdata-10001-rdepend.svg"];
