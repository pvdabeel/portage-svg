digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-python</TD><TD title="repository" href="./urllib3.html">urllib3</TD><TD BORDER='0'></TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0.svg">detail</TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0-bdepend.svg">bdepend</TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0-cdepend.svg">cdepend</TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0-depend.svg">depend</TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0-idepend.svg">idepend</TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0-rdepend.svg">rdepend</TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-python/urllib3-2.6.2" href="../dev-python/urllib3-2.6.2-merge.svg">&lt;&lt; newest</TD><TD title="portage://dev-python/urllib3-2.6.1" href="../dev-python/urllib3-2.6.1-merge.svg">&lt; newer</TD><TD title="portage://dev-python/urllib3-2.5.0" href="../dev-python/urllib3-2.5.0-merge.svg">older &gt;</TD><TD title="portage://dev-python/urllib3-2.5.0" href="../dev-python/urllib3-2.5.0-merge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0-merge.svg">--<u>merge</u>&nbsp;</TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-python/urllib3-2.6.0" href="../dev-python/urllib3-2.6.0-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
