"dev-libs/libffi-3.4.8-r3" [label="portage://dev-libs/libffi-3.4.8-r3", color=red, width=4,href="../dev-libs/libffi-3.4.8-r3.svg"];
"dev-libs/libffi-3.4.8-r2" [label="pkg://dev-libs/libffi-3.4.8-r2", color=red, width=4,href="../dev-libs/libffi-3.4.8-r2.svg"];
package_dependency1:e -> "dev-libs/libffi-9999":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-libs/libffi-3.5.2":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-libs/libffi-3.5.1":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-libs/libffi-3.4.8-r3":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-libs/libffi-3.4.8-r2":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"virtual/pkgconfig-3" [label="portage://virtual/pkgconfig-3", color=red, width=4,href="../virtual/pkgconfig-3.svg"];
"virtual/pkgconfig-3" [label="pkg://virtual/pkgconfig-3", color=red, width=4,href="../virtual/pkgconfig-3.svg"];
package_dependency2:e -> "virtual/pkgconfig-3":w [style=dotted,weight="100"];
package_dependency2:e -> "virtual/pkgconfig-3":w [style=dotted,weight="100"];
}
}
}
