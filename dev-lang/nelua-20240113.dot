digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-lang</TD><TD title="repository" href="./nelua.html">nelua</TD><TD BORDER='0'></TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113.svg"><u>detail</u></TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113-bdepend.svg">bdepend</TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113-cdepend.svg">cdepend</TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113-depend.svg">depend</TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113-idepend.svg">idepend</TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113-rdepend.svg">rdepend</TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-lang/nelua-99999999" href="../dev-lang/nelua-99999999.svg">&lt;&lt; newest</TD><TD title="portage://dev-lang/nelua-99999999" href="../dev-lang/nelua-99999999.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-lang/nelua-20240113" href="../dev-lang/nelua-20240113-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://dev-lang/nelua-20240113", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../dev-lang/nelua-20240113.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
use_conditional_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD ROWSPAN="3" CELLPADDING="10">use_conditional</TD></TR>
          <TR><TD>positive</TD></TR><TR><TD>test</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>dev-lua</TD></TR><TR><TD>luacheck</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
use_conditional_group1:e -> package_dependency1:w [weight=20, style="dashed",arrowhead="vee"];
}
id:e -> use_conditional_group1:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"dev-lua/luacheck-1.2.0" [label="portage://dev-lua/luacheck-1.2.0", color=red, width=4,href="../dev-lua/luacheck-1.2.0.svg"];
package_dependency1:e -> "dev-lua/luacheck-1.2.0":w [style=dotted,weight="100"];
}
}
}
