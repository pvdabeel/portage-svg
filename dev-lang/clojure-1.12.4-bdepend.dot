digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-lang</TD><TD title="repository" href="./clojure.html">clojure</TD><TD BORDER='0'></TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4.svg">detail</TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4-bdepend.svg"><u>bdepend</u></TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4-cdepend.svg">cdepend</TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4-depend.svg">depend</TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4-idepend.svg">idepend</TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4-rdepend.svg">rdepend</TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://dev-lang/clojure-1.12.3" href="../dev-lang/clojure-1.12.3-bdepend.svg">older &gt;</TD><TD title="portage://dev-lang/clojure-1.12.3" href="../dev-lang/clojure-1.12.3-bdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-lang/clojure-1.12.4" href="../dev-lang/clojure-1.12.4-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://dev-lang/clojure-1.12.4"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://dev-lang/clojure-1.12.4" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../dev-lang/clojure-1.12.4-bdepend.svg"];
"portage://dev-lang/clojure-1.12.4" -> "portage://dev-java/ant-1.10.15"
"portage://dev-java/ant-1.10.15" [color=red, penwidth=1, href="../dev-java/ant-1.10.15-bdepend.svg"];
}
