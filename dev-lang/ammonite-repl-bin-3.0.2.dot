"virtual/jre-25" [label="portage://virtual/jre-25", color=red, width=4,href="../virtual/jre-25.svg"];
"virtual/jre-21" [label="portage://virtual/jre-21", color=red, width=4,href="../virtual/jre-21.svg"];
"virtual/jre-17" [label="portage://virtual/jre-17", color=red, width=4,href="../virtual/jre-17.svg"];
"virtual/jre-11-r2" [label="portage://virtual/jre-11-r2", color=red, width=4,href="../virtual/jre-11-r2.svg"];
"virtual/jre-1.8.0-r3" [label="portage://virtual/jre-1.8.0-r3", color=red, width=4,href="../virtual/jre-1.8.0-r3.svg"];
package_dependency1:e -> "virtual/jre-26":w [style=dotted,weight="100"];
package_dependency1:e -> "virtual/jre-25":w [style=dotted,weight="100"];
package_dependency1:e -> "virtual/jre-21":w [style=dotted,weight="100"];
package_dependency1:e -> "virtual/jre-17":w [style=dotted,weight="100"];
package_dependency1:e -> "virtual/jre-11-r2":w [style=dotted,weight="100"];
package_dependency1:e -> "virtual/jre-1.8.0-r3":w [style=dotted,weight="100"];
}
}
