digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-libs</TD><TD title="repository" href="./libiconv.html">libiconv</TD><TD BORDER='0'></TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17.svg"><u>detail</u></TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17-bdepend.svg">bdepend</TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17-cdepend.svg">cdepend</TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17-depend.svg">depend</TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17-idepend.svg">idepend</TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17-rdepend.svg">rdepend</TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-libs/libiconv-1.18" href="../dev-libs/libiconv-1.18.svg">&lt;&lt; newest</TD><TD title="portage://dev-libs/libiconv-1.18" href="../dev-libs/libiconv-1.18.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-libs/libiconv-1.17" href="../dev-libs/libiconv-1.17-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://dev-libs/libiconv-1.17", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../dev-libs/libiconv-1.17.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
weak_blocker1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>sys-libs</TD></TR><TR><TD>glibc</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker1:w [weight=20, color="orange", style="solid",arrowhead="vee"];
subgraph  {
weak_blocker2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>sys-libs</TD></TR><TR><TD>musl</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker2:w [weight=20, color="orange", style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
weak_blocker3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>sys-libs</TD></TR><TR><TD>glibc</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker3:w [weight=20, color="orange", style="solid",arrowhead="odot"];
subgraph  {
weak_blocker4 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>sys-libs</TD></TR><TR><TD>musl</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker4:w [weight=20, color="orange", style="solid",arrowhead="odot"];
}
}

