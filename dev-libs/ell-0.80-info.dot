digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-libs</TD><TD title="repository" href="./ell.html">ell</TD><TD BORDER='0'></TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80.svg">detail</TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80-bdepend.svg">bdepend</TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80-cdepend.svg">cdepend</TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80-depend.svg">depend</TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80-idepend.svg">idepend</TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80-rdepend.svg">rdepend</TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-libs/ell-9999" href="../dev-libs/ell-9999-info.svg">&lt;&lt; newest</TD><TD title="portage://dev-libs/ell-0.81" href="../dev-libs/ell-0.81-info.svg">&lt; newer</TD><TD title="portage://dev-libs/ell-0.79" href="../dev-libs/ell-0.79-info.svg">older &gt;</TD><TD title="portage://dev-libs/ell-0.77" href="../dev-libs/ell-0.77-info.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80-info.svg">--<u>info</u>&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-libs/ell-0.80" href="../dev-libs/ell-0.80-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
