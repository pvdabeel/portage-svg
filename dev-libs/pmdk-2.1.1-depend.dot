root -> "portage://dev-libs/pmdk-2.1.1"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://dev-libs/pmdk-2.1.1" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../dev-libs/pmdk-2.1.1-depend.svg"];
