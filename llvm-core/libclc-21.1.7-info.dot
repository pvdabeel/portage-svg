digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">llvm-core</TD><TD title="repository" href="./libclc.html">libclc</TD><TD BORDER='0'></TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7.svg">detail</TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7-bdepend.svg">bdepend</TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7-cdepend.svg">cdepend</TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7-depend.svg">depend</TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7-idepend.svg">idepend</TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7-rdepend.svg">rdepend</TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://llvm-core/libclc-22.0.0.9999" href="../llvm-core/libclc-22.0.0.9999-info.svg">&lt;&lt; newest</TD><TD title="portage://llvm-core/libclc-21.1.8" href="../llvm-core/libclc-21.1.8-info.svg">&lt; newer</TD><TD title="portage://llvm-core/libclc-21.1.6" href="../llvm-core/libclc-21.1.6-info.svg">older &gt;</TD><TD title="portage://llvm-core/libclc-15.0.7" href="../llvm-core/libclc-15.0.7-info.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7-merge.svg">--merge&nbsp;</TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7-info.svg">--<u>info</u>&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://llvm-core/libclc-21.1.7" href="../llvm-core/libclc-21.1.7-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
