digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-editors</TD><TD title="repository" href="./emacs.html">emacs</TD><TD BORDER='0'></TD><TD title="portage://app-editors/emacs-29.4-r5" href="../app-editors/emacs-29.4-r5.svg"><u>detail</u></TD><TD title="portage://app-editors/emacs-29.4-r5" href="../app-editors/emacs-29.4-r5-bdepend.svg">bdepend</TD><TD title="portage://app-editors/emacs-29.4-r5" href="../app-editors/emacs-29.4-r5-cdepend.svg">cdepend</TD><TD title="portage://app-editors/emacs-29.4-r5" href="../app-editors/emacs-29.4-r5-depend.svg">depend</TD><TD title="portage://app-editors/emacs-29.4-r5" href="../app-editors/emacs-29.4-r5-idepend.svg">idepend</TD><TD title="portage://app-editors/emacs-29.4-r5" href="../app-editors/emacs-29.4-r5-rdepend.svg">rdepend</TD><TD title="portage://app-editors/emacs-29.4-r5" href="../app-editors/emacs-29.4-r5-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-editors/emacs-31.0.9999" href="../app-editors/emacs-31.0.9999.svg">&lt;&lt; newest</TD><TD title="portage://app-editors/emacs-30.1-r3" href="../app-editors/emacs-30.1-r3.svg">&lt; newer</TD><TD title="portage://app-editors/emacs-29.4-r4" href="../app-editors/emacs-29.4-r4.svg">older &gt;</TD><TD title="portage://app-editors/emacs-18.59-r15" href="../app-editors/emacs-18.59-r15.svg">oldest