digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-editors</TD><TD title="repository" href="./zed.html">zed</TD><TD BORDER='0'></TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4.svg"><u>detail</u></TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4-bdepend.svg">bdepend</TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4-cdepend.svg">cdepend</TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4-depend.svg">depend</TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4-idepend.svg">idepend</TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4-rdepend.svg">rdepend</TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-editors/zed-0.213.8" href="../app-editors/zed-0.213.8.svg">&lt;&lt; newest</TD><TD title="portage://app-editors/zed-0.210.4" href="../app-editors/zed-0.210.4.svg">&lt; newer</TD><TD title="portage://app-editors/zed-0.205.9" href="../app-editors/zed-0.205.9.svg">older &gt;</TD><TD title="portage://app-editors/zed-0.205.9" href="../app-editors/zed-0.205.9.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4-merge.svg">--merge&nbsp;</TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-editors/zed-0.208.4" href="../app-editors/zed-0.208.4-emerge.svg">emerge</TD></TR></TABLE>>];

