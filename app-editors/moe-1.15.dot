digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-editors</TD><TD title="repository" href="./moe.html">moe</TD><TD BORDER='0'></TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15.svg"><u>detail</u></TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15-bdepend.svg">bdepend</TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15-cdepend.svg">cdepend</TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15-depend.svg">depend</TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15-idepend.svg">idepend</TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15-rdepend.svg">rdepend</TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15-merge.svg">--merge&nbsp;</TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-editors/moe-1.15" href="../app-editors/moe-1.15-emerge.svg">emerge</TD></TR></TABLE>>];

