digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-editors</TD><TD title="repository" href="./e3.html">e3</TD><TD BORDER='0'></TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82.svg"><u>detail</u></TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82-bdepend.svg">bdepend</TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82-cdepend.svg">cdepend</TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82-depend.svg">depend</TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82-idepend.svg">idepend</TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82-rdepend.svg">rdepend</TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82-merge.svg">--merge&nbsp;</TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-editors/e3-2.82" href="../app-editors/e3-2.82-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-editors/e3-2.82", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-editors/e3-2.82.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>dev-lang</TD></TR><TR><TD>nasm</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[2,9,4],,,2.09.04]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"dev-lang/nasm-3.01" [label="portage://dev-lang/nasm-3.01", color=red, width=4,href="../dev-lang/nasm-3.01.svg"];
"dev-lang/nasm-2.16.03" [label="portage://dev-lang/nasm-2.16.03", color=red, width=4,href="../dev-lang/nasm-2.16.03.svg"];
"dev-lang/nasm-2.16.03" [label="pkg://dev-lang/nasm-2.16.03", color=red, width=4,href="../dev-lang/nasm-2.16.03.svg"];
package_dependency1:e -> "dev-lang/nasm-3.01":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-lang/nasm-2.16.03":w [style=dotted,weight="100"];
package_dependency1:e -> "dev-lang/nasm-2.16.03":w [style=dotted,weight="100"];
}
}
}
