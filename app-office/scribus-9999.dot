# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-office/scribus-9999", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-office/scribus-9999.svg"];
}

