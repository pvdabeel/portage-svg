digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-gfx</TD><TD title="repository" href="./gimp.html">gimp</TD><TD BORDER='0'></TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6.svg">detail</TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6-bdepend.svg">bdepend</TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6-cdepend.svg">cdepend</TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6-depend.svg">depend</TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6-idepend.svg"><u>idepend</u></TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6-rdepend.svg">rdepend</TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://media-gfx/gimp-9999" href="../media-gfx/gimp-9999-idepend.svg">&lt;&lt; newest</TD><TD title="portage://media-gfx/gimp-3.2.0_rc1" href="../media-gfx/gimp-3.2.0_rc1-idepend.svg">&lt; newer</TD><TD title="portage://media-gfx/gimp-2.10.38-r3" href="../media-gfx/gimp-2.10.38-r3-idepend.svg">older &gt;</TD><TD title="portage://media-gfx/gimp-2.10.38-r3" href="../media-gfx/gimp-2.10.38-r3-idepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6-merge.svg">--merge&nbsp;</TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-gfx/gimp-3.0.6" href="../media-gfx/gimp-3.0.6-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://media-gfx/gimp-3.0.6"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://media-gfx/gimp-3.0.6" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../media-gfx/gimp-3.0.6-idepend.svg"];
