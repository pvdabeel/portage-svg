digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-gfx</TD><TD title="repository" href="./pablodraw.html">pablodraw</TD><TD BORDER='0'></TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta.svg">detail</TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta-bdepend.svg">bdepend</TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta-cdepend.svg">cdepend</TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta-depend.svg">depend</TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta-idepend.svg">idepend</TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta-rdepend.svg">rdepend</TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://media-gfx/pablodraw-3.3.13_beta-r1" href="../media-gfx/pablodraw-3.3.13_beta-r1-emerge.svg">older &gt;</TD><TD title="portage://media-gfx/pablodraw-3.3.13_beta-r1" href="../media-gfx/pablodraw-3.3.13_beta-r1-emerge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta-merge.svg">--merge&nbsp;</TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-gfx/pablodraw-3.3.14_beta" href="../media-gfx/pablodraw-3.3.14_beta-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
