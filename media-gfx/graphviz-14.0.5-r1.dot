fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://media-gfx/graphviz-14.0.5-r1", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../media-gfx/graphviz-14.0.5-r1.svg"];
}

