graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-gfx</TD><TD title="repository" href="./asymptote.html">asymptote</TD><TD BORDER='0'></TD><TD title="portage://media-gfx/asymptote-3.02" href="../media-gfx/asymptote-3.02.svg">detail</TD><TD title="portage://media-gfx/asymptote-3.02" href="../media-gfx/asymptote-3.02-bdepend.svg">bdepend</TD><TD title="portage://media-gfx/asymptote-3.02" href="../media-gfx/asymptote-3.02-cdepend.svg">cdepend</TD><TD title="portage://media-gfx/asymptote-3.02" href="../media-gfx/asymptote-3.02-depend.svg"><u>depend</u></TD><TD title="portage://media-gfx/asymptote-3.02" href="../media-gfx/asymptote-3.02-idepend.svg">idepend</TD><TD title="portage://media-gfx/asymptote-3.02" href="../media-gfx/asymptote-3.02-rdepend.svg">rdepend</TD><TD title="portage://media-gfx/asymptote-3.02" href="../media-gfx/asymptote-3.02-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://media-gfx/asymptote-3.05" href="../media-gfx/asymptote-3.05-depend.svg">&lt;&lt; newest</TD><TD title="portage://media-gfx/asymptote-3.05" href="../media-gfx/asymptote-3.05-depend.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://media-gfx/asymptote-3.02" href="../media-gfx/asymptote-3.02-merge.s