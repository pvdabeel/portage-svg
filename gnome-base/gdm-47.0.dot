# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://gnome-base/gdm-47.0", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../gnome-base/gdm-47.0.svg"];
}

