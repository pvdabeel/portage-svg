digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-ruby</TD><TD title="repository" href="./recog.html">recog</TD><TD BORDER='0'></TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21.svg">detail</TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21-bdepend.svg">bdepend</TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21-cdepend.svg">cdepend</TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21-depend.svg">depend</TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21-idepend.svg">idepend</TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21-rdepend.svg">rdepend</TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-ruby/recog-3.1.24" href="../dev-ruby/recog-3.1.24-fetchonly.svg">&lt;&lt; newest</TD><TD title="portage://dev-ruby/recog-3.1.23" href="../dev-ruby/recog-3.1.23-fetchonly.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21-fetchonly.svg">--<u>fetchonly</u>&nbsp;</TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-ruby/recog-3.1.21" href="../dev-ruby/recog-3.1.21-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
