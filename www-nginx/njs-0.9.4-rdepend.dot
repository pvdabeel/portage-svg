"portage://www-servers/nginx-9999" -> "portage://app-vim/nginx-syntax-0.3.3" [style=dashed, color=orange];
"portage://www-servers/nginx-9999" -> "portage://www-servers/nginx-9999" [style=dashed, color=orange];
"portage://www-servers/nginx-9999" -> "portage://www-servers/nginx-9999" [style=dashed, color=orange];
"portage://www-servers/nginx-9999" -> "portage://www-servers/nginx-9999" [style=dashed, color=orange];
