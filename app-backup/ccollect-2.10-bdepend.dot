digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-backup</TD><TD title="repository" href="./ccollect.html">ccollect</TD><TD BORDER='0'></TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10.svg">detail</TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10-bdepend.svg"><u>bdepend</u></TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10-cdepend.svg">cdepend</TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10-depend.svg">depend</TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10-idepend.svg">idepend</TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10-rdepend.svg">rdepend</TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://app-backup/ccollect-0.8-r2" href="../app-backup/ccollect-0.8-r2-bdepend.svg">older &gt;</TD><TD title="portage://app-backup/ccollect-0.8-r2" href="../app-backup/ccollect-0.8-r2-bdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10-merge.svg">--merge&nbsp;</TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-backup/ccollect-2.10" href="../app-backup/ccollect-2.10-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-backup/ccollect-2.10"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-backup/ccollect-2.10" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-backup/ccollect-2.10-bdepend.svg"];
