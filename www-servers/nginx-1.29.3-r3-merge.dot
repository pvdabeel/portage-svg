digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">www-servers</TD><TD title="repository" href="./nginx.html">nginx</TD><TD BORDER='0'></TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3.svg">detail</TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3-bdepend.svg">bdepend</TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3-cdepend.svg">cdepend</TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3-depend.svg">depend</TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3-idepend.svg">idepend</TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3-rdepend.svg">rdepend</TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://www-servers/nginx-9999" href="../www-servers/nginx-9999-merge.svg">&lt;&lt; newest</TD><TD title="portage://www-servers/nginx-9999" href="../www-servers/nginx-9999-merge.svg">&lt; newer</TD><TD title="portage://www-servers/nginx-1.28.0-r5" href="../www-servers/nginx-1.28.0-r5-merge.svg">older &gt;</TD><TD title="portage://www-servers/nginx-1.26.3-r2" href="../www-servers/nginx-1.26.3-r2-merge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3-merge.svg">--<u>merge</u>&nbsp;</TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://www-servers/nginx-1.29.3-r3" href="../www-servers/nginx-1.29.3-r3-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
