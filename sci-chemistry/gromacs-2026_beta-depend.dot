digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sci-chemistry</TD><TD title="repository" href="./gromacs.html">gromacs</TD><TD BORDER='0'></TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta.svg">detail</TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta-bdepend.svg">bdepend</TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta-cdepend.svg">cdepend</TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta-depend.svg"><u>depend</u></TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta-idepend.svg">idepend</TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta-rdepend.svg">rdepend</TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sci-chemistry/gromacs-9999" href="../sci-chemistry/gromacs-9999-depend.svg">&lt;&lt; newest</TD><TD title="portage://sci-chemistry/gromacs-2026.9999" href="../sci-chemistry/gromacs-2026.9999-depend.svg">&lt; newer</TD><TD title="portage://sci-chemistry/gromacs-2025.9999" href="../sci-chemistry/gromacs-2025.9999-depend.svg">older &gt;</TD><TD title="portage://sci-chemistry/gromacs-2023.5" href="../sci-chemistry/gromacs-2023.5-depend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta-merge.svg">--merge&nbsp;</TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sci-chemistry/gromacs-2026_beta" href="../sci-chemistry/gromacs-2026_beta-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://sci-chemistry/gromacs-2026_beta"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://sci-chemistry/gromacs-2026_beta" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../sci-chemistry/gromacs-2026_beta-depend.svg"];
