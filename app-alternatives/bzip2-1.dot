fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-alternatives/bzip2-1", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-alternatives/bzip2-1.svg"];
}

