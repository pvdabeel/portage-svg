digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-alternatives</TD><TD title="repository" href="./gzip.html">gzip</TD><TD BORDER='0'></TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1.svg"><u>detail</u></TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1-bdepend.svg">bdepend</TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1-cdepend.svg">cdepend</TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1-depend.svg">depend</TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1-idepend.svg">idepend</TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1-rdepend.svg">rdepend</TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://app-alternatives/gzip-0" href="../app-alternatives/gzip-0.svg">older &gt;</TD><TD title="portage://app-alternatives/gzip-0" href="../app-alternatives/gzip-0.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1-merge.svg">--merge&nbsp;</TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-alternatives/gzip-1" href="../app-alternatives/gzip-1-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-alternatives/gzip-1", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-alternatives/gzip-1.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
use_conditional_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD ROWSPAN="3" CELLPADDING="10">use_conditional</TD></TR>
          <TR><TD>positive</TD></TR><TR><TD>pigz</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>app-arch</TD></TR><TR><TD>pigz</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[2,8],,,2.8]</TD></TR></TABLE>>, shape=none, color=blue];
}
use_conditional_group1:e -> package_dependency1:w [weight=20, style="dashed",arrowhead="vee"];
}
id:e -> use_conditional_group1:w [weight=20, style="solid",arrowhead="odot"];
subgraph  {
use_conditional_group2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD ROWSPAN="3" CELLPADDING="10">use_conditional</TD></TR>
          <TR><TD>positive</TD></TR><TR><TD>reference</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>app-arch</TD></TR><TR><TD>gzip</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[1,12],,-r3,1.12-r3]</TD></TR></TABLE>>, shape=none, color=blue];
}
use_conditional_group2:e -> package_dependency2:w [weight=20, style="dashed",arrowhead="vee"];
}
id:e -> use_conditional_group2:w [weight=20, style="solid",arrowhead="odot"];
subgraph  {
weak_blocker1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>app-arch</TD></TR><TR><TD>gzip</TD></TR>
                     <TR><TD>smaller</TD></TR><TR><TD>[[1,12],,-r3,1.12-r3]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker1:w [weight=20, color="orange", style="solid",arrowhead="odot"];
subgraph  {
weak_blocker2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>app-arch</TD></TR><TR><TD>pigz</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker2:w [weight=20, color="orange", style="solid",arrowhead="odot"];
}
}

