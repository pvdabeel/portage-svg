digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">mail-client</TD><TD title="repository" href="./roundcube.html">roundcube</TD><TD BORDER='0'></TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2.svg">detail</TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2-bdepend.svg">bdepend</TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2-cdepend.svg">cdepend</TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2-depend.svg">depend</TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2-idepend.svg">idepend</TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2-rdepend.svg">rdepend</TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://mail-client/roundcube-9999" href="../mail-client/roundcube-9999-merge.svg">&lt;&lt; newest</TD><TD title="portage://mail-client/roundcube-1.7_rc" href="../mail-client/roundcube-1.7_rc-merge.svg">&lt; newer</TD><TD title="portage://mail-client/roundcube-1.6.12" href="../mail-client/roundcube-1.6.12-merge.svg">older &gt;</TD><TD title="portage://mail-client/roundcube-1.6.7" href="../mail-client/roundcube-1.6.7-merge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2-merge.svg">--<u>merge</u>&nbsp;</TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://mail-client/roundcube-1.7_beta2" href="../mail-client/roundcube-1.7_beta2-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
