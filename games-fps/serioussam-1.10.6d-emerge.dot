graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">games-fps</TD><TD title="repository" href="./serioussam.html">serioussam</TD><TD BORDER='0'></TD><TD title="portage://games-fps/serioussam-1.10.6d" href="../games-fps/serioussam-1.10.6d.svg">detail</TD><TD title="portage://games-fps/serioussam-1.10.6d" href="../games-fps/serioussam-1.10.6d-bdepend.svg">bdepend</TD><TD title="portage://games-fps/serioussam-1.10.6d" href="../games-fps/serioussam-1.10.6d-cdepend.svg">cdepend</TD><TD title="portage://games-fps/serioussam-1.10.6d" href="../games-fps/serioussam-1.10.6d-depend.svg">depend</TD><TD title="portage://games-fps/serioussam-1.10.6d" href="../games-fps/serioussam-1.10.6d-idepend.svg">idepend</TD><TD title="portage://games-fps/serioussam-1.10.6d" href="../games-fps/serioussam-1.10.6d-rdepend.svg">rdepend</TD><TD title="portage://games-fps/serioussam-1.10.6d" href="../games-fps/serioussam-1.10.6d-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://games-fps/serioussam-1.10.6c" href="../games-fps/serioussam-1.10.6c-emerge.svg">older &gt;</TD><TD title="portage://games-fps/serioussam-1.10.6c" href="../games-fps/serioussam-1.10.6c-emerge.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://