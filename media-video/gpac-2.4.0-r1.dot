# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://media-video/gpac-2.4.0-r1", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../media-video/gpac-2.4.0-r1.svg"];
