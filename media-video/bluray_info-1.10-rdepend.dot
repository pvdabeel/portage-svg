digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">media-video</TD><TD title="repository" href="./bluray_info.html">bluray_info</TD><TD BORDER='0'></TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10.svg">detail</TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10-bdepend.svg">bdepend</TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10-cdepend.svg">cdepend</TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10-depend.svg">depend</TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10-idepend.svg">idepend</TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10-rdepend.svg"><u>rdepend</u></TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10-merge.svg">--merge&nbsp;</TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://media-video/bluray_info-1.10" href="../media-video/bluray_info-1.10-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://media-video/bluray_info-1.10"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://media-video/bluray_info-1.10" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../media-video/bluray_info-1.10-rdepend.svg"];
"portage://media-video/bluray_info-1.10" -> "portage://media-libs/libaacs-0.11.1-r1"
"portage://media-video/bluray_info-1.10" -> "portage://media-libs/libbluray-9999"
"portage://media-libs/libaacs-0.11.1-r1" [color=red, penwidth=1, href="../media-libs/libaacs-0.11.1-r1-rdepend.svg"];
"portage://media-libs/libaacs-0.11.1-r1" -> "portage://dev-libs/libgcrypt-1.11.2"
"portage://media-libs/libaacs-0.11.1-r1" -> "portage://dev-libs/libgpg-error-1.57"
"portage://dev-libs/libgcrypt-1.11.2" [color=red, penwidth=1, href="../dev-libs/libgcrypt-1.11.2-rdepend.svg"];
"portage://dev-libs/libgcrypt-1.11.2" -> "portage://dev-libs/libgpg-error-1.57"
"portage://dev-libs/libgpg-error-1.57" [color=red, penwidth=1, href="../dev-libs/libgpg-error-1.57-rdepend.svg"];
"portage://media-libs/libbluray-9999" [color=red, penwidth=1, href="../media-libs/libbluray-9999-rdepend.svg"];
"portage://media-libs/libbluray-9999" -> "portage://dev-libs/libudfread-9999"
"portage://dev-libs/libudfread-9999" [color=red, penwidth=1, href="../dev-libs/libudfread-9999-rdepend.svg"];
}
