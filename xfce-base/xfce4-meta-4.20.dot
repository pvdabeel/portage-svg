fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://xfce-base/xfce4-meta-4.20", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../xfce-base/xfce4-meta-4.20.svg"];
