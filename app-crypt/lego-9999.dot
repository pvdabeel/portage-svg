digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-crypt</TD><TD title="repository" href="./lego.html">lego</TD><TD BORDER='0'></TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999.svg"><u>detail</u></TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999-bdepend.svg">bdepend</TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999-cdepend.svg">cdepend</TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999-depend.svg">depend</TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999-idepend.svg">idepend</TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999-rdepend.svg">rdepend</TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://app-crypt/lego-4.29.0" href="../app-crypt/lego-4.29.0.svg">older &gt;</TD><TD title="portage://app-crypt/lego-4.28.1" href="../app-crypt/lego-4.28.1.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999-merge.svg">--merge&nbsp;</TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-crypt/lego-9999" href="../app-crypt/lego-9999-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://app-crypt/lego-9999", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../app-crypt/lego-9999.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>app-arch</TD></TR><TR><TD>unzip</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>dev-lang</TD></TR><TR><TD>go</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[1,20],,,1.20]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency2:w [weight=20, style="solid",arrowhead="vee"];
subgraph  {
package_dependency3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>dev-vcs</TD></TR><TR><TD>git</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[1,8,2,1],,,1.8.2.1]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency3:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

