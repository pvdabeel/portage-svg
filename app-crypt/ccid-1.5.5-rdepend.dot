"portage://sys-apps/pcsc-lite-2.4.0" [color=red, penwidth=1, href="../sys-apps/pcsc-lite-2.4.0-rdepend.svg"];
"portage://sys-apps/pcsc-lite-2.4.0" -> "portage://acct-group/openct-0-r3"
"portage://sys-apps/pcsc-lite-2.4.0" -> "portage://acct-group/pcscd-0-r3"
"portage://sys-apps/pcsc-lite-2.4.0" -> "portage://acct-user/pcscd-0-r3"
"portage://sys-apps/pcsc-lite-2.4.0" -> "portage://virtual/tmpfiles-0-r5"
"portage://acct-group/openct-0-r3" [color=red, penwidth=1, href="../acct-group/openct-0-r3-rdepend.svg"];
"portage://acct-group/pcscd-0-r3" [color=red, penwidth=1, href="../acct-group/pcscd-0-r3-rdepend.svg"];
"portage://acct-user/pcscd-0-r3" [color=red, penwidth=1, href="../acct-user/pcscd-0-r3-rdepend.svg"];
