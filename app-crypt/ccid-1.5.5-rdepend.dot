digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-crypt</TD><TD title="repository" href="./ccid.html">ccid</TD><TD BORDER='0'></TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5.svg">detail</TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5-bdepend.svg">bdepend</TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5-cdepend.svg">cdepend</TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5-depend.svg">depend</TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5-idepend.svg">idepend</TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5-rdepend.svg"><u>rdepend</u></TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://app-crypt/ccid-1.6.1" href="../app-crypt/ccid-1.6.1-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://app-crypt/ccid-1.6.1" href="../app-crypt/ccid-1.6.1-rdepend.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5-merge.svg">--merge&nbsp;</TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://app-crypt/ccid-1.5.5" href="../app-crypt/ccid-1.5.5-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://app-crypt/ccid-1.5.5"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://app-crypt/ccid-1.5.5" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../app-crypt/ccid-1.5.5-rdepend.svg"];
