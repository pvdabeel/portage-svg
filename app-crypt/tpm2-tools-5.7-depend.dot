graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">app-crypt</TD><TD title="repository" href="./tpm2-tools.html">tpm2-tools</TD><TD BORDER='0'></TD><TD title="portage://app-crypt/tpm2-tools-5.7" href="../app-crypt/tpm2-tools-5.7.svg">detail</TD><TD title="portage://app-crypt/tpm2-tools-5.7" href="../app-crypt/tpm2-tools-5.7-bdepend.svg">bdepend</TD><TD title="portage://app-crypt/tpm2-tools-5.7" href="../app-crypt/tpm2-tools-5.7-cdepend.svg">cdepend</TD><TD title="portage://app-crypt/tpm2-tools-5.7" href="../app-crypt/tpm2-tools-5.7-depend.svg"><u>depend</u></TD><TD title="portage://app-crypt/tpm2-tools-5.7" href="../app-crypt/tpm2-tools-5.7-idepend.svg">idepend</TD><TD title="portage://app-crypt/tpm2-tools-5.7" href="../app-crypt/tpm2-tools-5.7-rdepend.svg">rdepend</TD><TD title="portage://app-crypt/tpm2-tools-5.7" href="../app-crypt/tpm2-tools-5.7-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://app-crypt/tpm2-tools-5.7" href="../app-crypt/tpm2-tools-5.7-merge.svg">--merge&nbsp;</TD><TD title="portage://app-crypt/tpm2-tools-5.7" href="../app-crypt/tpm2-tools-5.7-fetchonly.svg">--fetc