"sys-devel/gettext-0.22.5-r2" [label="portage://sys-devel/gettext-0.22.5-r2", color=red, width=4,href="../sys-devel/gettext-0.22.5-r2.svg"];
"sys-devel/gettext-0.21.1" [label="portage://sys-devel/gettext-0.21.1", color=red, width=4,href="../sys-devel/gettext-0.21.1.svg"];
