digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-block</TD><TD title="repository" href="./megarc.html">megarc</TD><TD BORDER='0'></TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3.svg"><u>detail</u></TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3-bdepend.svg">bdepend</TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3-cdepend.svg">cdepend</TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3-depend.svg">depend</TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3-idepend.svg">idepend</TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3-rdepend.svg">rdepend</TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-block/megarc-1.11-r3" href="../sys-block/megarc-1.11-r3-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://sys-block/megarc-1.11-r3", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../sys-block/megarc-1.11-r3.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
use_conditional_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD ROWSPAN="3" CELLPADDING="10">use_conditional</TD></TR>
          <TR><TD>positive</TD></TR><TR><TD>doc</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>app-text</TD></TR><TR><TD>antiword</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
use_conditional_group1:e -> package_dependency1:w [weight=20, style="dashed",arrowhead="vee"];
}
id:e -> use_conditional_group1:w [weight=20, style="solid",arrowhead="vee"];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>app-arch</TD></TR><TR><TD>unzip</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency2:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"app-text/antiword-0.37-r2" [label="portage://app-text/antiword-0.37-r2", color=red, width=4,href="../app-text/antiword-0.37-r2.svg"];
package_dependency1:e -> "app-text/antiword-0.37-r2":w [style=dotted,weight="100"];
}
subgraph  {
color=black;
nodesep=1;
"app-arch/unzip-6.0_p29" [label="portage://app-arch/unzip-6.0_p29", color=red, width=4,href="../app-arch/unzip-6.0_p29.svg"];
"app-arch/unzip-6.0_p27-r1" [label="portage://app-arch/unzip-6.0_p27-r1", color=red, width=4,href="../app-arch/unzip-6.0_p27-r1.svg"];
"app-arch/unzip-6.0_p29" [label="pkg://app-arch/unzip-6.0_p29", color=red, width=4,href="../app-arch/unzip-6.0_p29.svg"];
package_dependency2:e -> "app-arch/unzip-6.0_p29":w [style=dotted,weight="100"];
package_dependency2:e -> "app-arch/unzip-6.0_p27-r1":w [style=dotted,weight="100"];
package_dependency2:e -> "app-arch/unzip-6.0_p29":w [style=dotted,weight="100"];
}
}
}
