digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">gnome-extra</TD><TD title="repository" href="./cinnamon.html">cinnamon</TD><TD BORDER='0'></TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13.svg"><u>detail</u></TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13-bdepend.svg">bdepend</TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13-cdepend.svg">cdepend</TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13-depend.svg">depend</TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13-idepend.svg">idepend</TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13-rdepend.svg">rdepend</TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://gnome-extra/cinnamon-6.4.13-r1" href="../gnome-extra/cinnamon-6.4.13-r1.svg">&lt;&lt; newest</TD><TD title="portage://gnome-extra/cinnamon-6.4.13-r1" href="../gnome-extra/cinnamon-6.4.13-r1.svg">&lt; newer</TD><TD title="portage://gnome-extra/cinnamon-6.4.10-r2" href="../gnome-extra/cinnamon-6.4.10-r2.svg">older &gt;</TD><TD title="portage://gnome-extra/cinnamon-6.4.10-r1" href="../gnome-extra/cinnamon-6.4.10-r1.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13-merge.svg">--merge&nbsp;</TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://gnome-extra/cinnamon-6.4.13" href="../gnome-extra/cinnamon-6.4.13-emerge.svg">emerge</TD></TR></TABLE>>];

