><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://gnome-extra/gnome-getting-started-docs-3.38.1" href="../gnome-extra/gnome-getting-started-docs-3.38.1-merge.svg">--merge&nbsp;</TD><TD title="portage://gnome-extra/gnome-getting-started-docs-3.38.1" href="../gnome-extra/gnome-getting-started-docs-3.38.1-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://gnome-extra/gnome-getting-started-docs-3.38.1" href="../gnome-extra/gnome-getting-started-docs-3.38.1-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://gnome-extra/gnome-getting-started-docs-3.38.1" href="../gnome-extra/gnome-getting-started-docs-3.38.1-emerge.svg">emerge</TD></TR></TABLE>>];

