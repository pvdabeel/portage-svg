node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">games-strategy</TD><TD title="repository" href="./freeciv.html">freeciv</TD><TD BORDER='0'></TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999.svg">detail</TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999-bdepend.svg">bdepend</TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999-cdepend.svg">cdepend</TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999-depend.svg">depend</TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999-idepend.svg"><u>idepend</u></TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999-rdepend.svg">rdepend</TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://games-strategy/freeciv-3.2.0_beta2" href="../games-strategy/freeciv-3.2.0_beta2-idepend.svg">older &gt;</TD><TD title="portage://games-strategy/freeciv-3.1.4" href="../games-strategy/freeciv-3.1.4-idepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999-merge.svg">--merge&nbsp;</TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://games-strategy/freeciv-9999" href="../games-strategy/freeciv-9999-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://games-strategy/freeciv-9999"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://games-strategy/freeciv-9999" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../games-strategy/freeciv-9999-idepend.svg"];
