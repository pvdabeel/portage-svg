                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>sys-devel</TD></TR><TR><TD>autogen</TD></TR>
                     <TR><TD>greaterequal</TD></TR><TR><TD>[[5,11,7],,,5.11.7]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency3:w [weight=20, style="solid",arrowhead="odot"];
}
}

