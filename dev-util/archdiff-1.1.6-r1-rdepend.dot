root [style=invis];
root -> "portage://dev-util/archdiff-1.1.6-r1"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://dev-util/archdiff-1.1.6-r1" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../dev-util/archdiff-1.1.6-r1-rdepend.svg"];
