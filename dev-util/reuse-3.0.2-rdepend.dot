digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-util</TD><TD title="repository" href="./reuse.html">reuse</TD><TD BORDER='0'></TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2.svg">detail</TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2-bdepend.svg">bdepend</TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2-cdepend.svg">cdepend</TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2-depend.svg">depend</TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2-idepend.svg">idepend</TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2-rdepend.svg"><u>rdepend</u></TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-util/reuse-5.0.2" href="../dev-util/reuse-5.0.2-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://dev-util/reuse-4.0.3" href="../dev-util/reuse-4.0.3-rdepend.svg">&lt; newer</TD><TD title="portage://dev-util/reuse-3.0.1" href="../dev-util/reuse-3.0.1-rdepend.svg">older &gt;</TD><TD title="portage://dev-util/reuse-2.1.0" href="../dev-util/reuse-2.1.0-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-util/reuse-3.0.2" href="../dev-util/reuse-3.0.2-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://dev-util/reuse-3.0.2"[minlen=0.2, headport=n, tailport=s, style=invis];

