"portage://dev-util/kcov-9999" -> "portage://virtual/zlib-1.3.1-r1"
"portage://dev-libs/elfutils-9999" [color=red, penwidth=1, href="../dev-libs/elfutils-9999-depend.svg"];
"portage://dev-libs/elfutils-9999" -> "portage://dev-libs/libelf-0.8.13-r4" [style=dashed, color=orange];
"portage://dev-libs/elfutils-9999" -> "portage://virtual/zlib-1.3.1-r1"
"portage://dev-libs/libelf-0.8.13-r4" [color=red, penwidth=1, href="../dev-libs/libelf-0.8.13-r4-depend.svg"];
