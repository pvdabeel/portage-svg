digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-util</TD><TD title="repository" href="./perf.html">perf</TD><TD BORDER='0'></TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17.svg"><u>detail</u></TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17-bdepend.svg">bdepend</TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17-cdepend.svg">cdepend</TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17-depend.svg">depend</TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17-idepend.svg">idepend</TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17-rdepend.svg">rdepend</TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-util/perf-6.18-r1" href="../dev-util/perf-6.18-r1.svg">&lt;&lt; newest</TD><TD title="portage://dev-util/perf-6.18-r1" href="../dev-util/perf-6.18-r1.svg">&lt; newer</TD><TD title="portage://dev-util/perf-6.16-r1" href="../dev-util/perf-6.16-r1.svg">older &gt;</TD><TD title="portage://dev-util/perf-6.14" href="../dev-util/perf-6.14.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-util/perf-6.17" href="../dev-util/perf-6.17-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://dev-util/perf-6.17", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../dev-util/perf-6.17.svg"];
}

