digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">dev-util</TD><TD title="repository" href="./cwdiff.html">cwdiff</TD><TD BORDER='0'></TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0.svg"><u>detail</u></TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0-bdepend.svg">bdepend</TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0-cdepend.svg">cdepend</TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0-depend.svg">depend</TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0-idepend.svg">idepend</TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0-rdepend.svg">rdepend</TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://dev-util/cwdiff-9999" href="../dev-util/cwdiff-9999.svg">&lt;&lt; newest</TD><TD title="portage://dev-util/cwdiff-9999" href="../dev-util/cwdiff-9999.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0-merge.svg">--merge&nbsp;</TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://dev-util/cwdiff-0.4.0" href="../dev-util/cwdiff-0.4.0-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://dev-util/cwdiff-0.4.0", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../dev-util/cwdiff-0.4.0.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">install</TD></TR><TR><TD>sys-apps</TD></TR><TR><TD>help2man</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="vee"];
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
use_conditional_group1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD ROWSPAN="3" CELLPADDING="10">use_conditional</TD></TR>
          <TR><TD>positive</TD></TR><TR><TD>mercurial</TD></TR></TABLE>>, shape=none, color=red];
subgraph  {
package_dependency2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>dev-vcs</TD></TR><TR><TD>mercurial</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
use_conditional_group1:e -> package_dependency2:w [weight=20, style="dashed",arrowhead="vee"];
}
id:e -> use_conditional_group1:w [weight=20, style="solid",arrowhead="odot"];
subgraph  {
package_dependency3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>app-text</TD></TR><TR><TD>wdiff</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency3:w [weight=20, style="solid",arrowhead="odot"];
subgraph  {
package_dependency4 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>sys-apps</TD></TR><TR><TD>diffutils</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency4:w [weight=20, style="solid",arrowhead="odot"];
}
}

