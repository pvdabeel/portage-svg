digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-libs</TD><TD title="repository" href="./enet.html">enet</TD><TD BORDER='0'></TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17.svg">detail</TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17-bdepend.svg">bdepend</TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17-cdepend.svg">cdepend</TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17-depend.svg">depend</TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17-idepend.svg">idepend</TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17-rdepend.svg">rdepend</TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-libs/enet-1.3.18" href="../net-libs/enet-1.3.18-emerge.svg">&lt;&lt; newest</TD><TD title="portage://net-libs/enet-1.3.17-r1" href="../net-libs/enet-1.3.17-r1-emerge.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17-merge.svg">--merge&nbsp;</TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-libs/enet-1.3.17" href="../net-libs/enet-1.3.17-emerge.svg"><u>emerge</u></TD></TR></TABLE>>];

root [style=invis];
placeholder [style=invis, width=22, height=15];
root -> "placeholder"[minlen=0.2, headport=n, tailport=s, style=invis];

}
