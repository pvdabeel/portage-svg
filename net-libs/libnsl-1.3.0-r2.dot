                     <TR><TD>greaterequal</TD></TR><TR><TD>[[1,2,0],,,1.2.0]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency2:w [weight=20, style="solid",arrowhead="odot"];
subgraph  {
weak_blocker1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">blocking (weak)</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>sys-libs</TD></TR><TR><TD>glibc</TD></TR>
                     <TR><TD>smaller</TD></TR><TR><TD>[[2,26],,,2.26]</TD></TR></TABLE>>, shape=none, color=orange];
}
id:e -> weak_blocker1:w [weight=20, color="orange", style="solid",arrowhead="odot"];
}
