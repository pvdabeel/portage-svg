"portage://dev-libs/openssl-3.6.9999" [color=red, penwidth=1, href="../dev-libs/openssl-3.6.9999-depend.svg"];
"portage://net-libs/udns-0.6" [color=red, penwidth=1, href="../net-libs/udns-0.6-depend.svg"];
