digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">net-libs</TD><TD title="repository" href="./nDPI.html">nDPI</TD><TD BORDER='0'></TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14.svg">detail</TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14-bdepend.svg">bdepend</TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14-cdepend.svg">cdepend</TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14-depend.svg">depend</TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14-idepend.svg">idepend</TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14-rdepend.svg"><u>rdepend</u></TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://net-libs/nDPI-9999" href="../net-libs/nDPI-9999-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://net-libs/nDPI-9999" href="../net-libs/nDPI-9999-rdepend.svg">&lt; newer</TD><TD title="portage://net-libs/nDPI-4.8" href="../net-libs/nDPI-4.8-rdepend.svg">older &gt;</TD><TD title="portage://net-libs/nDPI-4.2" href="../net-libs/nDPI-4.2-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14-merge.svg">--merge&nbsp;</TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://net-libs/nDPI-4.14" href="../net-libs/nDPI-4.14-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://net-libs/nDPI-4.14"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://net-libs/nDPI-4.14" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../net-libs/nDPI-4.14-rdepend.svg"];
"portage://net-libs/nDPI-4.14" -> "portage://dev-libs/json-c-9999"
"portage://net-libs/nDPI-4.14" -> "portage://dev-libs/libgcrypt-1.11.2"
"portage://net-libs/nDPI-4.14" -> "portage://dev-libs/libgpg-error-1.57"
"portage://net-libs/nDPI-4.14" -> "portage://net-libs/libpcap-9999"
"portage://dev-libs/json-c-9999" [color=red, penwidth=1, href="../dev-libs/json-c-9999-rdepend.svg"];
"portage://dev-libs/libgcrypt-1.11.2" [color=red, penwidth=1, href="../dev-libs/libgcrypt-1.11.2-rdepend.svg"];
"portage://dev-libs/libgcrypt-1.11.2" -> "portage://dev-libs/libgpg-error-1.57"
"portage://dev-libs/libgpg-error-1.57" [color=red, penwidth=1, href="../dev-libs/libgpg-error-1.57-rdepend.svg"];
"portage://net-libs/libpcap-9999" [color=red, penwidth=1, href="../net-libs/libpcap-9999-rdepend.svg"];
