digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=LR,fontname=Helvetica,fontsize=10,ranksep=1.5];
edge  [arrowhead=vee];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">sys-devel</TD><TD title="repository" href="./binutils-config.html">binutils-config</TD><TD BORDER='0'></TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3.svg"><u>detail</u></TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3-bdepend.svg">bdepend</TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3-cdepend.svg">cdepend</TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3-depend.svg">depend</TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3-idepend.svg">idepend</TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3-rdepend.svg">rdepend</TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://sys-devel/binutils-config-9999" href="../sys-devel/binutils-config-9999.svg">&lt;&lt; newest</TD><TD title="portage://sys-devel/binutils-config-5.6" href="../sys-devel/binutils-config-5.6.svg">&lt; newer</TD><TD title="portage://sys-devel/binutils-config-5.5.2" href="../sys-devel/binutils-config-5.5.2.svg">older &gt;</TD><TD title="portage://sys-devel/binutils-config-5.5.2" href="../sys-devel/binutils-config-5.5.2.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3-merge.svg">--merge&nbsp;</TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://sys-devel/binutils-config-5.5.3" href="../sys-devel/binutils-config-5.5.3-emerge.svg">emerge</TD></TR></TABLE>>];

# **********
# The ebuild
# **********

subgraph cluster_leftcol {
fontcolor=gray;
label=<<i>ebuild</i>>;
labelloc=t;
labeljust=c;
id [label="portage://sys-devel/binutils-config-5.5.3", color=red, width=4, penwidth=2, fontname="Helvetica-Bold", href="../sys-devel/binutils-config-5.5.3.svg"];
}

# ****************
# The dependencies
# ****************

subgraph cluster_midcol {
fontcolor=gray;
label=<<i>dependencies</i>>;
labelloc=t;
labeljust=c
subgraph cluster_install {
fillcolor="#eeeeee";
style=filled;
label=<<i>install</i>>;
}
subgraph cluster_install_and_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>install and run</i>>;
}
subgraph cluster_run {
fillcolor="#eeeeee";
style=filled;
label=<<i>run</i>>;
subgraph  {
package_dependency1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" WIDTH="220"><TR><TD ROWSPAN="6" CELLPADDING="30">pack_dep</TD></TR>
                     <TR><TD WIDTH="110">run</TD></TR><TR><TD>sys-apps</TD></TR><TR><TD>gentoo-functions</TD></TR>
                     <TR><TD>none</TD></TR><TR><TD>[[],,,,]</TD></TR></TABLE>>, shape=none, color=blue];
}
id:e -> package_dependency1:w [weight=20, style="solid",arrowhead="odot"];
}
}

# **************
# The candidates
# **************

subgraph cluster_choices {
rank=same;
fontcolor=gray;
label=<<i>candidates</i>>;
labelloc=t;
labeljust=c

subgraph  {
color=black;
nodesep=1;
"sys-apps/gentoo-functions-9999" [label="portage://sys-apps/gentoo-functions-9999", color=red, width=4,href="../sys-apps/gentoo-functions-9999.svg"];
"sys-apps/gentoo-functions-1.7.4" [label="portage://sys-apps/gentoo-functions-1.7.4", color=red, width=4,href="../sys-apps/gentoo-functions-1.7.4.svg"];
"sys-apps/gentoo-functions-0.19" [label="portage://sys-apps/gentoo-functions-0.19", color=red, width=4,href="../sys-apps/gentoo-functions-0.19.svg"];
"sys-apps/gentoo-functions-1.7.3" [label="pkg://sys-apps/gentoo-functions-1.7.3", color=red, width=4,href="../sys-apps/gentoo-functions-1.7.3.svg"];
package_dependency1:e -> "sys-apps/gentoo-functions-9999":w [style=dotted,weight="100"];
package_dependency1:e -> "sys-apps/gentoo-functions-1.7.4":w [style=dotted,weight="100"];
package_dependency1:e -> "sys-apps/gentoo-functions-0.19":w [style=dotted,weight="100"];
package_dependency1:e -> "sys-apps/gentoo-functions-1.7.3":w [style=dotted,weight="100"];
}
}
}
