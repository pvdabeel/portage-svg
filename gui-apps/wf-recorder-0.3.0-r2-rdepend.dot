digraph prolog {

newrank=true;
concentrate=true;
compound=true;

graph [rankdir=TD, ranksep=1, nodesep=0.2];
edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">gui-apps</TD><TD title="repository" href="./wf-recorder.html">wf-recorder</TD><TD BORDER='0'></TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2.svg">detail</TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2-bdepend.svg">bdepend</TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2-cdepend.svg">cdepend</TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2-depend.svg">depend</TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2-idepend.svg">idepend</TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2-rdepend.svg"><u>rdepend</u></TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://gui-apps/wf-recorder-9999" href="../gui-apps/wf-recorder-9999-rdepend.svg">&lt;&lt; newest</TD><TD title="portage://gui-apps/wf-recorder-0.4.1" href="../gui-apps/wf-recorder-0.4.1-rdepend.svg">&lt; newer</TD><TD><FONT color="gray">older &gt;</FONT></TD><TD><FONT color="gray">oldest &gt;&gt;</FONT></TD><TD BORDER='0'></TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2-merge.svg">--merge&nbsp;</TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://gui-apps/wf-recorder-0.3.0-r2" href="../gui-apps/wf-recorder-0.3.0-r2-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://gui-apps/wf-recorder-0.3.0-r2"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://gui-apps/wf-recorder-0.3.0-r2" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../gui-apps/wf-recorder-0.3.0-r2-rdepend.svg"];
"portage://gui-apps/wf-recorder-0.3.0-r2" -> "portage://dev-libs/wayland-9999"
"portage://gui-apps/wf-recorder-0.3.0-r2" -> "portage://media-libs/libpulse-17.0"
"portage://gui-apps/wf-recorder-0.3.0-r2" -> "portage://media-video/ffmpeg-9999"
"portage://dev-libs/wayland-9999" [color=red, penwidth=1, href="../dev-libs/wayland-9999-rdepend.svg"];
"portage://dev-libs/wayland-9999" -> "portage://dev-libs/libffi-9999"
"portage://dev-libs/libffi-9999" [color=red, penwidth=1, href="../dev-libs/libffi-9999-rdepend.svg"];
"portage://media-libs/libpulse-17.0" [color=red, penwidth=1, href="../media-libs/libpulse-17.0-rdepend.svg"];
"portage://media-libs/libpulse-17.0" -> "portage://dev-libs/libatomic_ops-7.8.4"
"portage://media-libs/libpulse-17.0" -> "portage://media-libs/libsndfile-9999"
"portage://dev-libs/libatomic_ops-7.8.4" [color=red, penwidth=1, href="../dev-libs/libatomic_ops-7.8.4-rdepend.svg"];
"portage://media-libs/libsndfile-9999" [color=red, penwidth=1, href="../media-libs/libsndfile-9999-rdepend.svg"];
"portage://media-video/ffmpeg-9999" [color=red, penwidth=1, href="../media-video/ffmpeg-9999-rdepend.svg"];
"portage://media-video/ffmpeg-9999" -> "portage://virtual/libiconv-0-r2"
"portage://virtual/libiconv-0-r2" [color=red, penwidth=1, href="../virtual/libiconv-0-r2-rdepend.svg"];
}
