graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">gui-apps</TD><TD title="repository" href="./swaylock.html">swaylock</TD><TD BORDER='0'></TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3.svg">detail</TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3-bdepend.svg">bdepend</TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3-cdepend.svg">cdepend</TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3-depend.svg">depend</TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3-idepend.svg">idepend</TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3-rdepend.svg">rdepend</TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3-pdepend.svg"><u>pdepend</u></TD><TD BORDER='0'></TD><TD title="portage://gui-apps/swaylock-9999" href="../gui-apps/swaylock-9999-pdepend.svg">&lt;&lt; newest</TD><TD title="portage://gui-apps/swaylock-1.8.4" href="../gui-apps/swaylock-1.8.4-pdepend.svg">&lt; newer</TD><TD title="portage://gui-apps/swaylock-1.8.0" href="../gui-apps/swaylock-1.8.0-pdepend.svg">older &gt;</TD><TD title="portage://gui-apps/swaylock-1.8.0" href="../gui-apps/swaylock-1.8.0-pdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3-merge.svg">--merge&nbsp;</TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://gui-apps/swaylock-1.8.3" href="../gui-apps/swaylock-1.8.3-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
