edge  [arrowhead=vee arrowsize=0.6, constraint=true];
node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">www-plugins</TD><TD title="repository" href="./pdfjs.html">pdfjs</TD><TD BORDER='0'></TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375.svg">detail</TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375-bdepend.svg">bdepend</TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375-cdepend.svg">cdepend</TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375-depend.svg">depend</TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375-idepend.svg">idepend</TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375-rdepend.svg"><u>rdepend</u></TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD><FONT color="gray">&lt;&lt; newest</FONT></TD><TD><FONT color="gray">&lt; newer</FONT></TD><TD title="portage://www-plugins/pdfjs-4.10.38" href="../www-plugins/pdfjs-4.10.38-rdepend.svg">older &gt;</TD><TD title="portage://www-plugins/pdfjs-4.5.136" href="../www-plugins/pdfjs-4.5.136-rdepend.svg">oldest &gt;&gt;</TD><TD BORDER='0'></TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375-merge.svg">--merge&nbsp;</TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375-fetchonly.svg">--fetchonly&nbsp;</TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375-info.svg">--info&nbsp;</TD><TD BORDER='0'></TD><TD title="portage://www-plugins/pdfjs-5.0.375" href="../www-plugins/pdfjs-5.0.375-emerge.svg">emerge</TD></TR></TABLE>>];

root [style=invis];
root -> "portage://www-plugins/pdfjs-5.0.375"[minlen=0.2, headport=n, tailport=s, style=invis];

"portage://www-plugins/pdfjs-5.0.375" [color=red, penwidth=2, fontname="Helvetica-Bold", href="../www-plugins/pdfjs-5.0.375-rdepend.svg"];
