"portage://www-apps/cgit-9999" -> "portage://virtual/httpd-cgi-0-r6"
"portage://www-apps/cgit-9999" -> "portage://virtual/tmpfiles-0-r5"
"portage://www-apps/cgit-9999" -> "portage://app-admin/webapp-config-9999"
"portage://acct-group/cgit-0-r2" [color=red, penwidth=1, href="../acct-group/cgit-0-r2-rdepend.svg"];
"portage://acct-user/cgit-0-r2" [color=red, penwidth=1, href="../acct-user/cgit-0-r2-rdepend.svg"];
"portage://acct-user/cgit-0-r2" -> "portage://acct-group/cgit-0-r2"
"portage://dev-libs/openssl-3.6.9999" [color=red, penwidth=1, href="../dev-libs/openssl-3.6.9999-rdepend.svg"];
