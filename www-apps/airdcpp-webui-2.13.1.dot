node  [fontname=Helvetica,fontsize=10];

graph [labelloc=t, labeljust=l, fontcolor=blue, fontname=Helvetica, fontsize=10, label=<<TABLE BORDER='0' CELLBORDER='1' CELLSPACING='0' CELLPADDING='6'><TR><TD COLSPAN='3'><FONT COLOR='black'><B>navigation</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='7'><FONT COLOR='black'><B>dependency graph</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='4'><FONT COLOR='black'><B>version control</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='3'><FONT COLOR='black'><B>command line</B></FONT></TD><TD BORDER='0' WIDTH='30'></TD><TD COLSPAN='1'><FONT COLOR='black'><B>legacy</B></FONT></TD></TR><TR><TD title="repository" href="../index.html">portage</TD><TD title="repository" href="./index.html">www-apps</TD><TD title="repository" href="./airdcpp-webui.html">airdcpp-webui</TD><TD BORDER='0'></TD><TD title="portage://www-apps/airdcpp-webui-2.13.1" href="../www-apps/airdcpp-webui-2.13.1.svg"><u>detail</u></TD><TD title="portage://www-apps/airdcpp-webui-2.13.1" href="../www-apps/airdcpp-webui-2.13.1-bdepend.svg">bdepend</TD><TD title="portage://www-apps/airdcpp-webui-2.13.1" href="../www-apps/airdcpp-webui-2.13.1-cdepend.svg">cdepend</TD><TD title="portage://www-apps/airdcpp-webui-2.13.1" href="../www-apps/airdcpp-webui-2.13.1-depend.svg">depend</TD><TD title="portage://www-apps/airdcpp-webui-2.13.1" href="../www-apps/airdcpp-webui-2.13.1-idepend.svg">idepend</TD><TD title="portage://www-apps/airdcpp-webui-2.13.1" href="../www-apps/airdcpp-webui-2.13.1-rdepend.svg">rdepend</TD><TD title="portage://www-apps/airdcpp-webui-2.13.1" href="../www-apps/airdcpp-webui-2.13.1-pdepend.svg">pdepend</TD><TD BORDER='0'></TD><TD title="portage://www-apps/airdcpp-webui-2.14.0" href="../www-apps/airdcpp-webui-2.14.0.svg">&lt;&lt; newest</TD><TD title="portage://www-apps/airdcpp-webui-2.14.0" href="../www-apps/airdcpp-webui-2.14.0.svg">&lt; newer</TD><TD title="portage://www-apps/airdcpp-webui-2.12.1" href="../www-apps/airdcpp-webui-2.12.1.svg">older &gt;</TD><TD title